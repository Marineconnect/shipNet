<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shipnet portal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body @(User.HasClaim("IsViewOnly", "true") ? "is-view-only" : string.Empty)">
    @if (TempData["ViewOnlyDenied"] is string viewOnlyDeniedMessage && !string.IsNullOrWhiteSpace(viewOnlyDeniedMessage))
    {
        <div class="view-only-denied" role="alert">@viewOnlyDeniedMessage</div>
    }
    @RenderBody()
    @RenderSection("Scripts", required: false)
    <script>
    (() => {
        const storageKey = "shipnet-portal-language";
        const splitPattern = /\s\/\s/;
        const ignoredTags = new Set(["SCRIPT", "STYLE", "TEXTAREA", "CODE", "PRE"]);

        function currentLanguage() {
            return localStorage.getItem(storageKey) === "en" ? "en" : "vi";
        }

        function pickLanguageText(value, lang) {
            if (!value || !splitPattern.test(value)) return value;
            const parts = value.split(splitPattern);
            if (parts.length < 2) return value;
            return (lang === "en" ? parts.slice(1).join(" / ") : parts[0]).trim();
        }

        function normalizeTextNode(node, lang) {
            const value = node.nodeValue || "";
            const source = node.__shipnetI18nSource || value;
            if (!splitPattern.test(source)) return;
            node.__shipnetI18nSource = source;
            node.nodeValue = value.replace(value.trim(), pickLanguageText(source.trim(), lang));
        }

        function normalizeElementAttributes(element, lang) {
            ["placeholder", "aria-label", "title", "alt"].forEach((name) => {
                const value = element.getAttribute(name);
                if (!value) return;
                const sourceName = `data-i18n-source-${name}`;
                const source = element.getAttribute(sourceName) || value;
                if (!splitPattern.test(source)) return;
                element.setAttribute(sourceName, source);
                element.setAttribute(name, pickLanguageText(source, lang));
            });
        }

        function applySplitLanguage(lang = currentLanguage()) {
            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
                acceptNode(node) {
                    const parent = node.parentElement;
                    if (!parent || ignoredTags.has(parent.tagName)) return NodeFilter.FILTER_REJECT;
                    if (!splitPattern.test(node.__shipnetI18nSource || node.nodeValue || "")) return NodeFilter.FILTER_REJECT;
                    return NodeFilter.FILTER_ACCEPT;
                }
            });

            const textNodes = [];
            while (walker.nextNode()) textNodes.push(walker.currentNode);
            textNodes.forEach((node) => normalizeTextNode(node, lang));

            document.querySelectorAll("[placeholder], [aria-label], [title], [alt]").forEach((element) => {
                normalizeElementAttributes(element, lang);
            });

            document.querySelectorAll(".language-btn").forEach((button) => {
                button.classList.toggle("is-active", button.dataset.lang === lang);
            });
            document.documentElement.lang = lang;
            document.querySelectorAll("select[data-live-search-ready='true']").forEach((select) => {
                select.dispatchEvent(new CustomEvent("shipnet:languagechange"));
            });
        }

        function buildLiveSelect(select) {
            select.dataset.liveSearchReady = "true";
            select.classList.add("live-select-native");

            const wrapper = document.createElement("div");
            wrapper.className = "live-select";
            const trigger = document.createElement("button");
            trigger.type = "button";
            trigger.className = "live-select-trigger";
            trigger.setAttribute("aria-haspopup", "listbox");
            trigger.setAttribute("aria-expanded", "false");

            const triggerText = document.createElement("span");
            triggerText.className = "live-select-value";
            const triggerCaret = document.createElement("span");
            triggerCaret.className = "live-select-caret";
            triggerCaret.setAttribute("aria-hidden", "true");
            trigger.append(triggerText, triggerCaret);

            const panel = document.createElement("div");
            panel.className = "live-select-panel";
            panel.hidden = true;
            const search = document.createElement("input");
            search.type = "search";
            search.className = "live-select-search";
            search.autocomplete = "off";
            search.placeholder = "T\u00ecm trong danh s\u00e1ch / Search list";
            search.setAttribute("aria-label", "T\u00ecm trong danh s\u00e1ch / Search list");

            const optionList = document.createElement("div");
            optionList.className = "live-select-options";
            optionList.setAttribute("role", "listbox");
            panel.append(search, optionList);

            select.parentElement?.insertBefore(wrapper, select);
            wrapper.append(trigger, panel, select);

            let sourceOptions = Array.from(select.options);
            let suppressObserver = false;

            const selectedOption = () => Array.from(select.options).find((option) => option.selected) || select.options[0];
            const syncTrigger = () => {
                triggerText.textContent = pickLanguageText(selectedOption()?.textContent?.trim() || "", currentLanguage());
                trigger.disabled = select.disabled;
                wrapper.classList.toggle("is-disabled", select.disabled);
            };

            const closePanel = () => {
                panel.hidden = true;
                wrapper.classList.remove("is-open");
                trigger.setAttribute("aria-expanded", "false");
                search.value = "";
                panel.classList.remove("is-portaled");
                panel.style.removeProperty("top");
                panel.style.removeProperty("left");
                panel.style.removeProperty("width");
                if (panel.parentElement !== wrapper) {
                    wrapper.insertBefore(panel, select);
                }
            };

            const positionPanel = () => {
                if (panel.hidden) return;
                const rect = trigger.getBoundingClientRect();
                const viewportGap = 10;
                const maxPanelHeight = Math.min(330, window.innerHeight - (viewportGap * 2));
                const availableBelow = window.innerHeight - rect.bottom - viewportGap;
                const availableAbove = rect.top - viewportGap;
                const openAbove = availableBelow < 190 && availableAbove > availableBelow;
                const availableHeight = Math.max(120, openAbove ? availableAbove : availableBelow);
                const panelHeight = Math.min(maxPanelHeight, availableHeight);

                panel.style.left = `${Math.max(viewportGap, Math.min(rect.left, window.innerWidth - rect.width - viewportGap))}px`;
                panel.style.width = `${rect.width}px`;
                panel.style.maxHeight = `${panelHeight}px`;
                panel.style.top = openAbove
                    ? `${Math.max(viewportGap, rect.top - Math.min(panelHeight, panel.scrollHeight))}px`
                    : `${Math.min(window.innerHeight - viewportGap, rect.bottom + 4)}px`;
                panel.classList.toggle("opens-above", openAbove);
            };

            const renderOptions = () => {
                const query = search.value.trim().toLowerCase();
                optionList.innerHTML = "";
                const filtered = sourceOptions.filter((option) => {
                    const text = option.textContent?.trim() || "";
                    return !query || text.toLowerCase().includes(query) || option.value.toLowerCase().includes(query);
                });

                filtered.forEach((option) => {
                    const item = document.createElement("button");
                    item.type = "button";
                    item.className = "live-select-option";
                    item.textContent = pickLanguageText(option.textContent?.trim() || "", currentLanguage());
                    item.setAttribute("role", "option");
                    item.setAttribute("aria-selected", String(option.value === select.value));
                    item.classList.toggle("is-selected", option.value === select.value);
                    item.disabled = option.disabled;
                    item.addEventListener("click", () => {
                        suppressObserver = true;
                        select.value = option.value;
                        suppressObserver = false;
                        syncTrigger();
                        closePanel();
                        select.dispatchEvent(new CustomEvent("change", {
                            bubbles: true,
                            detail: { liveSelectUserSelection: true }
                        }));
                    });
                    optionList.appendChild(item);
                });

                if (filtered.length === 0) {
                    const empty = document.createElement("div");
                    empty.className = "live-select-empty";
                    empty.textContent = currentLanguage() === "en" ? "No matching options" : "Kh\u00f4ng c\u00f3 k\u1ebft qu\u1ea3 ph\u00f9 h\u1ee3p";
                    optionList.appendChild(empty);
                }
            };

            const openPanel = () => {
                if (trigger.disabled) return;
                document.querySelectorAll(".live-select.is-open").forEach((item) => {
                    if (item === wrapper) return;
                    item.classList.remove("is-open");
                    const otherPanel = item.querySelector(".live-select-panel");
                    if (otherPanel) otherPanel.hidden = true;
                    item.querySelector(".live-select-trigger")?.setAttribute("aria-expanded", "false");
                });
                sourceOptions = Array.from(select.options);
                renderOptions();
                document.body.appendChild(panel);
                panel.classList.add("is-portaled");
                panel.hidden = false;
                wrapper.classList.add("is-open");
                trigger.setAttribute("aria-expanded", "true");
                positionPanel();
                window.setTimeout(() => {
                    positionPanel();
                    search.focus();
                }, 0);
            };

            trigger.addEventListener("click", () => panel.hidden ? openPanel() : closePanel());
            search.addEventListener("input", renderOptions);
            search.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    closePanel();
                    trigger.focus();
                }
            });
            select.addEventListener("change", syncTrigger);
            select.addEventListener("shipnet:languagechange", () => {
                syncTrigger();
                if (!panel.hidden) renderOptions();
            });
            select.form?.addEventListener("reset", () => window.setTimeout(syncTrigger, 0));

            const observer = new MutationObserver(() => {
                if (suppressObserver) return;
                sourceOptions = Array.from(select.options);
                syncTrigger();
                if (!panel.hidden) renderOptions();
            });
            observer.observe(select, { childList: true, attributes: true, attributeFilter: ["disabled"] });
            document.addEventListener("click", (event) => {
                if (!wrapper.contains(event.target) && !panel.contains(event.target)) closePanel();
            });
            window.addEventListener("resize", positionPanel);
            window.addEventListener("scroll", positionPanel, true);
            syncTrigger();
        }

        function enhanceSelectSearch(select) {
            if (!(select instanceof HTMLSelectElement) || select.multiple || select.size > 1 || select.dataset.liveSearchReady === "true") {
                return;
            }

            const usefulOptions = Array.from(select.options).filter((option) => option.value || option.textContent?.trim());
            if (usefulOptions.length < 2) {
                return;
            }

            buildLiveSelect(select);
            return;

            select.dataset.liveSearchReady = "true";
            const search = document.createElement("input");
            search.type = "search";
            search.className = "select-live-search";
            search.autocomplete = "off";
            search.placeholder = "Tìm trong danh sách / Search list";
            search.setAttribute("aria-label", "Tìm trong danh sách / Search list");

            select.parentElement?.insertBefore(search, select);

            let sourceOptions = Array.from(select.options).map((option) => option.cloneNode(true));
            let suppressObserver = false;

            const refreshSource = () => {
                if (suppressObserver) return;
                sourceOptions = Array.from(select.options).map((option) => option.cloneNode(true));
            };

            const renderOptions = () => {
                const query = search.value.trim().toLowerCase();
                const selectedValue = select.value;
                const filtered = sourceOptions.filter((option) => {
                    const value = option.value || "";
                    const text = option.textContent || "";
                    return !query || !value || text.toLowerCase().includes(query) || value.toLowerCase().includes(query);
                });

                suppressObserver = true;
                select.innerHTML = "";
                filtered.forEach((option) => select.appendChild(option.cloneNode(true)));
                if (Array.from(select.options).some((option) => option.value === selectedValue)) {
                    select.value = selectedValue;
                }
                suppressObserver = false;
            };

            const observer = new MutationObserver(() => {
                refreshSource();
                if (search.value) renderOptions();
            });
            observer.observe(select, { childList: true });
            search.addEventListener("input", renderOptions);
            search.addEventListener("search", renderOptions);
        }

        function enhanceAllSelectSearch() {
            document.querySelectorAll("select").forEach(enhanceSelectSearch);
            window.shipnetApplySplitLanguage?.();
        }

        function applyViewOnlyMode() {
            if (!document.body.classList.contains("is-view-only")) return;

            const blockedPattern = /\/(Create|Edit|Update|Delete|Save|Import|Change|LoginAsUser|RefreshExpiredDevice|RebootDeviceRouter|NinePayQrInfo|NinePayBankTransferInfo|NinePaySubscriptionQr)(\?|\/|$)/i;
            const blockedIds = [
                "openDeviceModal",
                "openUserCreateModal",
                "openTenantCreateModal",
                "openPricingCreateModal",
                "openTenantPricingCreateModal",
                "openSubscriptionModal",
                "makeGroupedQrButton",
                "makeQrButton",
                "openInvoiceModal",
                "detailPlanAddButton",
                "detailRouterRebootButton",
                "dataOptInAction"
            ];

            blockedIds.forEach((id) => {
                const element = document.getElementById(id);
                if (element) element.hidden = true;
            });

            document.querySelectorAll("a[href], form[action]").forEach((element) => {
                const target = element.getAttribute("href") || element.getAttribute("action") || "";
                if (!blockedPattern.test(target)) return;
                element.hidden = true;
                element.setAttribute("aria-hidden", "true");
            });

            document.querySelectorAll("button[type='submit'], .js-delete-device-plan, .js-edit-device-plan").forEach((button) => {
                const form = button.closest("form");
                const action = form?.getAttribute("action") || "";
                const label = button.textContent || "";
                if (!blockedPattern.test(action) && !/(Tạo|Thêm|Sửa|Xóa|Lưu|Cập nhật|Create|Add|Edit|Delete|Save|Update|Import)/i.test(label)) {
                    return;
                }
                button.disabled = true;
                button.classList.add("is-view-only-disabled");
                button.setAttribute("title", "Tài khoản chỉ theo dõi không được thực hiện thao tác này / View-only accounts cannot perform this action");
            });
        }

        window.shipnetApplySplitLanguage = applySplitLanguage;
        window.shipnetEnhanceSelectSearch = enhanceAllSelectSearch;
        document.addEventListener("DOMContentLoaded", () => {
            enhanceAllSelectSearch();
            applySplitLanguage();
            applyViewOnlyMode();
            let enhanceTimer = null;
            const observer = new MutationObserver((mutations) => {
                if (!mutations.some((mutation) => mutation.target instanceof HTMLSelectElement || Array.from(mutation.addedNodes).some((node) => node instanceof HTMLSelectElement || (node instanceof Element && node.querySelector?.("select"))))) {
                    applyViewOnlyMode();
                    return;
                }
                window.clearTimeout(enhanceTimer);
                enhanceTimer = window.setTimeout(() => {
                    enhanceAllSelectSearch();
                    applyViewOnlyMode();
                }, 80);
            });
            observer.observe(document.body, { childList: true, subtree: true });
        });
        document.addEventListener("click", (event) => {
            const button = event.target instanceof Element ? event.target.closest(".language-btn[data-lang]") : null;
            if (!button) return;
            const lang = button.getAttribute("data-lang") === "en" ? "en" : "vi";
            localStorage.setItem(storageKey, lang);
            window.setTimeout(() => applySplitLanguage(lang), 0);
        });
    })();
    </script>
</body>
</html>
