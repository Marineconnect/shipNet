@model UserManagementIndexViewModel
@using System.Security.Claims
@{
    ViewData["ActiveNav"] = "user";
    ViewData["Title"] = "Quản lý người dùng";

    string? ResolveLogoUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        if (Uri.IsWellFormedUriString(path, UriKind.Absolute))
        {
            return path;
        }

        return path.StartsWith("/")
            ? Url.Content($"~{path}")
            : Url.Content($"~/{path.TrimStart('~', '/')}");
    }

    string ResolveInitial(string? displayName, string? username, string fallback)
    {
        var value = string.IsNullOrWhiteSpace(displayName) ? username : displayName;
        return !string.IsNullOrWhiteSpace(value)
            ? value.Trim()[0].ToString().ToUpperInvariant()
            : fallback;
    }

    var accountDisplayName = User.FindFirst("DisplayName")?.Value;
    if (string.IsNullOrWhiteSpace(accountDisplayName))
    {
        accountDisplayName = User.Identity?.Name;
    }

    var accountUsername = User.Identity?.Name ?? accountDisplayName ?? "User";
    var accountAvatarUrl = ResolveLogoUrl(User.FindFirst("Avatar")?.Value);
    var accountAvatarLabel = ResolveInitial(accountDisplayName, accountUsername, "U");
    var accountAvatarStyle = !string.IsNullOrWhiteSpace(accountAvatarUrl)
        ? $"background-image:url('{accountAvatarUrl}')"
        : null;
    var successMessage = TempData["UserManagementSuccess"]?.ToString();
    var errorMessage = TempData["UserManagementError"]?.ToString();
    var createLogoUrl = ResolveLogoUrl(Model.CreateForm.ExistingLogoPath);
    var editLogoUrl = ResolveLogoUrl(Model.EditForm.ExistingLogoPath);
    var createInitial = ResolveInitial(Model.CreateForm.DisplayName, Model.CreateForm.Username, "U");
    var editInitial = ResolveInitial(Model.EditForm.DisplayName, Model.EditForm.Username, "U");
    var createModalHidden = Model.OpenCreateModal ? string.Empty : " hidden";
    var editModalHidden = Model.OpenEditModal ? string.Empty : " hidden";
    var totalPages = Model.TotalPages;
    var startItem = Model.TotalUsers == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var endItem = Model.TotalUsers == 0 ? 0 : Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalUsers);
    var pageWindowStart = Math.Max(1, Model.CurrentPage - 2);
    var pageWindowEnd = Math.Min(totalPages, Model.CurrentPage + 2);
    var showLeadingEllipsis = pageWindowStart > 2;
    var showTrailingEllipsis = pageWindowEnd < totalPages - 1;
    var userGroups = new[]
    {
        ManagedUserType.Admin,
        ManagedUserType.Tenant,
        ManagedUserType.ShipAdmin,
        ManagedUserType.Crew
    };
}

<div class="device-page">
  <div class="device-shell">
        <partial name="_PortalNav" />

    <div class="device-topbar">
      <div>
        <div class="device-brand">Shipnet Portal</div>
        <h1>Quản lý người dùng / User Management</h1>
        <p>
          @if (Model.IsTenantScoped)
          {
            @:Bạn đang quản lý người dùng trong tenant / You are managing users in tenant <strong>@(Model.CurrentTenantName ?? "-")</strong>.
          }
          else
          {
            @:Thêm mới và cập nhật tài khoản quản trị hoặc tài khoản tenant ngay trên cùng màn hình danh sách / Create and update admin or tenant accounts directly from the list page.
          }
        </p>
      </div>
      <div class="device-actions">
        @if (Model.CanCreateUsers)
        {
        <button type="button" class="btn-primary add-device-btn" id="openUserCreateModal">
          <span class="add-device-icon">+</span>
          <span>Thêm người dùng / Add User</span>
        </button>
        }
      </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
      <div class="tenant-feedback is-success">@successMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
      <div class="tenant-feedback is-error" role="alert">@errorMessage</div>
    }

    <section class="device-card">
      <div class="device-card-head">
        <div>
          <h2>Danh sách người dùng / User List</h2>
          <p>Tổng số người dùng / Total users: <strong>@Model.TotalUsers</strong></p>
        </div>
      </div>
      <div class="detail-tabbar user-group-tabs" role="tablist" aria-label="User groups">
        @foreach (var tabGroup in userGroups.Where(group => Model.CreatableUserGroups.Contains(group) || string.Equals(group, Model.ActiveUserGroup, StringComparison.OrdinalIgnoreCase)))
        {
          <a asp-controller="User"
             asp-action="Index"
             asp-route-group="@tabGroup"
             asp-route-page="1"
             asp-route-pageSize="@Model.PageSize"
             class="detail-tab-btn @(string.Equals(Model.ActiveUserGroup, tabGroup, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)">
            @ManagedUserType.ToDisplay(tabGroup)
          </a>
        }
      </div>
      <div class="table-wrap">
        <table class="device-table user-table">
          <thead>
            <tr>
              <th>Ảnh đại diện / Avatar</th>
              <th>Username / Username</th>
              <th>Tên hiển thị / Display Name</th>
              <th>Nhóm / Group</th>
              <th>Tenant / Tenant</th>
              <th>Tàu / Vessel</th>
              <th>Email / Email</th>
              <th>Điện thoại / Phone</th>
              <th>Trạng thái / Status</th>
              <th>Quyền truy cập / Access</th>
              <th>Online gần nhất / Last Online</th>
              <th>Tác vụ / Actions</th>
            </tr>
          </thead>
          <tbody>
            @if (Model.Users.Count == 0)
            {
              <tr>
                <td colspan="12" class="tenant-empty">Chưa có người dùng nào / No users found.</td>
              </tr>
            }
            else
            {
              @foreach (var user in Model.Users)
              {
                var userLogoUrl = ResolveLogoUrl(user.Avatar);
                var userInitial = ResolveInitial(user.DisplayNameOrUsername, user.Username, "U");
                var statusClass = string.Equals(user.Status, "active", StringComparison.OrdinalIgnoreCase)
                    ? "is-active"
                    : "is-inactive";

                <tr>
                  <td>
                    <div class="tenant-logo-cell">
                      @if (!string.IsNullOrWhiteSpace(userLogoUrl))
                      {
                        <img src="@userLogoUrl" alt="@user.Username avatar" class="tenant-logo-thumb" />
                      }
                      else
                      {
                        <div class="tenant-logo-thumb is-empty">@userInitial</div>
                      }
                    </div>
                  </td>
                  <td>
                    @if (Model.CanManageUsers)
                    {
                      <a asp-controller="User"
                         asp-action="Edit"
                         asp-route-id="@user.Id"
                         asp-route-group="@Model.ActiveUserGroup"
                         asp-route-page="@Model.CurrentPage"
                         asp-route-pageSize="@Model.PageSize"
                         class="table-primary-link">@user.Username</a>
                    }
                    else
                    {
                      @user.Username
                    }
                  </td>
                  <td>@user.DisplayNameOrUsername</td>
                  <td>@user.UserGroupDisplay</td>
                  <td>@user.TenantDisplay</td>
                  <td>@user.VesselDisplay</td>
                  <td>@(string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email)</td>
                  <td>@(string.IsNullOrWhiteSpace(user.Phone) ? "-" : user.Phone)</td>
                  <td>
                    <span class="user-status-chip @statusClass">@user.Status</span>
                  </td>
                  <td>
                    <span class="view-only-chip @(user.IsViewOnly ? string.Empty : "is-off")">@user.ViewOnlyDisplay</span>
                  </td>
                  <td>@user.LastOnlineTimeVietnam</td>
                  <td>
                    <div class="table-actions">
                      @if (Model.CanManageUsers)
                      {
                        <form asp-controller="Account"
                              asp-action="LoginAsUser"
                              method="post"
                              class="user-login-as-form js-login-as-user-form">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="id" value="@user.Id" />
                          <button type="submit"
                                  class="table-action-btn"
                                  data-login-as-username="@user.Username">
                            <span>Đăng nhập / Login as</span>
                          </button>
                        </form>
                        <a asp-controller="User"
                           asp-action="Edit"
                           asp-route-id="@user.Id"
                           asp-route-group="@Model.ActiveUserGroup"
                           asp-route-page="@Model.CurrentPage"
                           asp-route-pageSize="@Model.PageSize"
                           class="table-action-btn">
                          <span>Sửa / Edit</span>
                        </a>
                        <form asp-controller="User"
                              asp-action="ResetPassword"
                              asp-route-id="@user.Id"
                              asp-route-group="@Model.ActiveUserGroup"
                              asp-route-page="@Model.CurrentPage"
                              asp-route-pageSize="@Model.PageSize"
                              method="post"
                              class="user-login-as-form js-reset-password-form">
                          @Html.AntiForgeryToken()
                          <button type="submit"
                                  class="table-action-btn is-danger"
                                  data-reset-username="@user.Username">
                            <span>Reset mật khẩu / Reset password</span>
                          </button>
                        </form>
                      }
                      else
                      {
                        <span class="view-only-chip">Chỉ xem / View only</span>
                      }
                    </div>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
      <div class="device-pagination">
        <div class="device-pagination-meta">
          <span>Hiển thị / Showing <strong>@startItem-@endItem</strong> / <strong>@Model.TotalUsers</strong> người dùng / users</span>
          <form asp-controller="User" asp-action="Index" method="get" class="page-size-wrap">
            <input type="hidden" name="group" value="@Model.ActiveUserGroup" />
            <input type="hidden" name="page" value="1" />
            <label for="userPageSizeSelect">Số dòng / Rows</label>
            <select id="userPageSizeSelect" name="pageSize" class="page-size-select">
              <option value="10" selected="@(Model.PageSize == 10)">10</option>
              <option value="20" selected="@(Model.PageSize == 20)">20</option>
              <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
          </form>
          <span>Trang / Page <strong>@Model.CurrentPage</strong> / <strong>@totalPages</strong></span>
        </div>
        <div class="device-pagination-actions">
          @if (Model.HasPreviousPage)
          {
            <a asp-controller="User"
               asp-action="Index"
               asp-route-group="@Model.ActiveUserGroup"
               asp-route-page="@(Model.CurrentPage - 1)"
               asp-route-pageSize="@Model.PageSize"
               class="pagination-btn"
               aria-label="Trang trước / Previous page">‹</a>
          }
          else
          {
            <span class="pagination-btn is-disabled" aria-disabled="true">‹</span>
          }

          @if (pageWindowStart > 1)
          {
            <a asp-controller="User" asp-action="Index" asp-route-group="@Model.ActiveUserGroup" asp-route-page="1" asp-route-pageSize="@Model.PageSize" class="pagination-btn">1</a>
          }
          @if (showLeadingEllipsis)
          {
            <span class="pagination-btn is-disabled" aria-hidden="true">…</span>
          }

          @for (var pageNumber = pageWindowStart; pageNumber <= pageWindowEnd; pageNumber++)
          {
            if (pageNumber == Model.CurrentPage)
            {
              <span class="pagination-btn is-active">@pageNumber</span>
            }
            else
            {
              <a asp-controller="User" asp-action="Index" asp-route-group="@Model.ActiveUserGroup" asp-route-page="@pageNumber" asp-route-pageSize="@Model.PageSize" class="pagination-btn">@pageNumber</a>
            }
          }

          @if (showTrailingEllipsis)
          {
            <span class="pagination-btn is-disabled" aria-hidden="true">…</span>
          }
          @if (pageWindowEnd < totalPages)
          {
            <a asp-controller="User" asp-action="Index" asp-route-group="@Model.ActiveUserGroup" asp-route-page="@totalPages" asp-route-pageSize="@Model.PageSize" class="pagination-btn">@totalPages</a>
          }

          @if (Model.HasNextPage)
          {
            <a asp-controller="User"
               asp-action="Index"
               asp-route-group="@Model.ActiveUserGroup"
               asp-route-page="@(Model.CurrentPage + 1)"
               asp-route-pageSize="@Model.PageSize"
               class="pagination-btn"
               aria-label="Trang sau / Next page">›</a>
          }
          else
          {
            <span class="pagination-btn is-disabled" aria-disabled="true">›</span>
          }
        </div>
      </div>
    </section>
  </div>
</div>

<div class="modal-backdrop" id="userCreateModal"@createModalHidden>
  <div class="device-modal user-management-modal" role="dialog" aria-modal="true" aria-labelledby="userCreateModalTitle">
    <div class="device-modal-head">
      <div>
        <h2 id="userCreateModalTitle">Thêm người dùng / Add User</h2>
        <p>Tạo tài khoản mới và gán nhóm quản trị hoặc tenant ngay trong popup thông tin tài khoản / Create a new account and assign admin or tenant group in the account form.</p>
      </div>
      <button type="button" class="modal-close" id="closeUserCreateModal" aria-label="Đóng / Close">×</button>
    </div>
    <form asp-controller="User" asp-action="Create" method="post" enctype="multipart/form-data" class="device-modal-form">
      @Html.AntiForgeryToken()
      <input asp-for="CreateForm.CurrentPage" type="hidden" />
      <input asp-for="CreateForm.PageSize" type="hidden" />
      <input asp-for="CreateForm.Status" type="hidden" />

      <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

      <div class="user-management-modal-layout">
        <section class="user-profile-card user-management-profile-card">
          <div class="user-profile-logo-wrap user-management-preview-wrap">
            @if (!string.IsNullOrWhiteSpace(createLogoUrl))
            {
              <img src="@createLogoUrl" alt="User logo preview" class="user-profile-logo" id="createLogoPreview" />
              <div class="user-profile-logo user-profile-logo-fallback" id="createLogoFallback" hidden>@createInitial</div>
            }
            else
            {
              <div class="user-profile-logo user-profile-logo-fallback" id="createLogoFallback">@createInitial</div>
              <img src="" alt="User logo preview" class="user-profile-logo" id="createLogoPreview" hidden />
            }
          </div>
          <div class="user-profile-logo-note">Xem trước avatar cho tài khoản mới / Preview avatar for the new account.</div>
          <dl class="user-profile-meta user-management-profile-meta">
            <div>
              <dt>Username</dt>
              <dd>@(string.IsNullOrWhiteSpace(Model.CreateForm.Username) ? "-" : Model.CreateForm.Username)</dd>
            </div>
            <div>
              <dt>Nhóm / Group</dt>
              <dd>@ManagedUserType.ToDisplay(Model.CreateForm.UserGroup)</dd>
            </div>
            <div>
              <dt>Tenant</dt>
              <dd>
                @if (string.Equals(Model.CreateForm.UserGroup, ManagedUserType.Tenant, StringComparison.OrdinalIgnoreCase))
                {
                  @(Model.Tenants.FirstOrDefault(tenant => tenant.Id == Model.CreateForm.TenantId)?.TenantName ?? "-")
                }
                else
                {
                  @:-
                }
              </dd>
            </div>
          </dl>
        </section>

        <section class="user-detail-card">
          <div class="user-detail-card-head">
            <div>
              <h2>Chi tiết người dùng / User Detail</h2>
              <p>Sử dụng lại biểu mẫu thông tin tài khoản và bổ sung phân nhóm người dùng / Use the account information form with additional user group fields.</p>
            </div>
          </div>
          <div class="user-detail-form user-management-form-body">
            <div class="user-detail-grid">
              <div class="form-group">
                <label asp-for="CreateForm.Username"></label>
                <input asp-for="CreateForm.Username" class="input" maxlength="50" />
                <span asp-validation-for="CreateForm.Username" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="CreateForm.DisplayName"></label>
                <input asp-for="CreateForm.DisplayName" class="input" maxlength="250" />
                <span asp-validation-for="CreateForm.DisplayName" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="CreateForm.Phone"></label>
                <input asp-for="CreateForm.Phone" class="input" maxlength="50" />
                <span asp-validation-for="CreateForm.Phone" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="CreateForm.Email"></label>
                <input asp-for="CreateForm.Email" class="input" maxlength="50" />
                <span asp-validation-for="CreateForm.Email" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="CreateForm.IdentificationNumber"></label>
                <input asp-for="CreateForm.IdentificationNumber" class="input" maxlength="50" />
                <span asp-validation-for="CreateForm.IdentificationNumber" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="CreateForm.Password"></label>
                <input asp-for="CreateForm.Password" class="input" maxlength="100" autocomplete="new-password" />
                <span asp-validation-for="CreateForm.Password" class="field-error"></span>
              </div>

              <div class="form-group">
                <label class="remember-box">
                  <input asp-for="CreateForm.IsViewOnly" />
                  <span>Chỉ theo dõi / View only</span>
                </label>
                <span asp-validation-for="CreateForm.IsViewOnly" class="field-error"></span>
              </div>

              <div class="form-group">
                <label class="remember-box">
                  <input asp-for="CreateForm.CanManageTransactions" />
                  <span>Quản lý transaction / Manage transactions</span>
                </label>
              </div>

              @if (Model.CreatableUserGroups.Count == 1)
              {
                <input asp-for="CreateForm.UserGroup" type="hidden" value="@Model.CreateForm.UserGroup" />
                <input asp-for="CreateForm.TenantId" type="hidden" value="@Model.CurrentTenantId" />
                <input asp-for="CreateForm.DeviceId" type="hidden" />
                <div class="form-group">
                  <label>Nhóm tài khoản / Account Group</label>
                  <input class="input" value="@ManagedUserType.ToDisplay(Model.CreateForm.UserGroup)" readonly />
                </div>

                <div class="form-group">
                  <label>Tenant</label>
                  <input class="input" value="@(Model.CurrentTenantName ?? "-")" readonly />
                  <span asp-validation-for="CreateForm.TenantId" class="field-error"></span>
                </div>
              }
              else
              {
                <div class="form-group">
                  <label asp-for="CreateForm.UserGroup"></label>
                  <select asp-for="CreateForm.UserGroup" class="input user-group-select" id="createUserGroupSelect">
                    @foreach (var groupOption in Model.CreatableUserGroups)
                    {
                      <option value="@groupOption">@ManagedUserType.ToDisplay(groupOption)</option>
                    }
                  </select>
                  <span asp-validation-for="CreateForm.UserGroup" class="field-error"></span>
                </div>

                <div class="form-group" id="createTenantSelectWrap">
                  <label asp-for="CreateForm.TenantId"></label>
                  <select asp-for="CreateForm.TenantId" class="input">
                    <option value="">Chọn tenant / Select tenant</option>
                    @foreach (var tenant in Model.Tenants)
                    {
                      <option value="@tenant.Id">@tenant.TenantName</option>
                    }
                  </select>
                  <span asp-validation-for="CreateForm.TenantId" class="field-error"></span>
                </div>

                <div class="form-group" id="createVesselSelectWrap">
                  <label asp-for="CreateForm.DeviceId"></label>
                  <select asp-for="CreateForm.DeviceId" class="input">
                    <option value="">Chọn tàu / Select vessel</option>
                    @foreach (var vessel in Model.Vessels)
                    {
                      <option value="@vessel.Id" data-tenant-id="@vessel.TenantId">@vessel.DisplayName</option>
                    }
                  </select>
                  <span asp-validation-for="CreateForm.DeviceId" class="field-error"></span>
                </div>
              }
            </div>

            <div class="form-group">
              <label asp-for="CreateForm.LogoFile"></label>
              <label class="user-logo-upload">
                <input asp-for="CreateForm.LogoFile" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" class="user-logo-input" />
                <span class="user-logo-upload-copy">
                  <strong>Tải logo mới / Upload new logo</strong>
                  <small>Hỗ trợ JPG, PNG, WEBP, GIF. Tối đa 3MB / Supports JPG, PNG, WEBP, GIF. Max 3MB.</small>
                </span>
              </label>
              <span asp-validation-for="CreateForm.LogoFile" class="field-error"></span>
            </div>
          </div>
        </section>
      </div>

      <div class="device-modal-actions">
        <button type="button" class="btn-secondary" id="cancelUserCreateModal">Hủy / Cancel</button>
        <button type="submit" class="btn-primary">Tạo người dùng / Create User</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-backdrop" id="userEditModal"@editModalHidden>
  <div class="device-modal user-management-modal" role="dialog" aria-modal="true" aria-labelledby="userEditModalTitle">
    <div class="device-modal-head">
      <div>
        <h2 id="userEditModalTitle">Cập nhật người dùng / Update User</h2>
        <p>Chỉnh sửa thông tin, nhóm tài khoản và tenant của người dùng hiện có / Edit information, account group, and tenant for the selected user.</p>
      </div>
      <button type="button" class="modal-close" id="closeUserEditModal" aria-label="Đóng / Close">×</button>
    </div>
    <form asp-controller="User" asp-action="Edit" method="post" enctype="multipart/form-data" class="device-modal-form">
      @Html.AntiForgeryToken()
      <input asp-for="EditForm.Id" type="hidden" />
      <input asp-for="EditForm.CurrentPage" type="hidden" />
      <input asp-for="EditForm.PageSize" type="hidden" />
      <input asp-for="EditForm.ExistingLogoPath" type="hidden" />
      <input asp-for="EditForm.Status" type="hidden" />

      <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

      <div class="user-management-modal-layout">
        <section class="user-profile-card user-management-profile-card">
          <div class="user-profile-logo-wrap user-management-preview-wrap">
            @if (!string.IsNullOrWhiteSpace(editLogoUrl))
            {
              <img src="@editLogoUrl" alt="User logo preview" class="user-profile-logo" id="editLogoPreview" />
              <div class="user-profile-logo user-profile-logo-fallback" id="editLogoFallback" hidden>@editInitial</div>
            }
            else
            {
              <div class="user-profile-logo user-profile-logo-fallback" id="editLogoFallback">@editInitial</div>
              <img src="" alt="User logo preview" class="user-profile-logo" id="editLogoPreview" hidden />
            }
          </div>
          <div class="user-profile-logo-note">Logo và nhóm của tài khoản sẽ cập nhật sau khi lưu / Logo and group are updated after saving.</div>
          <dl class="user-profile-meta user-management-profile-meta">
            <div>
              <dt>Username</dt>
              <dd>@(string.IsNullOrWhiteSpace(Model.EditForm.Username) ? "-" : Model.EditForm.Username)</dd>
            </div>
            <div>
              <dt>Nhóm / Group</dt>
              <dd>@ManagedUserType.ToDisplay(Model.EditForm.UserGroup)</dd>
            </div>
            <div>
              <dt>Tenant</dt>
              <dd>
                @if (string.Equals(Model.EditForm.UserGroup, ManagedUserType.Tenant, StringComparison.OrdinalIgnoreCase))
                {
                  @(Model.Tenants.FirstOrDefault(tenant => tenant.Id == Model.EditForm.TenantId)?.TenantName ?? "-")
                }
                else
                {
                  @:-
                }
              </dd>
            </div>
          </dl>
        </section>

        <section class="user-detail-card">
          <div class="user-detail-card-head">
            <div>
              <h2>Chi tiết người dùng / User Detail</h2>
              <p>Biểu mẫu dùng cùng cấu trúc với thông tin tài khoản, chỉ thêm phần nhóm người dùng và tenant / Same account form with added user group and tenant fields.</p>
            </div>
          </div>
          <div class="user-detail-form user-management-form-body">
            <div class="user-detail-grid">
              <div class="form-group">
                <label asp-for="EditForm.Username"></label>
                <input asp-for="EditForm.Username" class="input" maxlength="50" />
                <span asp-validation-for="EditForm.Username" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="EditForm.DisplayName"></label>
                <input asp-for="EditForm.DisplayName" class="input" maxlength="250" />
                <span asp-validation-for="EditForm.DisplayName" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="EditForm.Phone"></label>
                <input asp-for="EditForm.Phone" class="input" maxlength="50" />
                <span asp-validation-for="EditForm.Phone" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="EditForm.Email"></label>
                <input asp-for="EditForm.Email" class="input" maxlength="50" />
                <span asp-validation-for="EditForm.Email" class="field-error"></span>
              </div>

              <div class="form-group">
                <label asp-for="EditForm.IdentificationNumber"></label>
                <input asp-for="EditForm.IdentificationNumber" class="input" maxlength="50" />
                <span asp-validation-for="EditForm.IdentificationNumber" class="field-error"></span>
              </div>

              <div class="form-group">
                <label class="remember-box">
                  <input asp-for="EditForm.IsViewOnly" />
                  <span>Chỉ theo dõi / View only</span>
                </label>
                <span asp-validation-for="EditForm.IsViewOnly" class="field-error"></span>
              </div>

              <div class="form-group">
                <label class="remember-box">
                  <input asp-for="EditForm.CanManageTransactions" />
                  <span>Quản lý transaction / Manage transactions</span>
                </label>
              </div>

              @if (Model.CreatableUserGroups.Count == 1)
              {
                <input asp-for="EditForm.UserGroup" type="hidden" value="@Model.EditForm.UserGroup" />
                <input asp-for="EditForm.TenantId" type="hidden" value="@Model.CurrentTenantId" />
                <input asp-for="EditForm.DeviceId" type="hidden" />
                <div class="form-group">
                  <label>Nhóm tài khoản / Account Group</label>
                  <input class="input" value="@ManagedUserType.ToDisplay(Model.EditForm.UserGroup)" readonly />
                </div>

                <div class="form-group">
                  <label>Tenant</label>
                  <input class="input" value="@(Model.CurrentTenantName ?? "-")" readonly />
                  <span asp-validation-for="EditForm.TenantId" class="field-error"></span>
                </div>
              }
              else
              {
                <div class="form-group">
                  <label asp-for="EditForm.UserGroup"></label>
                  <select asp-for="EditForm.UserGroup" class="input user-group-select" id="editUserGroupSelect">
                    @foreach (var groupOption in Model.CreatableUserGroups)
                    {
                      <option value="@groupOption">@ManagedUserType.ToDisplay(groupOption)</option>
                    }
                  </select>
                  <span asp-validation-for="EditForm.UserGroup" class="field-error"></span>
                </div>

                <div class="form-group" id="editTenantSelectWrap">
                  <label asp-for="EditForm.TenantId"></label>
                  <select asp-for="EditForm.TenantId" class="input">
                    <option value="">Chọn tenant / Select tenant</option>
                    @foreach (var tenant in Model.Tenants)
                    {
                      <option value="@tenant.Id">@tenant.TenantName</option>
                    }
                  </select>
                  <span asp-validation-for="EditForm.TenantId" class="field-error"></span>
                </div>

                <div class="form-group" id="editVesselSelectWrap">
                  <label asp-for="EditForm.DeviceId"></label>
                  <select asp-for="EditForm.DeviceId" class="input">
                    <option value="">Chọn tàu / Select vessel</option>
                    @foreach (var vessel in Model.Vessels)
                    {
                      <option value="@vessel.Id" data-tenant-id="@vessel.TenantId">@vessel.DisplayName</option>
                    }
                  </select>
                  <span asp-validation-for="EditForm.DeviceId" class="field-error"></span>
                </div>
              }
            </div>

            <div class="form-group">
              <label asp-for="EditForm.LogoFile"></label>
              <label class="user-logo-upload">
                <input asp-for="EditForm.LogoFile" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" class="user-logo-input" />
                <span class="user-logo-upload-copy">
                  <strong>Tải logo mới / Upload new logo</strong>
                  <small>Hỗ trợ JPG, PNG, WEBP, GIF. Tối đa 3MB / Supports JPG, PNG, WEBP, GIF. Max 3MB.</small>
                </span>
              </label>
              <span asp-validation-for="EditForm.LogoFile" class="field-error"></span>
            </div>
          </div>
        </section>
      </div>

      <div class="device-modal-actions">
        <button type="button" class="btn-secondary" id="cancelUserEditModal">Hủy / Cancel</button>
        <button type="submit" class="btn-primary">Lưu thay đổi / Save Changes</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    (() => {
      const navToggle = document.getElementById("portalNavToggle");
      const navPanel = document.getElementById("portalNavPanel");
      const accountButton = document.getElementById("portalAccountButton");
      const accountDropdown = document.getElementById("portalAccountDropdown");
      const createModal = document.getElementById("userCreateModal");
      const editModal = document.getElementById("userEditModal");
      const openCreateModalButton = document.getElementById("openUserCreateModal");
      const closeCreateModalButton = document.getElementById("closeUserCreateModal");
      const cancelCreateModalButton = document.getElementById("cancelUserCreateModal");
      const closeEditModalButton = document.getElementById("closeUserEditModal");
      const cancelEditModalButton = document.getElementById("cancelUserEditModal");
      const pageSizeSelect = document.getElementById("userPageSizeSelect");
      const loginAsUserForms = document.querySelectorAll(".js-login-as-user-form");
      const resetPasswordForms = document.querySelectorAll(".js-reset-password-form");

      function syncBodyOverflow() {
        const hasOpenModal =
          (createModal && !createModal.hidden) ||
          (editModal && !editModal.hidden);

        document.body.style.overflow = hasOpenModal ? "hidden" : "";
      }

      function bindLogoPreview(inputId, previewId, fallbackId) {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);
        const fallback = document.getElementById(fallbackId);

        input?.addEventListener("change", () => {
          const file = input.files && input.files[0];
          if (!file || !preview) {
            return;
          }

          preview.src = URL.createObjectURL(file);
          preview.hidden = false;
          fallback?.setAttribute("hidden", "hidden");
        });
      }

      function bindTenantVisibility(selectId, wrapId, vesselWrapId) {
        const select = document.getElementById(selectId);
        const wrap = document.getElementById(wrapId);
        const tenantSelect = wrap?.querySelector("select");
        const vesselWrap = document.getElementById(vesselWrapId);
        const vesselSelect = vesselWrap?.querySelector("select");

        function syncVisibility() {
          const group = select?.value || "";
          const requiresTenant = group === "tenant" || group === "ship_admin" || group === "crew";
          const requiresVessel = group === "ship_admin" || group === "crew";
          if (!wrap) {
            return;
          }

          wrap.hidden = !requiresTenant;
          if (!requiresTenant && tenantSelect) {
            tenantSelect.value = "";
          }
          if (vesselWrap) {
            vesselWrap.hidden = !requiresVessel;
          }
          if (!requiresVessel && vesselSelect) {
            vesselSelect.value = "";
          }
        }

        select?.addEventListener("change", syncVisibility);
        syncVisibility();
      }

      function closeCreateModal() {
        if (!createModal) {
          return;
        }

        createModal.hidden = true;
        syncBodyOverflow();
      }

      function openCreateModal() {
        if (!createModal) {
          return;
        }

        createModal.hidden = false;
        syncBodyOverflow();
      }

      function closeEditModal() {
        if (!editModal) {
          return;
        }

        editModal.hidden = true;
        syncBodyOverflow();
      }

      navToggle?.addEventListener("click", () => {
        const expanded = navToggle.getAttribute("aria-expanded") === "true";
        navToggle.setAttribute("aria-expanded", expanded ? "false" : "true");
        navPanel?.classList.toggle("is-open", !expanded);
      });

      accountButton?.addEventListener("click", () => {
        const expanded = accountButton.getAttribute("aria-expanded") === "true";
        accountButton.setAttribute("aria-expanded", expanded ? "false" : "true");
        if (accountDropdown) {
          accountDropdown.hidden = expanded;
        }
      });

      document.addEventListener("click", (event) => {
        if (!accountButton || !accountDropdown) {
          return;
        }

        const target = event.target;
        if (!(target instanceof Node)) {
          return;
        }

        if (accountButton.contains(target) || accountDropdown.contains(target)) {
          return;
        }

        accountButton.setAttribute("aria-expanded", "false");
        accountDropdown.hidden = true;
      });

      openCreateModalButton?.addEventListener("click", openCreateModal);
      closeCreateModalButton?.addEventListener("click", closeCreateModal);
      cancelCreateModalButton?.addEventListener("click", closeCreateModal);
      closeEditModalButton?.addEventListener("click", closeEditModal);
      cancelEditModalButton?.addEventListener("click", closeEditModal);
      pageSizeSelect?.addEventListener("change", () => pageSizeSelect.form?.submit());
      loginAsUserForms.forEach((form) => {
        form.addEventListener("submit", () => {
          try {
            sessionStorage.clear();
          } catch {
          }

          const submitButton = form.querySelector("button[type='submit']");
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = true;
            submitButton.classList.add("is-processing");
          }
        });
      });
      resetPasswordForms.forEach((form) => {
        form.addEventListener("submit", (event) => {
          const submitButton = form.querySelector("button[type='submit']");
          const username = submitButton?.getAttribute("data-reset-username") || "";
          const message = `Xác nhận reset mật khẩu tài khoản ${username} về 123456? / Reset this account password to 123456?`;
          if (!window.confirm(message)) {
            event.preventDefault();
            return;
          }

          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = true;
            submitButton.classList.add("is-processing");
          }
        });
      });

      bindLogoPreview("CreateForm_LogoFile", "createLogoPreview", "createLogoFallback");
      bindLogoPreview("EditForm_LogoFile", "editLogoPreview", "editLogoFallback");
      bindTenantVisibility("createUserGroupSelect", "createTenantSelectWrap", "createVesselSelectWrap");
      bindTenantVisibility("editUserGroupSelect", "editTenantSelectWrap", "editVesselSelectWrap");

      syncBodyOverflow();
    })();
  </script>
}
