@model (string Prefix, PricingPlanFormViewModel Form)
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var prefix = Model.Prefix;
    var form = Model.Form;
    var defaultCurrency = (Configuration["System:DefaultCurrency"] ?? "VND").Trim().ToUpperInvariant();
    string NumberInput(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string MoneyInput(decimal value) => string.Equals(defaultCurrency, "VND", StringComparison.OrdinalIgnoreCase)
        ? value.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN"))
        : value.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture);
    var moneyDecimals = string.Equals(defaultCurrency, "VND", StringComparison.OrdinalIgnoreCase) ? "0" : "2";
}

<div class="tenant-form-grid">
  <div class="form-group">
    <label for="@(prefix)_PlanName">Tên gói / Plan Name</label>
    <input id="@(prefix)_PlanName" name="@(prefix).PlanName" value="@form.PlanName" class="input" maxlength="250" />
    <span data-valmsg-for="@(prefix).PlanName" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_PlanCode">Mã gói / Plan Code</label>
    <input id="@(prefix)_PlanCode" name="@(prefix).PlanCode" value="@form.PlanCode" class="input" maxlength="100" />
    <span data-valmsg-for="@(prefix).PlanCode" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_BaseData">Dung lượng (GB) / Data Limit (GB)</label>
    <input id="@(prefix)_BaseData" name="@(prefix).BaseData" value="@NumberInput(form.BaseData)" class="input" type="number" min="0" step="0.01" />
    <span data-valmsg-for="@(prefix).BaseData" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_Status">Trạng thái / Status</label>
    <select id="@(prefix)_Status" name="@(prefix).Status" class="input">
      <option value="active" selected="@(string.Equals(form.Status, "active", StringComparison.OrdinalIgnoreCase))">Hoạt động / Active</option>
      <option value="inactive" selected="@(string.Equals(form.Status, "inactive", StringComparison.OrdinalIgnoreCase))">Không hoạt động / Inactive</option>
    </select>
    <span data-valmsg-for="@(prefix).Status" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_CostPrice">Giá Cost KVH (@defaultCurrency) / KVH Cost Price (@defaultCurrency)</label>
    <input id="@(prefix)_CostPrice" name="@(prefix).CostPrice" value="@MoneyInput(form.CostPrice)" class="input" type="text" inputmode="decimal" data-money-input data-money-decimals="@moneyDecimals" />
    <span data-valmsg-for="@(prefix).CostPrice" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_ResellerPrice">Đơn giá đại lý (@defaultCurrency) / Reseller Price (@defaultCurrency)</label>
    <input id="@(prefix)_ResellerPrice" name="@(prefix).ResellerPrice" value="@MoneyInput(form.ResellerPrice)" class="input" type="text" inputmode="decimal" data-money-input data-money-decimals="@moneyDecimals" />
    <span data-valmsg-for="@(prefix).ResellerPrice" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_FinalPrice">Đơn giá bán ra (@defaultCurrency) / Sale Price (@defaultCurrency)</label>
    <input id="@(prefix)_FinalPrice" name="@(prefix).FinalPrice" value="@MoneyInput(form.FinalPrice)" class="input" type="text" inputmode="decimal" data-money-input data-money-decimals="@moneyDecimals" />
    <span data-valmsg-for="@(prefix).FinalPrice" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_CostOverChargePrice">Giá Cost Overcharge KVH (@defaultCurrency) / KVH Overcharge Cost (@defaultCurrency)</label>
    <input id="@(prefix)_CostOverChargePrice" name="@(prefix).CostOverChargePrice" value="@MoneyInput(form.CostOverChargePrice)" class="input" type="text" inputmode="decimal" data-money-input data-money-decimals="@moneyDecimals" />
    <span data-valmsg-for="@(prefix).CostOverChargePrice" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_ResellerOverChargePrice">Giá mua thêm đại lý (@defaultCurrency) / Reseller Overcharge Price (@defaultCurrency)</label>
    <input id="@(prefix)_ResellerOverChargePrice" name="@(prefix).ResellerOverChargePrice" value="@MoneyInput(form.ResellerOverChargePrice)" class="input" type="text" inputmode="decimal" data-money-input data-money-decimals="@moneyDecimals" />
    <span data-valmsg-for="@(prefix).ResellerOverChargePrice" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_FinalOverChargePrice">Giá mua thêm bán ra (@defaultCurrency) / Sale Overcharge Price (@defaultCurrency)</label>
    <input id="@(prefix)_FinalOverChargePrice" name="@(prefix).FinalOverChargePrice" value="@MoneyInput(form.FinalOverChargePrice)" class="input" type="text" inputmode="decimal" data-money-input data-money-decimals="@moneyDecimals" />
    <span data-valmsg-for="@(prefix).FinalOverChargePrice" data-valmsg-replace="true" class="field-error"></span>
  </div>
</div>
