@model (string Prefix, PricingPlanFormViewModel Form)

@{
    var prefix = Model.Prefix;
    var form = Model.Form;
}

<div class="tenant-form-grid">
  <div class="form-group">
    <label for="@(prefix)_PlanName">Tên gói / Plan Name</label>
    <input id="@(prefix)_PlanName" name="@(prefix).PlanName" value="@form.PlanName" class="input" maxlength="250" />
    <span data-valmsg-for="@(prefix).PlanName" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_PlanCode">Mã gói / Plan Code</label>
    <input id="@(prefix)_PlanCode" name="@(prefix).PlanCode" value="@form.PlanCode" class="input" maxlength="100" />
    <span data-valmsg-for="@(prefix).PlanCode" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_BaseData">Dung lượng (GB) / Data Limit (GB)</label>
    <input id="@(prefix)_BaseData" name="@(prefix).BaseData" value="@form.BaseData" class="input" type="number" min="0" step="0.01" />
    <span data-valmsg-for="@(prefix).BaseData" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_Status">Trạng thái / Status</label>
    <select id="@(prefix)_Status" name="@(prefix).Status" class="input">
      <option value="active" selected="@(string.Equals(form.Status, "active", StringComparison.OrdinalIgnoreCase))">Hoạt động / Active</option>
      <option value="inactive" selected="@(string.Equals(form.Status, "inactive", StringComparison.OrdinalIgnoreCase))">Không hoạt động / Inactive</option>
    </select>
    <span data-valmsg-for="@(prefix).Status" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_ResellerPrice">Đơn giá đại lý ($) / Reseller Price ($)</label>
    <input id="@(prefix)_ResellerPrice" name="@(prefix).ResellerPrice" value="@form.ResellerPrice" class="input" type="number" min="0" step="0.01" />
    <span data-valmsg-for="@(prefix).ResellerPrice" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_FinalPrice">Đơn giá bán ra ($) / Sale Price ($)</label>
    <input id="@(prefix)_FinalPrice" name="@(prefix).FinalPrice" value="@form.FinalPrice" class="input" type="number" min="0" step="0.01" />
    <span data-valmsg-for="@(prefix).FinalPrice" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_ResellerOverChargePrice">Giá mua thêm đại lý ($) / Reseller Overcharge Price ($)</label>
    <input id="@(prefix)_ResellerOverChargePrice" name="@(prefix).ResellerOverChargePrice" value="@form.ResellerOverChargePrice" class="input" type="number" min="0" step="0.01" />
    <span data-valmsg-for="@(prefix).ResellerOverChargePrice" data-valmsg-replace="true" class="field-error"></span>
  </div>

  <div class="form-group">
    <label for="@(prefix)_FinalOverChargePrice">Giá mua thêm bán ra ($) / Sale Overcharge Price ($)</label>
    <input id="@(prefix)_FinalOverChargePrice" name="@(prefix).FinalOverChargePrice" value="@form.FinalOverChargePrice" class="input" type="number" min="0" step="0.01" />
    <span data-valmsg-for="@(prefix).FinalOverChargePrice" data-valmsg-replace="true" class="field-error"></span>
  </div>
</div>
