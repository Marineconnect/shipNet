@model PricingPlanIndexViewModel
@using System.Security.Claims
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["ActiveNav"] = "pricing";
    ViewData["Title"] = "Quản lý gói cước";

    string? ResolveLogoUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        if (Uri.IsWellFormedUriString(path, UriKind.Absolute))
        {
            return path;
        }

        return path.StartsWith("/")
            ? Url.Content($"~{path}")
            : Url.Content($"~/{path.TrimStart('~', '/')}");
    }

    var defaultCurrency = (Configuration["System:DefaultCurrency"] ?? "VND").Trim().ToUpperInvariant();
    string Money(decimal value) => string.Equals(defaultCurrency, "VND", StringComparison.OrdinalIgnoreCase)
        ? $"{value:#,##0} VND"
        : $"{defaultCurrency} {value:#,##0.##}";
    string Data(decimal value) => $"{value:#,##0.##} GB";
    string NumberInput(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string MoneyInput(decimal value) => string.Equals(defaultCurrency, "VND", StringComparison.OrdinalIgnoreCase)
        ? value.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN"))
        : value.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture);
    var moneyDecimals = string.Equals(defaultCurrency, "VND", StringComparison.OrdinalIgnoreCase) ? "0" : "2";

    var accountDisplayName = User.FindFirst("DisplayName")?.Value;
    if (string.IsNullOrWhiteSpace(accountDisplayName))
    {
        accountDisplayName = User.Identity?.Name;
    }

    var accountUsername = User.Identity?.Name ?? accountDisplayName ?? "User";
    var accountAvatarUrl = ResolveLogoUrl(User.FindFirst("Avatar")?.Value);
    var accountAvatarLabel = !string.IsNullOrWhiteSpace(accountDisplayName)
        ? accountDisplayName.Trim()[0].ToString().ToUpperInvariant()
        : "U";
    var accountAvatarStyle = !string.IsNullOrWhiteSpace(accountAvatarUrl)
        ? $"background-image:url('{accountAvatarUrl}')"
        : null;
    var successMessage = TempData["PricingSuccess"]?.ToString();
    var errorMessage = TempData["PricingError"]?.ToString();
    var createModalHidden = Model.OpenCreateModal ? string.Empty : " hidden";
    var editModalHidden = Model.OpenEditModal ? string.Empty : " hidden";
    var tenantCreateModalHidden = Model.OpenTenantPriceCreateModal ? string.Empty : " hidden";
    var tenantEditModalHidden = Model.OpenTenantPriceEditModal ? string.Empty : " hidden";
    var totalPages = Model.TotalPages;
    var startItem = Model.TotalPlans == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var endItem = Model.TotalPlans == 0 ? 0 : Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalPlans);
    var pageWindowStart = Math.Max(1, Model.CurrentPage - 2);
    var pageWindowEnd = Math.Min(totalPages, Model.CurrentPage + 2);
    var showLeadingEllipsis = pageWindowStart > 2;
    var showTrailingEllipsis = pageWindowEnd < totalPages - 1;
    var tenantTotalPages = Model.TenantPricingTotalPages;
    var tenantStartItem = Model.TotalTenantPrices == 0 ? 0 : ((Model.TenantPricingCurrentPage - 1) * Model.TenantPricingPageSize) + 1;
    var tenantEndItem = Model.TotalTenantPrices == 0 ? 0 : Math.Min(Model.TenantPricingCurrentPage * Model.TenantPricingPageSize, Model.TotalTenantPrices);
    var isTenantTab = string.Equals(Model.ActiveTab, "tenant", StringComparison.OrdinalIgnoreCase);
    var selectedTenantPricingTenantId = Model.TenantPricingTenantId?.ToString() ?? string.Empty;
    var hasTenantPricingFilter = Model.TenantPricingTenantId.HasValue || !string.IsNullOrWhiteSpace(Model.TenantPricingSearch);
}

<div class="device-page">
  <div class="device-shell">
        <partial name="_PortalNav" />

    <div class="device-topbar">
      <div>
        <div class="device-brand">Shipnet portal</div>
        <h1>Quản lý gói cước / Pricing Management</h1>
        <p>Danh sách gói cước hệ thống, đơn giá đại lý, đơn giá bán ra và giá mua thêm / Manage system pricing plans, reseller price, sale price, and overcharge price.</p>
      </div>
      <div class="device-actions @(isTenantTab ? "is-hidden" : string.Empty)">
        <details class="pricing-import-menu" id="pricingImportMenu">
          <summary class="btn-secondary pricing-import-menu-trigger">
            <span>Import</span>
            <span class="pricing-import-chevron" aria-hidden="true"></span>
          </summary>
          <div class="pricing-import-panel">
            <a asp-controller="Pricing"
               asp-action="DownloadTemplate"
               class="pricing-import-option">
              Tải dữ liệu Excel
            </a>
            <form asp-controller="Pricing"
                  asp-action="Import"
                  asp-route-page="@Model.CurrentPage"
                  asp-route-pageSize="@Model.PageSize"
                  method="post"
                  enctype="multipart/form-data"
                  class="pricing-import-form">
              @Html.AntiForgeryToken()
              <label class="pricing-import-picker">
                <input type="file" name="importFile" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" id="pricingImportFile" />
                <span class="pricing-import-picker-label">Chọn file import</span>
                <span class="pricing-import-file-name" id="pricingImportFileName">Chưa chọn file</span>
              </label>
              <button type="submit" class="btn-primary pricing-import-submit" id="pricingImportSubmit" disabled>Import giá / Import Prices</button>
            </form>
          </div>
        </details>
        <button type="button" class="btn-primary add-device-btn" id="openPricingCreateModal">
          <span class="add-device-icon">+</span>
          <span>Thêm gói / Add Plan</span>
        </button>
      </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
      <div class="tenant-feedback is-success">@successMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
      <div class="tenant-feedback is-error" role="alert">@errorMessage</div>
    }

    <div class="pricing-tabs" role="tablist" aria-label="Pricing tabs">
      <a asp-controller="Pricing" asp-action="Index" asp-route-tab="product" class="pricing-tab @(isTenantTab ? string.Empty : "is-active")">Giá sản phẩm / Product Pricing</a>
      <a asp-controller="Pricing" asp-action="Index" asp-route-tab="tenant" class="pricing-tab @(isTenantTab ? "is-active" : string.Empty)">Giá tenant / Tenant Pricing</a>
    </div>

    <section class="device-card pricing-tab-panel @(isTenantTab ? "is-hidden" : string.Empty)">
      <div class="device-card-head">
        <div>
          <h2>Danh sách gói cước / Pricing Plan List</h2>
          <p>Tổng số gói cước / Total plans: <strong>@Model.TotalPlans</strong></p>
        </div>
      </div>
      <div class="table-wrap">
        <table class="device-table pricing-table">
          <thead>
            <tr>
              <th>Tên gói / Plan Name</th>
              <th>Mã gói / Plan Code</th>
              <th>Dung lượng / Data Limit</th>
              <th>Đơn giá đại lý (@defaultCurrency) / Reseller Price (@defaultCurrency)</th>
              <th>Đơn giá bán ra (@defaultCurrency) / Sale Price (@defaultCurrency)</th>
              <th>Mua thêm đại lý (@defaultCurrency) / Reseller Overcharge (@defaultCurrency)</th>
              <th>Mua thêm bán ra (@defaultCurrency) / Sale Overcharge (@defaultCurrency)</th>
              <th>Trạng thái / Status</th>
              <th>Cập nhật lúc / Updated At</th>
              <th>Tác vụ / Actions</th>
            </tr>
          </thead>
          <tbody>
            @if (Model.Plans.Count == 0)
            {
              <tr>
                <td colspan="10" class="tenant-empty">Chưa có gói cước nào.</td>
              </tr>
            }
            else
            {
              @foreach (var plan in Model.Plans)
              {
                <tr>
                  <td>
                    <a asp-controller="Pricing"
                       asp-action="Edit"
                       asp-route-id="@plan.Id"
                       asp-route-page="@Model.CurrentPage"
                       asp-route-pageSize="@Model.PageSize"
                       class="table-primary-link">@plan.PlanName</a>
                  </td>
                  <td><strong>@plan.PlanCode</strong></td>
                  <td>@Data(plan.BaseData)</td>
                  <td>@Money(plan.ResellerPrice)</td>
                  <td>@Money(plan.FinalPrice)</td>
                  <td>@Money(plan.ResellerOverChargePrice)</td>
                  <td>@Money(plan.FinalOverChargePrice)</td>
                  <td>
                    <span class="user-status-chip @(string.Equals(plan.Status, "active", StringComparison.OrdinalIgnoreCase) ? "is-active" : "is-inactive")">
                      @plan.StatusDisplay
                    </span>
                  </td>
                  <td>
                    <div>@plan.UpdatedDateDisplay</div>
                    <div class="tenant-meta">@(string.IsNullOrWhiteSpace(plan.UpdatedBy) ? "-" : plan.UpdatedBy)</div>
                  </td>
                  <td>
                    <div class="table-actions">
                      <a asp-controller="Pricing"
                         asp-action="Edit"
                         asp-route-id="@plan.Id"
                         asp-route-page="@Model.CurrentPage"
                         asp-route-pageSize="@Model.PageSize"
                         class="table-action-btn">
                        <span>Sửa / Edit</span>
                      </a>
                      <form asp-controller="Pricing"
                            asp-action="Delete"
                            asp-route-id="@plan.Id"
                            asp-route-page="@Model.CurrentPage"
                            asp-route-pageSize="@Model.PageSize"
                            method="post"
                            class="tenant-delete-form"
                            onsubmit="return confirm('Xóa gói cước này? / Delete this pricing plan?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="table-action-btn is-danger">
                          <span>Xóa / Delete</span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
      <div class="device-pagination">
        <div class="device-pagination-meta">
          <span>Hiển thị / Showing <strong>@startItem-@endItem</strong> / <strong>@Model.TotalPlans</strong> gói / plans</span>
          <form asp-controller="Pricing" asp-action="Index" method="get" class="page-size-wrap">
            <input type="hidden" name="page" value="1" />
            <label for="pricingPageSizeSelect">Số dòng</label>
            <select id="pricingPageSizeSelect" name="pageSize" class="page-size-select">
              <option value="10" selected="@(Model.PageSize == 10)">10</option>
              <option value="20" selected="@(Model.PageSize == 20)">20</option>
              <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
          </form>
          <span>Trang / Page <strong>@Model.CurrentPage</strong> / <strong>@totalPages</strong></span>
        </div>
        <div class="device-pagination-actions">
          @if (Model.HasPreviousPage)
          {
            <a asp-controller="Pricing" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize" class="pagination-btn" aria-label="Trang trước">&lt;</a>
          }
          else
          {
            <span class="pagination-btn is-disabled" aria-disabled="true">&lt;</span>
          }

          @if (pageWindowStart > 1)
          {
            <a asp-controller="Pricing" asp-action="Index" asp-route-page="1" asp-route-pageSize="@Model.PageSize" class="pagination-btn">1</a>
          }
          @if (showLeadingEllipsis)
          {
            <span class="pagination-btn is-disabled" aria-hidden="true">...</span>
          }

          @for (var pageNumber = pageWindowStart; pageNumber <= pageWindowEnd; pageNumber++)
          {
            if (pageNumber == Model.CurrentPage)
            {
              <span class="pagination-btn is-active">@pageNumber</span>
            }
            else
            {
              <a asp-controller="Pricing" asp-action="Index" asp-route-page="@pageNumber" asp-route-pageSize="@Model.PageSize" class="pagination-btn">@pageNumber</a>
            }
          }

          @if (showTrailingEllipsis)
          {
            <span class="pagination-btn is-disabled" aria-hidden="true">...</span>
          }
          @if (pageWindowEnd < totalPages)
          {
            <a asp-controller="Pricing" asp-action="Index" asp-route-page="@totalPages" asp-route-pageSize="@Model.PageSize" class="pagination-btn">@totalPages</a>
          }

          @if (Model.HasNextPage)
          {
            <a asp-controller="Pricing" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize" class="pagination-btn" aria-label="Trang sau">&gt;</a>
          }
          else
          {
            <span class="pagination-btn is-disabled" aria-disabled="true">&gt;</span>
          }
        </div>
      </div>
    </section>

    <section class="device-card pricing-tab-panel @(isTenantTab ? string.Empty : "is-hidden")">
      <div class="device-card-head">
        <div>
          <h2>Giá tenant / Tenant Pricing</h2>
          <p>Tổng số giá tenant / Total tenant prices: <strong>@Model.TotalTenantPrices</strong></p>
        </div>
        <div class="device-actions">
          <details class="pricing-import-menu" id="tenantPricingImportMenu">
            <summary class="btn-secondary pricing-import-menu-trigger">
              <span>Export / Import</span>
              <span class="pricing-import-chevron" aria-hidden="true"></span>
            </summary>
            <div class="pricing-import-panel">
              <a asp-controller="Pricing"
                 asp-action="DownloadTenantPricing"
                 asp-route-tenantId="@Model.TenantPricingTenantId"
                 asp-route-tenantSearch="@Model.TenantPricingSearch"
                 class="pricing-import-option">Export dữ liệu Excel</a>
              <form asp-controller="Pricing"
                    asp-action="ImportTenantPricing"
                    asp-route-tenantPage="@Model.TenantPricingCurrentPage"
                    asp-route-tenantPageSize="@Model.TenantPricingPageSize"
                    asp-route-tenantId="@Model.TenantPricingTenantId"
                    asp-route-tenantSearch="@Model.TenantPricingSearch"
                    method="post"
                    enctype="multipart/form-data"
                    class="pricing-import-form"
                    id="tenantPricingImportForm"
                    data-preview-url="@Url.Action("PreviewTenantPricingDevices", "Pricing")">
                @Html.AntiForgeryToken()
                <label class="pricing-import-picker">
                  <input type="file" name="importFile" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" id="tenantPricingImportFile" />
                  <span class="pricing-import-picker-label">Chọn file import</span>
                  <span class="pricing-import-file-name" id="tenantPricingImportFileName">Chưa chọn file</span>
                </label>
                <label class="pricing-import-toggle">
                  <input type="checkbox" id="tenantPricingApplyDevices" />
                  <span>Cập nhật bảng giá thiết bị của tenant</span>
                </label>
                <div id="tenantDeviceSelectedInputs"></div>
                <button type="submit" class="btn-primary pricing-import-submit" id="tenantPricingImportSubmit" disabled>Import giá / Import Prices</button>
              </form>
            </div>
          </details>
          <button type="button" class="btn-primary add-device-btn" id="openTenantPricingCreateModal">
            <span class="add-device-icon">+</span>
            <span>Thêm giá / Add Price</span>
          </button>
        </div>
      </div>
      <form asp-controller="Pricing" asp-action="Index" method="get" class="pricing-filter-bar">
        <input type="hidden" name="tab" value="tenant" />
        <input type="hidden" name="tenantPage" value="1" />
        <input type="hidden" name="tenantPageSize" value="@Model.TenantPricingPageSize" />
        <label class="pricing-filter-field" for="tenantPricingTenantFilter">
          <span>Tenant / Tenant</span>
          <select id="tenantPricingTenantFilter" name="tenantId" class="input">
            <option value="">Tất cả tenant</option>
            @foreach (var tenant in Model.TenantOptions)
            {
              <option value="@tenant.Id" selected="@(selectedTenantPricingTenantId == tenant.Id.ToString())">@tenant.TenantName</option>
            }
          </select>
        </label>
        <label class="pricing-filter-field" for="tenantPricingSearchInput">
          <span>Gói giá / Pricing Plan</span>
          <input id="tenantPricingSearchInput" name="tenantSearch" class="input" value="@Model.TenantPricingSearch" placeholder="Tìm theo tên gói hoặc mã gói / Search by plan name or code" />
        </label>
        <div class="pricing-filter-actions">
          <button type="submit" class="btn-primary">Lọc / Filter</button>
          @if (hasTenantPricingFilter)
          {
            <a asp-controller="Pricing" asp-action="Index" asp-route-tab="tenant" asp-route-tenantPageSize="@Model.TenantPricingPageSize" class="btn-secondary">Xóa lọc / Clear Filter</a>
          }
        </div>
      </form>
      <div class="table-wrap">
        <table class="device-table pricing-table">
          <thead>
            <tr>
              <th>Tenant / Tenant</th>
              <th>Gói giá / Pricing Plan</th>
              <th>Dung lượng / Data Limit</th>
              <th>Đơn giá đại lý (@defaultCurrency) / Reseller Price (@defaultCurrency)</th>
              <th>Đơn giá bán ra (@defaultCurrency) / Sale Price (@defaultCurrency)</th>
              <th>Mua thêm đại lý (@defaultCurrency) / Reseller Overcharge (@defaultCurrency)</th>
              <th>Mua thêm bán ra (@defaultCurrency) / Sale Overcharge (@defaultCurrency)</th>
              <th>Cập nhật lúc / Updated At</th>
              <th>Tác vụ / Actions</th>
            </tr>
          </thead>
          <tbody>
            @if (Model.TenantPrices.Count == 0)
            {
              <tr>
                <td colspan="9" class="tenant-empty">Chưa có giá tenant nào.</td>
              </tr>
            }
            else
            {
              @foreach (var price in Model.TenantPrices)
              {
                <tr>
                  <td>
                    <a asp-controller="Pricing"
                       asp-action="EditTenantPricing"
                       asp-route-id="@price.Id"
                       asp-route-tenantPage="@Model.TenantPricingCurrentPage"
                       asp-route-tenantPageSize="@Model.TenantPricingPageSize"
                       asp-route-tenantId="@Model.TenantPricingTenantId"
                       asp-route-tenantSearch="@Model.TenantPricingSearch"
                       class="table-primary-link">@price.TenantName</a>
                  </td>
                  <td><strong>@price.PlanCode</strong><div class="tenant-meta">@price.PlanName</div></td>
                  <td>@Data(price.BaseData)</td>
                  <td>@Money(price.ResellerPrice)</td>
                  <td>@Money(price.FinalPrice)</td>
                  <td>@Money(price.ResellerOverChargePrice)</td>
                  <td>@Money(price.FinalOverChargePrice)</td>
                  <td>
                    <div>@price.UpdatedDateDisplay</div>
                    <div class="tenant-meta">@(string.IsNullOrWhiteSpace(price.UpdatedBy) ? "-" : price.UpdatedBy)</div>
                  </td>
                  <td>
                    <div class="table-actions">
                      <a asp-controller="Pricing"
                         asp-action="EditTenantPricing"
                         asp-route-id="@price.Id"
                         asp-route-tenantPage="@Model.TenantPricingCurrentPage"
                         asp-route-tenantPageSize="@Model.TenantPricingPageSize"
                         asp-route-tenantId="@Model.TenantPricingTenantId"
                         asp-route-tenantSearch="@Model.TenantPricingSearch"
                         class="table-action-btn">
                        <span>Sửa / Edit</span>
                      </a>
                      <form asp-controller="Pricing"
                            asp-action="DeleteTenantPricing"
                            asp-route-id="@price.Id"
                            asp-route-tenantPage="@Model.TenantPricingCurrentPage"
                            asp-route-tenantPageSize="@Model.TenantPricingPageSize"
                            asp-route-tenantId="@Model.TenantPricingTenantId"
                            asp-route-tenantSearch="@Model.TenantPricingSearch"
                            method="post"
                            class="tenant-delete-form"
                            onsubmit="return confirm('Xóa giá tenant này? / Delete this tenant price?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="table-action-btn is-danger">
                          <span>Xóa / Delete</span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
      <div class="device-pagination">
        <div class="device-pagination-meta">
          <span>Hiển thị / Showing <strong>@tenantStartItem-@tenantEndItem</strong> / <strong>@Model.TotalTenantPrices</strong> giá / prices</span>
          <form asp-controller="Pricing" asp-action="Index" method="get" class="page-size-wrap">
            <input type="hidden" name="tab" value="tenant" />
            <input type="hidden" name="tenantPage" value="1" />
            <input type="hidden" name="tenantId" value="@Model.TenantPricingTenantId" />
            <input type="hidden" name="tenantSearch" value="@Model.TenantPricingSearch" />
            <label for="tenantPricingPageSizeSelect">Số dòng</label>
            <select id="tenantPricingPageSizeSelect" name="tenantPageSize" class="page-size-select">
              <option value="10" selected="@(Model.TenantPricingPageSize == 10)">10</option>
              <option value="20" selected="@(Model.TenantPricingPageSize == 20)">20</option>
              <option value="50" selected="@(Model.TenantPricingPageSize == 50)">50</option>
            </select>
          </form>
          <span>Trang / Page <strong>@Model.TenantPricingCurrentPage</strong> / <strong>@tenantTotalPages</strong></span>
        </div>
        <div class="device-pagination-actions">
          @if (Model.TenantPricingHasPreviousPage)
          {
            <a asp-controller="Pricing" asp-action="Index" asp-route-tab="tenant" asp-route-tenantPage="@(Model.TenantPricingCurrentPage - 1)" asp-route-tenantPageSize="@Model.TenantPricingPageSize" asp-route-tenantId="@Model.TenantPricingTenantId" asp-route-tenantSearch="@Model.TenantPricingSearch" class="pagination-btn">&lt;</a>
          }
          else
          {
            <span class="pagination-btn is-disabled" aria-disabled="true">&lt;</span>
          }
          @if (Model.TenantPricingHasNextPage)
          {
            <a asp-controller="Pricing" asp-action="Index" asp-route-tab="tenant" asp-route-tenantPage="@(Model.TenantPricingCurrentPage + 1)" asp-route-tenantPageSize="@Model.TenantPricingPageSize" asp-route-tenantId="@Model.TenantPricingTenantId" asp-route-tenantSearch="@Model.TenantPricingSearch" class="pagination-btn">&gt;</a>
          }
          else
          {
            <span class="pagination-btn is-disabled" aria-disabled="true">&gt;</span>
          }
        </div>
      </div>
    </section>
  </div>
</div>


<div class="modal-backdrop" id="tenantDevicePreviewModal" hidden>
  <div class="device-modal tenant-device-modal" role="dialog" aria-modal="true" aria-labelledby="tenantDevicePreviewModalTitle">
    <div class="device-modal-head">
      <div>
        <h2 id="tenantDevicePreviewModalTitle">Chọn thiết bị cập nhật giá</h2>
        <p>Chọn tenant hoặc từng thiết bị cần đồng bộ bảng giá từ file import.</p>
      </div>
      <button type="button" class="modal-close" id="closeTenantDevicePreviewModal" aria-label="Đóng / Close">×</button>
    </div>
    <div class="tenant-device-preview" id="tenantDevicePreview">
      <div class="tenant-device-preview-head">
        <strong>Thiết bị sẽ cập nhật</strong>
        <div class="tenant-device-preview-tools">
          <input type="search" class="input tenant-device-search" id="tenantDeviceSearchInput" placeholder="Tim theo ma KIT, SLK, ten tau, thiet bi" />
          <button type="button" class="btn-secondary tenant-device-select-all" id="tenantDeviceSelectAll">Tick all</button>
        </div>
      </div>
      <div class="tenant-device-preview-body" id="tenantDevicePreviewBody"></div>
      <div class="tenant-device-preview-status" id="tenantDevicePreviewStatus"></div>
    </div>
    <div class="device-modal-actions">
      <button type="button" class="btn-secondary" id="cancelTenantDevicePreviewModal">Hủy</button>
      <button type="button" class="btn-primary" id="confirmTenantDeviceImport">Xác nhận import</button>
