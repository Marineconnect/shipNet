@section Scripts {
  <partial name="_ValidationScriptsPartial" />
  <script>
    (() => {
      const navToggle = document.getElementById("portalNavToggle");
      const navPanel = document.getElementById("portalNavPanel");
      const accountButton = document.getElementById("portalAccountButton");
      const accountDropdown = document.getElementById("portalAccountDropdown");
      const createModal = document.getElementById("pricingCreateModal");
      const editModal = document.getElementById("pricingEditModal");
      const tenantPricingCreateModal = document.getElementById("tenantPricingCreateModal");
      const tenantPricingEditModal = document.getElementById("tenantPricingEditModal");
      const openCreateModalButton = document.getElementById("openPricingCreateModal");
      const openTenantPricingCreateModalButton = document.getElementById("openTenantPricingCreateModal");
      const closeCreateModalButton = document.getElementById("closePricingCreateModal");
      const cancelCreateModalButton = document.getElementById("cancelPricingCreateModal");
      const closeEditModalButton = document.getElementById("closePricingEditModal");
      const cancelEditModalButton = document.getElementById("cancelPricingEditModal");
      const closeTenantPricingCreateModalButton = document.getElementById("closeTenantPricingCreateModal");
      const cancelTenantPricingCreateModalButton = document.getElementById("cancelTenantPricingCreateModal");
      const closeTenantPricingEditModalButton = document.getElementById("closeTenantPricingEditModal");
      const cancelTenantPricingEditModalButton = document.getElementById("cancelTenantPricingEditModal");
      const pageSizeSelect = document.getElementById("pricingPageSizeSelect");
      const tenantPricingPageSizeSelect = document.getElementById("tenantPricingPageSizeSelect");
      const importMenu = document.getElementById("pricingImportMenu");
      const importFile = document.getElementById("pricingImportFile");
      const importFileName = document.getElementById("pricingImportFileName");
      const importSubmit = document.getElementById("pricingImportSubmit");
      const tenantPricingImportMenu = document.getElementById("tenantPricingImportMenu");
      const tenantPricingImportFile = document.getElementById("tenantPricingImportFile");
      const tenantPricingImportFileName = document.getElementById("tenantPricingImportFileName");
      const tenantPricingImportSubmit = document.getElementById("tenantPricingImportSubmit");
      const tenantPricingImportForm = document.getElementById("tenantPricingImportForm");
      const tenantPricingApplyDevices = document.getElementById("tenantPricingApplyDevices");
      const tenantDevicePreview = document.getElementById("tenantDevicePreview");
      const tenantDevicePreviewBody = document.getElementById("tenantDevicePreviewBody");
      const tenantDevicePreviewStatus = document.getElementById("tenantDevicePreviewStatus");
      const tenantDeviceSelectedInputs = document.getElementById("tenantDeviceSelectedInputs");
      const tenantDeviceSelectAll = document.getElementById("tenantDeviceSelectAll");
      const tenantDeviceSearchInput = document.getElementById("tenantDeviceSearchInput");
      const tenantDevicePreviewModal = document.getElementById("tenantDevicePreviewModal");
      const closeTenantDevicePreviewModalButton = document.getElementById("closeTenantDevicePreviewModal");
      const cancelTenantDevicePreviewModalButton = document.getElementById("cancelTenantDevicePreviewModal");
      const confirmTenantDeviceImportButton = document.getElementById("confirmTenantDeviceImport");
      let tenantDeviceImportConfirmed = false;

      function syncBodyOverflow() {
        const hasOpenModal =
          (createModal && !createModal.hidden) ||
          (editModal && !editModal.hidden) ||
          (tenantDevicePreviewModal && !tenantDevicePreviewModal.hidden) ||
          (tenantPricingCreateModal && !tenantPricingCreateModal.hidden) ||
          (tenantPricingEditModal && !tenantPricingEditModal.hidden);

        document.body.style.overflow = hasOpenModal ? "hidden" : "";
      }

      function openCreateModal() {
        if (!createModal) return;
        createModal.hidden = false;
        syncBodyOverflow();
      }

      function closeCreateModal() {
        if (!createModal) return;
        createModal.hidden = true;
        syncBodyOverflow();
      }

      function closeEditModal() {
        if (!editModal) return;
        editModal.hidden = true;
        syncBodyOverflow();
      }

      function openTenantPricingCreateModal() {
        if (!tenantPricingCreateModal) return;
        tenantPricingCreateModal.hidden = false;
        syncBodyOverflow();
      }

      function closeTenantPricingCreateModal() {
        if (!tenantPricingCreateModal) return;
        tenantPricingCreateModal.hidden = true;
        syncBodyOverflow();
      }

      function closeTenantPricingEditModal() {
        if (!tenantPricingEditModal) return;
        tenantPricingEditModal.hidden = true;
        syncBodyOverflow();
      }

      function openTenantDevicePreviewModal() {
        if (!tenantDevicePreviewModal) return;
        tenantDevicePreviewModal.hidden = false;
        if (tenantDeviceSearchInput) tenantDeviceSearchInput.value = "";
        syncBodyOverflow();
        loadTenantDevicePreview();
      }

      function closeTenantDevicePreviewModal() {
        if (!tenantDevicePreviewModal) return;
        tenantDevicePreviewModal.hidden = true;
        syncBodyOverflow();
      }

      navToggle?.addEventListener("click", () => {
        const expanded = navToggle.getAttribute("aria-expanded") === "true";
        navToggle.setAttribute("aria-expanded", expanded ? "false" : "true");
        navPanel?.classList.toggle("is-open", !expanded);
      });

      accountButton?.addEventListener("click", () => {
        const expanded = accountButton.getAttribute("aria-expanded") === "true";
        accountButton.setAttribute("aria-expanded", expanded ? "false" : "true");
        if (accountDropdown) accountDropdown.hidden = expanded;
      });

      document.addEventListener("click", (event) => {
        if (!accountButton || !accountDropdown) return;

        const target = event.target;
        if (!(target instanceof Node)) return;
        if (accountButton.contains(target) || accountDropdown.contains(target)) return;

        accountButton.setAttribute("aria-expanded", "false");
        accountDropdown.hidden = true;
      });

      document.addEventListener("click", (event) => {
        if (!importMenu || !importMenu.open) return;

        const target = event.target;
        if (!(target instanceof Node)) return;
        if (importMenu.contains(target)) return;

        importMenu.open = false;
      });

      document.addEventListener("click", (event) => {
        if (!tenantPricingImportMenu || !tenantPricingImportMenu.open) return;

        const target = event.target;
        if (!(target instanceof Node)) return;
        if (tenantPricingImportMenu.contains(target)) return;

        tenantPricingImportMenu.open = false;
      });

      openCreateModalButton?.addEventListener("click", openCreateModal);
      openTenantPricingCreateModalButton?.addEventListener("click", openTenantPricingCreateModal);
      closeCreateModalButton?.addEventListener("click", closeCreateModal);
      cancelCreateModalButton?.addEventListener("click", closeCreateModal);
      closeEditModalButton?.addEventListener("click", closeEditModal);
      cancelEditModalButton?.addEventListener("click", closeEditModal);
      closeTenantPricingCreateModalButton?.addEventListener("click", closeTenantPricingCreateModal);
      cancelTenantPricingCreateModalButton?.addEventListener("click", closeTenantPricingCreateModal);
      closeTenantPricingEditModalButton?.addEventListener("click", closeTenantPricingEditModal);
      cancelTenantPricingEditModalButton?.addEventListener("click", closeTenantPricingEditModal);
      pageSizeSelect?.addEventListener("change", (event) => {
        if (!event.isTrusted && !event.detail?.liveSelectUserSelection) return;
        pageSizeSelect.form?.submit();
      });
      tenantPricingPageSizeSelect?.addEventListener("change", (event) => {
        if (!event.isTrusted && !event.detail?.liveSelectUserSelection) return;
        tenantPricingPageSizeSelect.form?.submit();
      });
      importFile?.addEventListener("change", () => {
        const file = importFile.files && importFile.files[0];
        if (importFileName) {
          importFileName.textContent = file ? file.name : "Chưa chọn file";
        }
        if (importSubmit) {
          importSubmit.disabled = !file;
        }
      });
      tenantPricingImportFile?.addEventListener("change", () => {
        const file = tenantPricingImportFile.files && tenantPricingImportFile.files[0];
        if (tenantPricingImportFileName) {
          tenantPricingImportFileName.textContent = file ? file.name : "Chưa chọn file";
        }
        if (tenantPricingImportSubmit) {
          tenantPricingImportSubmit.disabled = !file;
        }
      });

      function escapeHtml(value) {
        return `${value ?? ""}`
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function setTenantDevicePreviewStatus(message, isError = false) {
        if (!tenantDevicePreviewStatus) return;
        tenantDevicePreviewStatus.textContent = message || "";
        tenantDevicePreviewStatus.classList.toggle("is-error", Boolean(isError));
      }

      function selectedTenantDeviceIds() {
        return Array.from(document.querySelectorAll(".tenant-device-checkbox:checked"))
          .map((input) => input.value)
          .filter(Boolean);
      }

      function syncSelectedTenantDeviceInputs() {
        if (!tenantDeviceSelectedInputs) return;
        tenantDeviceSelectedInputs.innerHTML = "";
        if (!tenantPricingApplyDevices?.checked) return;
        selectedTenantDeviceIds().forEach((deviceId) => {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = "selectedDeviceIds";
          input.value = deviceId;
          tenantDeviceSelectedInputs.appendChild(input);
        });
      }

      function updateTenantDeviceSelectAllLabel() {
        if (!tenantDeviceSelectAll) return;
        const boxes = Array.from(document.querySelectorAll(".tenant-device-checkbox:not([disabled])"));
        const checked = boxes.filter((box) => box.checked).length;
        tenantDeviceSelectAll.textContent = boxes.length > 0 && checked === boxes.length ? "Bo tick all" : "Tick all";
        setTenantDevicePreviewStatus(boxes.length ? `Da chon ${checked}/${boxes.length} thiet bi.` : "Khong co thiet bi de chon.");
      }

      function normalizeTenantDeviceSearchValue(value) {
        return `${value || ""}`.trim().toLowerCase();
      }

      function renderTenantDeviceCopySvg() {
        return `<svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-1v1a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3h1V7Zm3-1a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-6Zm-3 4H7a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-1h-3a3 3 0 0 1-3-3v-3Z"/></svg><svg class="check-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9.2 16.6-4.1-4.1L3.7 14l5.5 5.5L20.8 7.9l-1.4-1.4L9.2 16.6Z"/></svg>`;
      }

      function markTenantDeviceKitCopied(button) {
        window.clearTimeout(Number(button.dataset.copyResetTimer || 0));
        button.classList.add("is-copied");
        button.dataset.copyTooltip = "Copied";
        button.setAttribute("aria-label", "Copied");
        const timer = window.setTimeout(() => {
          button.classList.remove("is-copied");
          button.dataset.copyTooltip = "Copy";
          button.setAttribute("aria-label", button.dataset.copyLabel || "Copy KIT");
          delete button.dataset.copyResetTimer;
        }, 2000);
        button.dataset.copyResetTimer = `${timer}`;
      }

      async function copyTenantDeviceKit(button) {
        const value = button.dataset.copyValue || "";
        if (!value) return;
        button.dataset.copyLabel ||= button.getAttribute("aria-label") || "Copy KIT";
        try {
          await navigator.clipboard.writeText(value);
          markTenantDeviceKitCopied(button);
        } catch {
          const textArea = document.createElement("textarea");
          textArea.value = value;
          textArea.setAttribute("readonly", "");
          textArea.style.position = "fixed";
          textArea.style.opacity = "0";
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand("copy");
          textArea.remove();
          markTenantDeviceKitCopied(button);
        }
      }

      function syncTenantDeviceGroupCheck(group) {
        const tenantCheck = group.querySelector(".tenant-device-tenant-check");
        if (!tenantCheck) return;
        const visibleBoxes = Array.from(group.querySelectorAll(".tenant-device-checkbox:not([disabled])"));
        tenantCheck.checked = visibleBoxes.length > 0 && visibleBoxes.every((box) => box.checked);
        tenantCheck.disabled = group.hidden || visibleBoxes.length === 0;
      }

      function applyTenantDeviceSearch() {
        const keyword = normalizeTenantDeviceSearchValue(tenantDeviceSearchInput?.value);
        document.querySelectorAll(".tenant-device-group").forEach((group) => {
          const tenantText = `${group.dataset.search || ""}`.toLowerCase();
          let visibleDevices = 0;
          group.querySelectorAll(".tenant-device-row").forEach((row) => {
            const rowText = `${row.dataset.search || ""}`.toLowerCase();
            const kitText = `${row.dataset.kit || ""}`.toLowerCase();
            const kitMatched = Boolean(keyword) && kitText.includes(keyword);
            const visible = !keyword || rowText.includes(keyword) || tenantText.includes(keyword);
            row.hidden = !visible;
            row.classList.toggle("is-kit-search-match", kitMatched);
            const checkbox = row.querySelector(".tenant-device-checkbox");
            if (checkbox) {
              checkbox.disabled = !visible;
              if (kitMatched) checkbox.checked = true;
            }
            if (visible) {
              visibleDevices++;
              if (kitMatched) group.open = true;
            }
          });
          const groupVisible = !keyword || visibleDevices > 0 || tenantText.includes(keyword);
          group.hidden = !groupVisible;
          syncTenantDeviceGroupCheck(group);
        });
        syncSelectedTenantDeviceInputs();
        updateTenantDeviceSelectAllLabel();
      }

      function bindTenantDevicePreviewEvents() {
        document.querySelectorAll(".tenant-device-tenant-check").forEach((checkbox) => {
          checkbox.addEventListener("click", (event) => {
            event.stopPropagation();
          });

          checkbox.addEventListener("change", () => {
            const tenantId = checkbox.dataset.tenantId || "";
            document.querySelectorAll(`.tenant-device-checkbox[data-tenant-id="${CSS.escape(tenantId)}"]`).forEach((deviceCheckbox) => {
              deviceCheckbox.checked = checkbox.checked;
            });
            syncSelectedTenantDeviceInputs();
            updateTenantDeviceSelectAllLabel();
          });
        });

        document.querySelectorAll(".tenant-device-checkbox").forEach((checkbox) => {
          checkbox.addEventListener("change", () => {
            const tenantId = checkbox.dataset.tenantId || "";
            const tenantBoxes = Array.from(document.querySelectorAll(`.tenant-device-checkbox[data-tenant-id="${CSS.escape(tenantId)}"]:not([disabled])`));
            const tenantCheck = document.querySelector(`.tenant-device-tenant-check[data-tenant-id="${CSS.escape(tenantId)}"]`);
            if (tenantCheck) {
              tenantCheck.checked = tenantBoxes.length > 0 && tenantBoxes.every((box) => box.checked);
            }
            syncSelectedTenantDeviceInputs();
            updateTenantDeviceSelectAllLabel();
          });
        });

        document.querySelectorAll(".tenant-device-kit-copy").forEach((button) => {
          button.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();
            copyTenantDeviceKit(button);
          });
        });
      }

      function renderTenantDevicePreview(tenants) {
        if (!tenantDevicePreviewBody) return;
        const rows = Array.isArray(tenants) ? tenants : [];
        if (rows.length === 0) {
          tenantDevicePreviewBody.innerHTML = `<div class="tenant-device-empty">Khong tim thay tenant trong file import.</div>`;
          updateTenantDeviceSelectAllLabel();
          return;
        }

        tenantDevicePreviewBody.innerHTML = rows.map((tenant) => {
          const tenantId = tenant.tenantId ?? tenant.TenantId;
          const tenantName = tenant.tenantName ?? tenant.TenantName ?? `Tenant #${tenantId}`;
          const importedPlanCount = tenant.importedPlanCount ?? tenant.ImportedPlanCount ?? 0;
          const devices = tenant.devices ?? tenant.Devices ?? [];
          const deviceRows = devices.length
            ? devices.map((device) => {
                const deviceId = device.deviceId ?? device.DeviceId;
                const deviceName = device.deviceName ?? device.DeviceName ?? "-";
                const deviceCode = device.deviceCode ?? device.DeviceCode ?? "-";
                const vesselName = device.vesselName ?? device.VesselName ?? "-";
                const existingPlanCount = device.existingPlanCount ?? device.ExistingPlanCount ?? 0;
                return `
                  <label class="tenant-device-row" data-search="${escapeHtml(`${deviceName} ${deviceCode} ${vesselName}`)}" data-kit="${escapeHtml(deviceName)}">
                    <input type="checkbox" class="tenant-device-checkbox" data-tenant-id="${tenantId}" value="${deviceId}" checked />
                    <span class="tenant-device-main">
                      <span class="tenant-device-kit-line">
                        <strong class="tenant-device-kit">${escapeHtml(deviceName)}</strong>
                        ${deviceName && deviceName !== "-" ? `<button type="button" class="table-copy-btn tenant-device-kit-copy" data-copy-value="${escapeHtml(deviceName)}" data-copy-tooltip="Copy" aria-label="Copy KIT">${renderTenantDeviceCopySvg()}</button>` : ""}
                      </span>
                      <small>${escapeHtml(deviceCode)}</small>
                    </span>
                    <span class="tenant-device-vessel">${escapeHtml(vesselName)}</span>
                    <span class="tenant-device-count">${existingPlanCount} goi dang co</span>
                  </label>`;
              }).join("")
            : `<div class="tenant-device-empty">Tenant nay chua co thiet bi.</div>`;

          return `
            <details class="tenant-device-group" open data-search="${escapeHtml(`${tenantName} ${devices.map((device) => `${device.deviceName ?? device.DeviceName ?? ""} ${device.deviceCode ?? device.DeviceCode ?? ""} ${device.vesselName ?? device.VesselName ?? ""}`).join(" ")}`)}">
              <summary class="tenant-device-summary">
                <span class="tenant-device-tenant-toggle">
                  <input type="checkbox" class="tenant-device-tenant-check" data-tenant-id="${tenantId}" aria-label="Chon tat ca thiet bi cua ${escapeHtml(tenantName)}" ${devices.length ? "checked" : ""} ${devices.length ? "" : "disabled"} />
                  <span class="tenant-device-tenant-name">${escapeHtml(tenantName)}</span>
                </span>
                <em>${devices.length} thiet bi - ${importedPlanCount} goi import</em>
              </summary>
              <div class="tenant-device-list">${deviceRows}</div>
            </details>`;
        }).join("");
        bindTenantDevicePreviewEvents();
        applyTenantDeviceSearch();
        syncSelectedTenantDeviceInputs();
        updateTenantDeviceSelectAllLabel();
      }

      async function loadTenantDevicePreview() {
        const file = tenantPricingImportFile?.files && tenantPricingImportFile.files[0];
        if (!tenantPricingImportForm || !tenantDevicePreview || !file || !tenantPricingApplyDevices?.checked) {
          if (tenantDevicePreview) tenantDevicePreview.hidden = true;
          if (tenantDevicePreviewBody) tenantDevicePreviewBody.innerHTML = "";
          syncSelectedTenantDeviceInputs();
          return;
        }

        tenantDevicePreview.hidden = false;
        setTenantDevicePreviewStatus("Dang doc file va tai danh sach thiet bi...");
        if (confirmTenantDeviceImportButton) confirmTenantDeviceImportButton.disabled = true;
        if (tenantDevicePreviewBody) tenantDevicePreviewBody.innerHTML = "";

        const formData = new FormData();
        formData.append("importFile", file);
        const token = tenantPricingImportForm.querySelector("input[name='__RequestVerificationToken']")?.value;
        if (token) formData.append("__RequestVerificationToken", token);

        try {
          const response = await fetch(tenantPricingImportForm.dataset.previewUrl || "", {
            method: "POST",
            body: formData,
            headers: { "X-Requested-With": "XMLHttpRequest" }
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok || payload.success === false) {
            throw new Error(payload.message || `HTTP ${response.status}`);
          }
          renderTenantDevicePreview(payload.tenants || payload.Tenants || []);
          if (confirmTenantDeviceImportButton) confirmTenantDeviceImportButton.disabled = false;
        } catch (error) {
          if (tenantDevicePreviewBody) tenantDevicePreviewBody.innerHTML = "";
          setTenantDevicePreviewStatus(error.message || "Khong the tai danh sach thiet bi.", true);
          if (confirmTenantDeviceImportButton) confirmTenantDeviceImportButton.disabled = true;
        }
      }

      function syncTenantDevicePreview() {
        window.clearTimeout(syncTenantDevicePreview.timer);
        syncTenantDevicePreview.timer = window.setTimeout(loadTenantDevicePreview, 150);
      }

      tenantPricingApplyDevices?.addEventListener("change", () => {
        if (!tenantPricingApplyDevices.checked) {
          closeTenantDevicePreviewModal();
          if (tenantDevicePreviewBody) tenantDevicePreviewBody.innerHTML = "";
        }
        syncSelectedTenantDeviceInputs();
      });
      tenantDeviceSearchInput?.addEventListener("input", applyTenantDeviceSearch);
      closeTenantDevicePreviewModalButton?.addEventListener("click", closeTenantDevicePreviewModal);
      cancelTenantDevicePreviewModalButton?.addEventListener("click", closeTenantDevicePreviewModal);
      tenantDeviceSelectAll?.addEventListener("click", () => {
        const boxes = Array.from(document.querySelectorAll(".tenant-device-checkbox:not([disabled])"));
        const shouldCheck = boxes.some((box) => !box.checked);
        boxes.forEach((box) => { box.checked = shouldCheck; });
        document.querySelectorAll(".tenant-device-tenant-check:not(:disabled)").forEach((box) => {
          const tenantId = box.dataset.tenantId || "";
          const tenantBoxes = Array.from(document.querySelectorAll(`.tenant-device-checkbox[data-tenant-id="${CSS.escape(tenantId)}"]:not([disabled])`));
          box.checked = tenantBoxes.length > 0 && tenantBoxes.every((deviceBox) => deviceBox.checked);
        });
        syncSelectedTenantDeviceInputs();
        updateTenantDeviceSelectAllLabel();
      });
      confirmTenantDeviceImportButton?.addEventListener("click", () => {
        const boxes = Array.from(document.querySelectorAll(".tenant-device-checkbox"));
        if (boxes.length > 0 && selectedTenantDeviceIds().length === 0) {
          setTenantDevicePreviewStatus("Vui long chon it nhat mot thiet bi hoac tat cap nhat bang gia thiet bi.", true);
          return;
        }
        tenantDeviceImportConfirmed = true;
        syncSelectedTenantDeviceInputs();
        closeTenantDevicePreviewModal();
        tenantPricingImportForm?.requestSubmit();
      });
      tenantPricingImportForm?.addEventListener("submit", (event) => {
        if (tenantPricingApplyDevices?.checked && !tenantDeviceImportConfirmed) {
          event.preventDefault();
          tenantPricingImportMenu.open = false;
          openTenantDevicePreviewModal();
          return;
        }
        tenantDeviceImportConfirmed = false;
        syncSelectedTenantDeviceInputs();
      }, true);

      const moneyInputs = Array.from(document.querySelectorAll("[data-money-input]"));
      function normalizeMoneyText(value, decimals = 0) {
        let text = `${value || ""}`.trim();
        if (!text) return "";
        text = text.replace(/[^\d,.-]/g, "");
        if (decimals <= 0) {
          return text.replace(/[^\d-]/g, "");
        }

        const lastComma = text.lastIndexOf(",");
        const lastDot = text.lastIndexOf(".");
        const decimalIndex = Math.max(lastComma, lastDot);
        if (decimalIndex < 0) return text.replace(/[^\d-]/g, "");

        const integerPart = text.slice(0, decimalIndex).replace(/[^\d-]/g, "");
        const decimalPart = text.slice(decimalIndex + 1).replace(/\D/g, "").slice(0, decimals);
        return decimalPart ? `${integerPart}.${decimalPart}` : integerPart;
      }

      function formatMoneyText(value, decimals = 0) {
        const normalized = normalizeMoneyText(value, decimals);
        if (!normalized || normalized === "-") return "";
        const number = Number(normalized);
        if (!Number.isFinite(number)) return "";
        return number.toLocaleString(decimals <= 0 ? "vi-VN" : "en-US", {
          minimumFractionDigits: 0,
          maximumFractionDigits: decimals
        });
      }

      function formatMoneyInput(input) {
        const decimals = Number(input.dataset.moneyDecimals || "0");
        input.value = formatMoneyText(input.value, decimals);
      }

      function normalizeMoneyInput(input) {
        const decimals = Number(input.dataset.moneyDecimals || "0");
        input.value = normalizeMoneyText(input.value, decimals) || "0";
      }

      moneyInputs.forEach((input) => {
        formatMoneyInput(input);
        input.addEventListener("input", () => formatMoneyInput(input));
        input.addEventListener("blur", () => formatMoneyInput(input));
      });
      document.querySelectorAll("form").forEach((form) => {
        form.addEventListener("submit", () => {
          form.querySelectorAll("[data-money-input]").forEach(normalizeMoneyInput);
        }, true);
      });

      document.querySelectorAll(".tenant-pricing-plan-select").forEach((select) => {
        select.addEventListener("change", () => {
          const option = select.selectedOptions && select.selectedOptions[0];
          const prefix = select.getAttribute("data-form-prefix");
          if (!option || !prefix) return;

          const map = {
            ResellerPrice: option.dataset.resellerPrice,
            FinalPrice: option.dataset.finalPrice,
            ResellerOverChargePrice: option.dataset.resellerOverchargePrice,
            FinalOverChargePrice: option.dataset.finalOverchargePrice
          };

          Object.entries(map).forEach(([name, value]) => {
            const input = document.getElementById(`${prefix}_${name}`);
            if (input && value !== undefined) {
              input.value = value;
              if (input.matches("[data-money-input]")) formatMoneyInput(input);
            }
          });
        });
      });

      syncBodyOverflow();
    })();
  </script>
}
