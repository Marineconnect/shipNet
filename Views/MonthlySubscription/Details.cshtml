      <table class="subscription-kv-table ninepay-qr-table">
        <tbody>
          <tr><th>Invoice đối tác / Provider Invoice</th><td id="ninePayIpnProviderInvoice">-</td></tr>
          <tr><th>Trạng thái QR / QR Status</th><td id="ninePayIpnQrStatus">-</td></tr>
          <tr><th>Thời điểm nhận IPN / IPN Received</th><td id="ninePayIpnReceived">-</td></tr>
          <tr><th>Trạng thái xử lý / Process Status</th><td id="ninePayIpnProcessStatus">-</td></tr>
          <tr><th>Thông báo xử lý / Process Message</th><td id="ninePayIpnProcessMessage">-</td></tr>
          <tr><th>Mã thanh toán / Payment No</th><td id="ninePayIpnPaymentNo">-</td></tr>
          <tr><th>Trạng thái đối tác / Provider Status</th><td id="ninePayIpnProviderStatus">-</td></tr>
          <tr><th>Giao dịch mới nhất / Latest Transaction</th><td id="ninePayIpnLatestTransaction">-</td></tr>
        </tbody>
      </table>
      <details class="ninepay-debug" open>
        <summary>Payload IPN đã decode/raw / Decoded/raw IPN payload</summary>
        <pre id="ninePayIpnRawJson">-</pre>
