@model MonthlySubscriptionDetailViewModel
@{
    ViewData["ActiveNav"] = "subscription";
    ViewData["Title"] = "Subscription Detail";
    string Money(decimal value) => $"$ {value:#,##0.##}";
    string Data(decimal value) => $"{value:#,##0.##} GB";
    string Vnd(decimal value) => $"{value:#,##0} VND";
    string NumberInput(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string DateTimeInput(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-ddTHH:mm") : string.Empty;
    string DateInput(DateTime value) => value.ToString("yyyy-MM-dd");
    string MonthInput(DateTime value) => value.ToString("yyyy-MM");
    string StatusLabel(string status) => status switch
    {
        "active" => "Kích hoạt / Active",
        "debit" => "Ghi nợ / Debit",
        "paid" => "Đã thanh toán / Paid",
        "terminated" => "Hủy / Terminated",
        "pending_payment" => "Ghi nợ / Pending Payment",
        _ => status
    };
    var successMessage = TempData["SubscriptionSuccess"]?.ToString();
    var errorMessage = TempData["SubscriptionError"]?.ToString();
    var defaultInvoice = Model.Invoices.FirstOrDefault();
}

<div class="device-page">
  <div class="device-shell">
        <partial name="_PortalNav" />

    <div class="device-topbar">
      <div>
        <div class="device-brand">Tóm tắt subscription / Subscription Summary</div>
        <h1>@Model.Subscription.VesselName</h1>
        <p>@Model.Subscription.PlanName • @Model.Subscription.SubscriptionPeriodDisplay</p>
      </div>
      <div class="device-actions">
        <a asp-controller="MonthlySubscription" asp-action="Index" class="btn-secondary">Quay lại / Back</a>
      </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
      <div class="tenant-feedback is-success">@successMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
      <div class="tenant-feedback is-error" role="alert">@errorMessage</div>
    }

    <div class="subscription-detail-grid">
      <section class="device-card subscription-summary-card">
        <div class="device-card-head">
          <div>
            <h2>Tóm tắt / Summary</h2>
            <p>Thông tin subscription và giá prorated / Subscription information and prorated pricing.</p>
          </div>
        </div>
        <table class="subscription-kv-table">
          <tbody>
            <tr><th>Tàu / Vessel</th><td>@Model.Subscription.VesselName</td><th>Tenant / Tenant</th><td>@Model.Subscription.TenantName</td></tr>
            <tr><th>Mã KIT / Kit ID</th><td>@Model.Subscription.KitId</td><th>Gói / Plan</th><td>@Model.Subscription.PlanName</td></tr>
            <tr><th>Loại / Type</th><td>@Model.Subscription.SubscriptionType</td><th>Kỳ billing / Billing Period</th><td>@Model.Subscription.SubscriptionPeriodDisplay</td></tr>
            <tr><th>Giới hạn data / Data Limit</th><td>@Data(Model.Subscription.DataLimitGb)</td><th>Ngày billing tiếp theo / Next Billing Date</th><td>@Model.Subscription.NextBillingDateDisplay</td></tr>
            <tr><th>Đơn giá / Unit Price</th><td>@Money(Model.Subscription.BasePlanPrice)</td><th>Giá overcharge / Overcharge Price</th><td>@Money(Model.Subscription.OverChargePrice) / GB</td></tr>
            <tr><th>Số ngày / Days</th><td>@Model.Subscription.SubscriptionDays</td><th>Tiền subscription / Subscription Price</th><td>@Money(Model.Subscription.SubscriptionPrice)</td></tr>
            <tr><th>Tổng invoice / Total Invoice</th><td>@Money(Model.Subscription.TotalInvoiceAmount)</td><th>Đã thanh toán / Total Paid</th><td>@Money(Model.Subscription.TotalPaid)</td></tr>
            <tr><th>Trạng thái / Status</th><td colspan="3"><span class="subscription-status @Model.Subscription.Status">@StatusLabel(Model.Subscription.Status)</span></td></tr>
          </tbody>
        </table>
        @if (Model.CanManageSubscriptions)
        {
          <form asp-controller="MonthlySubscription" asp-action="UpdateStatus" method="post" class="subscription-status-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SubscriptionId" value="@Model.Subscription.Id" />
            <label class="detail-field">
              <span>Cập nhật trạng thái subscription / Update subscription status</span>
              <select name="Status">
                <option value="active" selected="@(Model.Subscription.Status == "active")">Kích hoạt / Active</option>
                <option value="debit" selected="@(Model.Subscription.Status == "debit" || Model.Subscription.Status == "pending_payment")">Ghi nợ / Debit</option>
                <option value="paid" selected="@(Model.Subscription.Status == "paid")">Đã thanh toán / Paid</option>
                <option value="terminated" selected="@(Model.Subscription.Status == "terminated")">Hủy / Terminated</option>
              </select>
            </label>
            <button type="submit" class="btn-primary">Cập nhật subscription / Update subscription</button>
          </form>
          <form asp-controller="MonthlySubscription" asp-action="UpdateBilling" method="post" class="invoice-edit-form subscription-billing-edit-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SubscriptionId" value="@Model.Subscription.Id" />
            <div class="invoice-edit-grid">
              <label class="detail-field">
                <span>Tháng sử dụng / Usage Month</span>
                <input type="month" name="UsageMonth" id="Billing_UsageMonth" value="@MonthInput(Model.UpdateBillingForm.UsageMonth)" disabled="@(!Model.CanEditBilling)" />
              </label>
              <label class="detail-field">
                <span>Ngày bắt đầu / Start Date</span>
                <input type="date" name="StartDate" id="Billing_StartDate" value="@DateInput(Model.UpdateBillingForm.StartDate)" disabled="@(!Model.CanEditBilling)" />
              </label>
              <label class="detail-field">
                <span>Ngày kết thúc / End Date</span>
                <input type="date" name="EndDate" id="Billing_EndDate" value="@DateInput(Model.UpdateBillingForm.EndDate)" disabled="@(!Model.CanEditBilling)" />
              </label>
              <label class="detail-field">
                <span>Ngày billing tiếp theo / Next Billing Date</span>
                <input type="date" name="NextBillingDate" value="@DateInput(Model.UpdateBillingForm.NextBillingDate)" disabled="@(!Model.CanEditBilling)" />
              </label>
              <label class="detail-field">
                <span>Giá bán cuối ($) / Final Sale Price ($)</span>
                <input type="number" step="0.01" min="0" name="BasePlanPrice" id="Billing_BasePlanPrice" value="@NumberInput(Model.UpdateBillingForm.BasePlanPrice)" disabled="@(!Model.CanEditBilling)" />
              </label>
              <label class="detail-field">
                <span>Giá overcharge ($/GB) / Overcharge Price ($/GB)</span>
                <input type="number" step="0.01" min="0" name="OverChargePrice" value="@NumberInput(Model.UpdateBillingForm.OverChargePrice)" disabled="@(!Model.CanEditBilling)" />
              </label>
            </div>
            <div class="subscription-calculation" id="billingCalculation">-</div>
            @if (!Model.CanEditBilling && !string.IsNullOrWhiteSpace(Model.BillingEditBlockedReason))
            {
              <div class="tenant-feedback">@Model.BillingEditBlockedReason</div>
            }
            @if (Model.CanEditBilling)
            {
              <button type="submit" class="btn-primary">Cập nhật kỳ billing / Update billing</button>
            }
          </form>
        }
      </section>

      <section class="device-card subscription-summary-card">
        <div class="device-card-head">
          <div>
            <h2>Invoice / Invoice</h2>
            <p>Thông tin invoice đang chọn / Information for the selected invoice.</p>
          </div>
        </div>
        <table class="subscription-kv-table">
          <tbody>
            <tr><th>Loại / Type</th><td id="selectedInvoiceType">@(defaultInvoice?.InvoiceType ?? "-")</td><th>Ngày tạo / Created</th><td id="selectedInvoiceCreated">@(defaultInvoice?.CreatedAt.ToString("dd/MM/yyyy HH:mm") ?? "-")</td></tr>
            <tr><th>Tổng tiền / Total Amount</th><td id="selectedInvoiceAmount">@Money(defaultInvoice?.Amount ?? 0)</td><th>Đã thanh toán / Total Paid</th><td id="selectedInvoicePaid">@Money(defaultInvoice?.PaidAmount ?? 0)</td></tr>
            <tr><th>Hoàn tiền / Total Refund</th><td id="selectedInvoiceRefund">@Money(defaultInvoice?.RefundAmount ?? 0)</td><th>Trạng thái / Status</th><td id="selectedInvoiceStatus">@(defaultInvoice?.Status ?? "-")</td></tr>
            <tr><th>Số invoice / Invoice Number</th><td id="selectedInvoiceNumber">@(defaultInvoice?.InvoiceNumber ?? "-")</td><th>Số biên nhận / Receipt Number</th><td id="selectedInvoiceReceipt">@(defaultInvoice?.ReceiptNumber ?? "-")</td></tr>
            <tr><th>Số PO / PO Number</th><td id="selectedInvoicePo">@(defaultInvoice?.PoNumber ?? "-")</td><th>Hoàn tất lúc / Completed At</th><td id="selectedInvoiceCompleted">@(defaultInvoice?.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td></tr>
          </tbody>
        </table>
        @if (Model.CanManageSubscriptions && defaultInvoice != null)
        {
          <form asp-controller="MonthlySubscription" asp-action="UpdateInvoice" method="post" class="invoice-edit-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SubscriptionId" value="@Model.Subscription.Id" />
            <input type="hidden" name="InvoiceId" id="UpdateInvoice_InvoiceId" value="@defaultInvoice.Id" />
            <div class="invoice-edit-grid">
              <label class="detail-field">
                <span>Số invoice / Invoice Number</span>
                <input name="InvoiceNumber" id="UpdateInvoice_InvoiceNumber" maxlength="100" value="@defaultInvoice.InvoiceNumber" disabled="@(defaultInvoice.IsPaidByBankTransfer)" />
              </label>
              <label class="detail-field">
                <span>Tổng tiền ($) / Total Amount ($)</span>
                <input type="number" step="0.01" min="0" name="Amount" id="UpdateInvoice_Amount" value="@NumberInput(defaultInvoice.Amount)" disabled="@(defaultInvoice.IsPaidByBankTransfer)" />
              </label>
              <label class="detail-field">
                <span>Hoàn tiền ($) / Refund Amount ($)</span>
                <input type="number" step="0.01" min="0" name="RefundAmount" id="UpdateInvoice_RefundAmount" value="@NumberInput(defaultInvoice.RefundAmount)" disabled="@(defaultInvoice.IsPaidByBankTransfer)" />
              </label>
              <label class="detail-field">
                <span>Hoàn tất lúc / Completed At</span>
                <input type="datetime-local" name="CompletedAt" id="UpdateInvoice_CompletedAt" value="@DateTimeInput(defaultInvoice.CompletedAt)" disabled="@(defaultInvoice.IsPaidByBankTransfer)" />
              </label>
              <label class="detail-field">
                <span>Trạng thái / Status</span>
                <select name="Status" id="UpdateInvoice_Status" disabled="@(defaultInvoice.IsPaidByBankTransfer)">
                  <option value="pending" selected="@(defaultInvoice.Status == "pending")">Chờ xử lý / Pending</option>
                  <option value="paid" selected="@(defaultInvoice.Status == "paid")">Đã thanh toán / Paid</option>
                  <option value="refunded" selected="@(defaultInvoice.Status == "refunded")">Đã hoàn tiền / Refunded</option>
                  <option value="void" selected="@(defaultInvoice.Status == "void")">Đã hủy / Void</option>
                </select>
              </label>
            </div>
            <div class="tenant-feedback" id="bankTransferPaidNotice" hidden="@(!defaultInvoice.IsPaidByBankTransfer)">Invoice đã thanh toán bằng chuyển khoản, không thể cập nhật lại trạng thái / This invoice was paid by bank transfer and cannot be updated again.</div>
            <div class="invoice-edit-actions">
              <button type="submit" class="btn-primary" id="updateInvoiceButton" disabled="@(defaultInvoice.IsPaidByBankTransfer)" @((defaultInvoice.IsPaidByBankTransfer) ? "hidden" : string.Empty)>Cập nhật invoice / Update invoice</button>
              <button type="button"
                      class="btn-secondary"
                      id="makeQrButton"
                      data-invoice-id="@defaultInvoice.Id"
                      @(!string.Equals(defaultInvoice.Status, "pending", StringComparison.OrdinalIgnoreCase) ? "hidden" : string.Empty)>
                Tạo QR / Make QR
              </button>
            </div>
          </form>
        }
      </section>
    </div>

    <section class="device-card">
      <div class="device-card-head">
        <div>
          <h2>Invoices / Invoices</h2>
          <p>Invoice chính, overcharge và các loại phí khác / Primary invoices, overcharge, and other fees.</p>
        </div>
        @if (Model.CanManageSubscriptions)
        {
          <button type="button" class="btn-primary invoice-create-button" id="openInvoiceModal" hidden>Tạo invoice / Create invoice</button>
        }
      </div>
      <div class="table-wrap">
        <table class="device-table subscription-table">
          <thead>
            <tr>
              <th class="invoice-select-col"></th>
              <th>ID invoice / Invoice ID</th>
              <th>Loại / Type</th>
              <th>Data (GB) / Data in GB</th>
              <th>Ngày tạo / Created</th>
              <th>Số tiền / Amount</th>
              <th>Đã trả / Paid</th>
              <th>Giá mua / Buy Price</th>
              <th>Giá bán / Sale Price</th>
              <th>Lợi nhuận / Margin</th>
              <th>Trạng thái / Status</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var invoice in Model.Invoices)
            {
              <tr class="invoice-row @(defaultInvoice?.Id == invoice.Id ? "is-selected" : string.Empty)"
                  data-invoice-id="@invoice.Id"
                  data-invoice-number="@invoice.InvoiceNumber"
                  data-receipt-number="@invoice.ReceiptNumber"
                  data-po-number="@invoice.PoNumber"
                  data-type="@invoice.InvoiceType"
                  data-created="@invoice.CreatedAt.ToString("dd/MM/yyyy HH:mm")"
                  data-completed="@(invoice.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")"
                  data-completed-input="@DateTimeInput(invoice.CompletedAt)"
                  data-amount="@Money(invoice.Amount)"
                  data-amount-raw="@NumberInput(invoice.Amount)"
                  data-paid="@Money(invoice.PaidAmount)"
                  data-refund="@Money(invoice.RefundAmount)"
                  data-refund-raw="@NumberInput(invoice.RefundAmount)"
                  data-status="@invoice.Status"
                  data-paid-by-bank-transfer="@invoice.IsPaidByBankTransfer.ToString().ToLowerInvariant()">
                <td class="invoice-select-col">
                  <input type="radio"
                         name="selectedInvoice"
                         value="@invoice.Id"
                         aria-label="Chọn invoice @invoice.InvoiceNumber / Select invoice @invoice.InvoiceNumber"
                         checked="@(defaultInvoice?.Id == invoice.Id)" />
                </td>
                <td>#@invoice.Id<br /><span class="tenant-meta">@invoice.InvoiceNumber</span></td>
                <td>@invoice.InvoiceType</td>
                <td>@Data(invoice.DataGb)</td>
                <td>@invoice.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@Money(invoice.Amount)</td>
                <td>@Money(invoice.PaidAmount)</td>
                <td>@Money(invoice.BuyPrice)</td>
                <td>@Money(invoice.SalePrice)</td>
                <td>@Money(invoice.MarginAmount)</td>
                <td><span class="subscription-status @invoice.Status">@invoice.Status</span></td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      @if (Model.CanViewQrSessions)
      {
      <div class="invoice-qr-history" id="invoiceQrHistory">
        <div class="invoice-qr-history-head">
          <div>
            <h3>Phiên QR / QR sessions</h3>
            <p id="invoiceQrHistoryMeta">Danh sách QR đã tạo cho invoice đang chọn / QR list created for the selected invoice.</p>
          </div>
          <button type="button"
                  class="invoice-qr-history-toggle"
                  id="toggleInvoiceQrHistory"
                  aria-controls="invoiceQrHistoryBody"
                  aria-expanded="true">[-]</button>
        </div>
        <div class="invoice-qr-history-scroll" id="invoiceQrHistoryBody">
          <table class="device-table invoice-qr-history-table">
            <thead>
              <tr>
                <th>Ngày tạo / Created</th>
                <th>Người tạo / Created By</th>
                <th>Kênh / Channel</th>
                <th>Hết hạn / Expires</th>
                <th>Giờ còn lại / Hours Left</th>
                <th>Tiền invoice / Invoice Amount</th>
                <th>Tài khoản NH / Bank Account</th>
                <th>Nội dung CK / Transfer Content</th>
                <th>Phí CK / Transfer Fee</th>
                <th>Mã đối tác / Provider Ref</th>
                <th>Trạng thái / Status</th>
                <th>Mã thanh toán IPN / IPN Payment No</th>
                <th>Trạng thái IPN / IPN Status</th>
                <th>Nhận IPN / IPN Received</th>
                <th>Tổng phiên / Session Total</th>
                <th>IPN / IPN</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var qr in Model.QrSessions)
              {
                <tr class="invoice-qr-session-row"
                    data-invoice-id="@qr.InvoiceId"
                    data-qr-session-id="@qr.Id">
                  <td>@(qr.CreatedAt == DateTime.MinValue ? "-" : qr.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</td>
                  <td>@(string.IsNullOrWhiteSpace(qr.CreatedBy) ? "-" : qr.CreatedBy)</td>
                  <td>@(string.IsNullOrWhiteSpace(qr.Channel) ? "9pay" : qr.Channel)</td>
                  <td>@(qr.ExpiresAt == DateTime.MinValue ? "-" : qr.ExpiresAt.ToString("dd/MM/yyyy HH:mm"))</td>
                  <td>@qr.HoursRemaining.ToString("#,##0.##")</td>
                  <td>@Vnd(qr.InvoiceAmountVnd)</td>
                  <td>@(string.IsNullOrWhiteSpace(qr.BankAccountNo) ? "-" : qr.BankAccountNo)</td>
                  <td>@(string.IsNullOrWhiteSpace(qr.TransferContent) ? "-" : qr.TransferContent)</td>
                  <td>@Vnd(qr.TransferFeeVnd)</td>
                  <td>@(string.IsNullOrWhiteSpace(qr.ProviderRef) ? "-" : qr.ProviderRef)</td>
                  <td><span class="subscription-status @qr.Status.ToLowerInvariant()">@(string.IsNullOrWhiteSpace(qr.Status) ? "-" : qr.Status)</span></td>
                  <td>@(string.IsNullOrWhiteSpace(qr.IpnPaymentNo) ? "-" : qr.IpnPaymentNo)</td>
                  <td>@(string.IsNullOrWhiteSpace(qr.IpnProcessStatus) ? "-" : qr.IpnProcessStatus)</td>
                  <td>@(qr.IpnReceivedAt.HasValue ? qr.IpnReceivedAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")</td>
                  <td>
                    @Vnd(qr.SessionTotalVnd)
                    @if (qr.IsGrouped)
                    {
                      <br /><span class="tenant-meta">QR nhóm / Grouped QR</span>
                    }
                  </td>
                  <td>
                    <button type="button" class="btn-secondary view-qr-ipn" data-qr-session-id="@qr.Id">Xem / View</button>
                  </td>
                </tr>
              }
              <tr class="invoice-qr-empty-row">
                <td colspan="16" class="tenant-empty">Chưa có QR session cho invoice này / No QR session for this invoice.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      }
    </section>
  </div>
</div>

@if (Model.CanManageSubscriptions)
{
  <div class="modal-backdrop" id="invoiceModal" hidden>
    <div class="device-modal subscription-modal" role="dialog" aria-modal="true" aria-labelledby="invoiceModalTitle">
      <div class="device-modal-head">
        <div>
          <h2 id="invoiceModalTitle">Tạo invoice / Create invoice</h2>
          <p>Tạo invoice overcharge hoặc phí khác / Create an overcharge invoice or another fee.</p>
        </div>
        <button type="button" class="modal-close" id="closeInvoiceModal" aria-label="Đóng / Close">×</button>
      </div>
      <form asp-controller="MonthlySubscription" asp-action="CreateInvoice" method="post" class="subscription-create-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SubscriptionId" value="@Model.Subscription.Id" />
        <label class="detail-field">
          <span>Loại invoice / Invoice Type</span>
          <select name="InvoiceType" id="invoiceType">
            <option value="OVERCHARGE">OVERCHARGE</option>
            <option value="OTHER">OTHER</option>
          </select>
        </label>
        <label class="detail-field">
          <span>Dữ liệu GB / Data GB</span>
          <input type="number" step="0.01" min="0" name="DataGb" value="0" />
        </label>
        <label class="detail-field">
          <span>Số tiền cho OTHER ($) / Amount for OTHER ($)</span>
          <input type="number" step="0.01" min="0" name="Amount" value="0" />
        </label>
        <label class="detail-field">
          <span>Mô tả / Description</span>
          <input name="Description" maxlength="500" />
        </label>
        <div class="device-modal-actions">
          <button type="button" class="btn-secondary" id="cancelInvoiceModal">Hủy / Cancel</button>
          <button type="submit" class="btn-primary">Lưu / Save</button>
        </div>
      </form>
    </div>
  </div>
}

<div class="modal-backdrop" id="ninePayQrModal" hidden>
  <div class="device-modal subscription-modal ninepay-qr-modal" role="dialog" aria-modal="true" aria-labelledby="ninePayQrTitle">
    <div class="device-modal-head">
      <div>
        <h2 id="ninePayQrTitle">Chuyển khoản 9Pay / 9Pay bank transfer</h2>
        <p id="ninePayQrInvoice">-</p>
      </div>
      <button type="button" class="modal-close" id="closeNinePayQrModal" aria-label="Đóng / Close">×</button>
    </div>
    <div class="ninepay-qr-body">
      <div class="ninepay-bank-name" id="ninePayBankName"></div>
      <table class="subscription-kv-table ninepay-qr-table">
        <tbody>
          <tr><th>Phương thức thanh toán / Payment method</th><td id="ninePayMethod">bank_transfer</td></tr>
          <tr><th>Tổng đơn hàng / Order total</th><td id="ninePayOrderTotal">-</td></tr>
          <tr><th>Tỷ giá VND/USD / VND/USD Exchange Rate</th><td id="ninePayExchangeRate">-</td></tr>
          <tr><th>Số tiền (VND) / Amount (VND)</th><td id="ninePayAmountVnd">-</td></tr>
          <tr><th>Phí giao dịch / Transaction Fee</th><td id="ninePayFeeVnd">-</td></tr>
          <tr><th>Tổng cần thanh toán / Total to Pay</th><td id="ninePayTotalVnd">-</td></tr>
        </tbody>
      </table>
      <div class="ninepay-loading" id="ninePayLoading" hidden>
        <span class="ninepay-loading-spinner"></span>
        <span>Đang tạo QR thanh toán / Creating QR payment...</span>
      </div>
      <div class="tenant-meta" id="ninePayExpires" hidden></div>
      <label class="detail-field ninepay-bank-select-field" id="ninePayBankSelectField" hidden>
        <span>Ngân hàng / Bank</span>
        <select id="ninePayBankSelect"></select>
      </label>
      <div class="ninepay-qr-frame" id="ninePayQrFrame" hidden>
        <img id="ninePayQrImage" alt="QR chuyển khoản 9Pay / 9Pay bank transfer QR" />
      </div>
      <table class="subscription-kv-table ninepay-qr-table" id="ninePayBankTable" hidden>
        <tbody>
          <tr><th>Ngân hàng / Bank</th><td id="ninePayBankDetail">-</td></tr>
          <tr><th>Số tài khoản / Account No</th><td id="ninePayAccountNo">-</td></tr>
          <tr><th>Tên tài khoản / Account Name</th><td id="ninePayAccountName">-</td></tr>
          <tr><th>Số tiền / Amount</th><td id="ninePayBankAmount">-</td></tr>
          <tr><th>Nội dung / Remark</th><td id="ninePayRemark">-</td></tr>
        </tbody>
      </table>
      <div class="device-modal-actions" id="ninePayBankActions" hidden>
        <button type="button" class="btn-secondary" id="copyNinePayRemark">Sao chép nội dung / Copy Remark</button>
        <button type="button" class="btn-secondary" id="copyNinePayAccountNo">Sao chép STK / Copy Account No</button>
        <a class="btn-secondary" id="downloadNinePayQr" href="#" target="_blank" rel="noopener" download>Tải QR / Download QR</a>
