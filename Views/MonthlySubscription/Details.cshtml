      <div class="tenant-meta" id="ninePayProviderInfo" hidden></div>
      <div class="tenant-feedback is-error" id="ninePayQrError" hidden></div>
      <div class="device-modal-actions">
        <a class="btn-secondary" id="openNinePayPayment" href="#" target="_blank" rel="noopener">Chọn ngân hàng trên 9Pay / Choose bank on 9Pay</a>
        <button type="button" class="btn-primary" id="closeNinePayQrAction">Hoàn tất / Done</button>
