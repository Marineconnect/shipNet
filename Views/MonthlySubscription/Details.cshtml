      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.success === false) {
        const detail = payload.message || payload.messageEn || payload.errorCode || `HTTP ${response.status}`;
        throw new Error(detail || "Cannot load JSON payload.");
      }
      const raw = payload.payloadJson || "";
      try {
        integrationLogs.jsonCode.textContent = JSON.stringify(JSON.parse(raw), null, 2);
      } catch {
        integrationLogs.jsonCode.textContent = raw || "-";
      }
      if (payload.payloadTruncated && integrationLogs.jsonMessage) {
        integrationLogs.jsonMessage.textContent = "Payload đã được rút gọn theo cấu hình hiển thị / Payload was truncated by display settings.";
        integrationLogs.jsonMessage.hidden = false;
      }
    } catch (error) {
      if (integrationLogs.jsonCode) integrationLogs.jsonCode.textContent = error.message || "Cannot load JSON payload.";
    }
  }
  qrHistoryToggle?.addEventListener("click", () => {
    const willExpand = qrHistoryBody?.hidden === true;
    if (qrHistoryBody) qrHistoryBody.hidden = !willExpand;
    qrHistoryToggle.textContent = willExpand ? "[-]" : "[+]";
    qrHistoryToggle.setAttribute("aria-expanded", String(willExpand));
  });
  function selectInvoice(row) {
    document.querySelectorAll(".invoice-row").forEach((item) => item.classList.toggle("is-selected", item === row));
    const radio = row.querySelector("input[name='selectedInvoice']");
    if (radio) radio.checked = true;
    if (fields.type) fields.type.textContent = row.dataset.type || "-";
    if (fields.created) fields.created.textContent = row.dataset.created || "-";
    if (fields.amount) fields.amount.textContent = row.dataset.amount || "$ 0";
    if (fields.paid) fields.paid.textContent = row.dataset.paid || "$ 0";
    if (fields.refund) fields.refund.textContent = row.dataset.refund || "$ 0";
    if (fields.status) fields.status.textContent = row.dataset.status || "-";
    if (fields.number) fields.number.textContent = row.dataset.invoiceNumber || "-";
    if (fields.receipt) fields.receipt.textContent = row.dataset.receiptNumber || "-";
    if (fields.po) fields.po.textContent = row.dataset.poNumber || "-";
    if (fields.completed) fields.completed.textContent = row.dataset.completed || "-";
    if (formFields.id) formFields.id.value = row.dataset.invoiceId || "";
    if (formFields.number) formFields.number.value = row.dataset.invoiceNumber || "";
    setMoneyTextbox(formFields.amountDisplay, formFields.amount, row.dataset.amountRaw || "0");
    setMoneyTextbox(formFields.refundDisplay, formFields.refund, row.dataset.refundRaw || "0");
    if (formFields.completed) formFields.completed.value = row.dataset.completedInput || "";
    if (formFields.status) formFields.status.value = row.dataset.status || "pending";
    if (formFields.resumeKvh) formFields.resumeKvh.value = "false";
    syncInvoiceEditLock(row);
    syncMakeQrButton(row);
    syncQrHistory(row);
    syncPdfPanel(row);
    if (integrationLogs.modal && !integrationLogs.modal.hidden) {
      loadIntegrationLogs(true);
    }
  }
  document.querySelectorAll(".invoice-row").forEach((row) => {
    row.addEventListener("click", (event) => {
      if (event.target.closest("form, select, button, input")) return;
      selectInvoice(row);
    });
    row.querySelector("input[name='selectedInvoice']")?.addEventListener("change", () => {
      selectInvoice(row);
    });
  });
  pdfPanel.viewButton?.addEventListener("click", () => {
    const viewUrl = pdfPanel.viewButton.dataset.viewUrl || "";
    if (!viewUrl) return;
    if (pdfPanel.frame) pdfPanel.frame.src = viewUrl;
    if (pdfPanel.viewerSubtitle) pdfPanel.viewerSubtitle.textContent = pdfPanel.viewButton.dataset.fileName || "-";
    if (pdfPanel.openNewTab) pdfPanel.openNewTab.href = viewUrl;
    if (pdfPanel.viewerDownload) pdfPanel.viewerDownload.href = pdfPanel.downloadLink?.href || viewUrl;
    if (pdfPanel.viewerModal) pdfPanel.viewerModal.hidden = false;
  });
  document.querySelector("#closeInvoicePdfViewer")?.addEventListener("click", () => {
    if (pdfPanel.viewerModal) pdfPanel.viewerModal.hidden = true;
    if (pdfPanel.frame) pdfPanel.frame.src = "";
  });
  document.querySelector("#closeInvoicePdfViewerAction")?.addEventListener("click", () => {
    if (pdfPanel.viewerModal) pdfPanel.viewerModal.hidden = true;
    if (pdfPanel.frame) pdfPanel.frame.src = "";
  });
  initMoneyTextboxes();
  makeQrButton?.addEventListener("click", async () => {
    const invoiceId = makeQrButton.dataset.invoiceId || "";
    if (!invoiceId) return;
    makeQrButton.disabled = true;
    makeQrButton.textContent = "Đang tạo... / Creating...";
    resetNinePayPaymentUi();
    if (qrModal) qrModal.hidden = false;
    try {
      const requestUrl = `/Payments/NinePayBankTransferInfo?invoiceId=${encodeURIComponent(invoiceId)}`;
      const response = await fetch(requestUrl, {
        headers: { "Accept": "application/json" }
      });
      const responseText = await response.text();
      let payload;
      try {
        payload = JSON.parse(responseText);
      } catch {
        const error = new Error("Phản hồi máy chủ không phải JSON hợp lệ / Server response is not valid JSON.");
        throw error;
      }
      if (!response.ok || !payload.success) {
        const error = new Error(payload.message || "Không thể tạo thanh toán chuyển khoản / Cannot create bank transfer payment.");
        error.debug = payload.debug || "";
        throw error;
      }
      const data = payload.data;
      setQrLoading(false);
      activePaymentInvoiceId = data.invoiceId || invoiceId;
      if (qrFields.invoice) qrFields.invoice.textContent = data.invoiceNumber || "-";
      if (qrFields.bank) {
        qrFields.bank.textContent = data.instructions || "Mở 9Pay để chọn ngân hàng và hoàn tất thanh toán trên ứng dụng ngân hàng / Open 9Pay to choose a bank and complete payment in your banking app.";
      }
      if (qrFields.method) qrFields.method.textContent = data.paymentMethod || "bank_transfer";
      if (qrFields.orderTotal) qrFields.orderTotal.textContent = formatUsd(data.orderTotalUsd);
      if (qrFields.exchangeRate) qrFields.exchangeRate.textContent = `1 @defaultCurrency = ${Number(data.exchangeRateVndPerUsd || 0).toLocaleString("vi-VN")} VND`;
      if (qrFields.amountVnd) qrFields.amountVnd.textContent = formatVnd(data.amountVnd);
      if (qrFields.feeVnd) qrFields.feeVnd.textContent = formatVnd(data.transactionFeeVnd);
      if (qrFields.totalVnd) qrFields.totalVnd.textContent = formatVnd(data.totalToPayVnd);
      if (qrFields.paymentLink) qrFields.paymentLink.href = data.paymentUrl || "#";
      renderBanks(data.banks || []);
      if (!data.banks || data.banks.length === 0) {
        if (qrError) {
          qrError.textContent = "9Pay không trả về ngân hàng / No banks returned from 9Pay response.";
          qrError.hidden = false;
        }
      }
      setExpires(Number(data.expiresInSeconds || 0));
      if (qrFields.providerInfo) {
        const providerParts = [];
        if (data.invoiceNumber) providerParts.push(`Invoice / Invoice: ${data.invoiceNumber}`);
        if (data.providerPaymentId) providerParts.push(`Mã thanh toán / PaymentNo: ${data.providerPaymentId}`);
        if (data.providerOrderRef) providerParts.push(`Mã đơn / OrderRef: ${data.providerOrderRef}`);
        if (data.reusedQr) providerParts.push("Dùng lại QR còn hiệu lực / Reused active QR");
        qrFields.providerInfo.textContent = providerParts.join(" • ");
        qrFields.providerInfo.hidden = providerParts.length === 0;
      }
      if (qrModal) qrModal.hidden = false;
      startPaymentStatusPolling(activePaymentInvoiceId);
    } catch (error) {
      setQrLoading(false);
      if (qrError) {
        qrError.classList.add("is-error");
        qrError.classList.remove("is-success");
        qrError.textContent = error.message || "Không thể tạo thanh toán chuyển khoản / Cannot create bank transfer payment.";
        qrError.hidden = false;
      }
      if (qrModal) qrModal.hidden = false;
    } finally {
      setQrLoading(false);
      makeQrButton.disabled = false;
      makeQrButton.textContent = "Tạo QR / Make QR";
    }
  });
  testInvoiceRabbitMqButton?.addEventListener("click", async () => {
    const invoiceId = testInvoiceRabbitMqButton.dataset.invoiceId || "";
    if (!invoiceId) return;
    testInvoiceRabbitMqButton.disabled = true;
    const oldText = testInvoiceRabbitMqButton.textContent;
    testInvoiceRabbitMqButton.textContent = "Sending...";
    if (qrModal) qrModal.hidden = false;
    if (qrError) {
      qrError.hidden = true;
      qrError.classList.remove("is-error", "is-success");
    }
    if (invoiceRabbitMqLogWrap) invoiceRabbitMqLogWrap.hidden = false;
    if (invoiceRabbitMqLog) invoiceRabbitMqLog.textContent = "Sending invoice message...";
    if (invoiceRabbitMqPayloadWrap) invoiceRabbitMqPayloadWrap.hidden = true;
    if (invoiceRabbitMqPayload) invoiceRabbitMqPayload.textContent = "-";
    try {
      const response = await fetch(`/Payments/TestInvoiceRabbitMq?invoiceId=${encodeURIComponent(invoiceId)}`, {
        method: "POST",
        headers: { "Accept": "application/json" }
      });
      const payload = await response.json();
      const logs = Array.isArray(payload.logs) ? payload.logs.join("\n") : "";
      if (invoiceRabbitMqLog) {
        invoiceRabbitMqLog.textContent = `${payload.message || ""}\nMessageId: ${payload.messageId || "-"}\n\n${logs}`.trim();
      }
      if (invoiceRabbitMqPayloadWrap) invoiceRabbitMqPayloadWrap.hidden = false;
      if (invoiceRabbitMqPayload) {
        try {
          invoiceRabbitMqPayload.textContent = JSON.stringify(JSON.parse(payload.payload || "{}"), null, 2);
        } catch {
          invoiceRabbitMqPayload.textContent = payload.payload || "-";
        }
      }
      if (qrError) {
        qrError.textContent = payload.message || (payload.success ? "Invoice RabbitMQ sent." : "Invoice RabbitMQ failed.");
        qrError.classList.toggle("is-success", !!payload.success);
        qrError.classList.toggle("is-error", !payload.success);
        qrError.hidden = false;
      }
      if (integrationLogs.modal && !integrationLogs.modal.hidden) {
        loadIntegrationLogs(true);
      }
    } catch (error) {
      if (invoiceRabbitMqLog) invoiceRabbitMqLog.textContent = error.message || "Invoice RabbitMQ failed.";
      if (qrError) {
        qrError.textContent = error.message || "Invoice RabbitMQ failed.";
        qrError.classList.add("is-error");
        qrError.classList.remove("is-success");
        qrError.hidden = false;
      }
    } finally {
      testInvoiceRabbitMqButton.disabled = false;
      testInvoiceRabbitMqButton.textContent = oldText || "Test invoice RabbitMQ";
    }
  });
  copyInvoiceRabbitMqPayload?.addEventListener("click", async () => {
    const value = invoiceRabbitMqPayload?.textContent || "";
    if (value && value !== "-") await navigator.clipboard.writeText(value);
  });
  integrationLogs.reloadButton?.addEventListener("click", () => loadIntegrationLogs(true));
  integrationLogs.loadMoreButton?.addEventListener("click", () => {
    integrationLogState.page += 1;
    loadIntegrationLogs(false);
  });
  integrationLogs.openButton?.addEventListener("click", () => {
    if (integrationLogs.modal) integrationLogs.modal.hidden = false;
    loadIntegrationLogs(true);
  });
  document.querySelector("#closeInvoiceIntegrationModal")?.addEventListener("click", () => {
    if (integrationLogs.modal) integrationLogs.modal.hidden = true;
  });
  document.querySelector("#closeInvoiceIntegrationModalAction")?.addEventListener("click", () => {
    if (integrationLogs.modal) integrationLogs.modal.hidden = true;
  });
  document.querySelector("#closeInvoiceIntegrationJson")?.addEventListener("click", () => {
    if (integrationLogs.jsonModal) integrationLogs.jsonModal.hidden = true;
  });
  document.querySelector("#closeInvoiceIntegrationJsonAction")?.addEventListener("click", () => {
    if (integrationLogs.jsonModal) integrationLogs.jsonModal.hidden = true;
  });
  integrationLogs.copyJson?.addEventListener("click", async () => {
    const value = integrationLogs.jsonCode?.textContent || "";
    if (value && value !== "-") await navigator.clipboard.writeText(value);
  });
  sampleFields.close?.addEventListener("click", closeSampleModal);
  sampleFields.closeAction?.addEventListener("click", closeSampleModal);
  sampleFields.copyRequest?.addEventListener("click", async () => {
    const value = sampleFields.request?.textContent || "";
    if (value) await navigator.clipboard.writeText(value);
  });
  sampleFields.copyResponse?.addEventListener("click", async () => {
    const value = sampleFields.response?.textContent || "";
    if (value) await navigator.clipboard.writeText(value);
  });
  qrFields.paymentLink?.addEventListener("click", (event) => {
    const href = qrFields.paymentLink.getAttribute("href") || "";
    if (!href || href === "#") return;
    event.preventDefault();
    window.open(href, "ninePayPayment", "width=520,height=720,menubar=no,toolbar=no,location=yes,status=no");
    startPaymentStatusPolling(activePaymentInvoiceId || makeQrButton?.dataset.invoiceId || "");
  });
  qrFields.bankSelect?.addEventListener("change", () => {
    const index = Number(qrFields.bankSelect.value || 0);
    renderSelectedBank(activeNinePayBanks[index]);
  });
  qrFields.copyRemark?.addEventListener("click", async () => {
    const value = activeNinePaySelectedBank?.remark || activeNinePaySelectedBank?.content || activeNinePaySelectedBank?.plaintext || "";
    if (value) await navigator.clipboard.writeText(value);
  });
  qrFields.copyAccountNo?.addEventListener("click", async () => {
    const value = activeNinePaySelectedBank?.bankAccountNo || "";
    if (value) await navigator.clipboard.writeText(value);
  });
  document.querySelectorAll(".view-qr-ipn").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      openIpnModal(button.dataset.qrSessionId || "");
    });
  });
  ipnFields.copyPayload?.addEventListener("click", async () => {
    const value = ipnFields.rawJson?.textContent || "";
    if (value && value !== "-") await navigator.clipboard.writeText(value);
  });
  async function maybeConfirmKvhResumeBeforeInvoiceSubmit(event) {
    if (!updateInvoiceForm || updateInvoiceForm.dataset.kvhResumeChecked === "true") return;
    const selectedInvoiceRow = document.querySelector(".invoice-row.is-selected");
    const oldStatus = (selectedInvoiceRow?.dataset.status || "").toLowerCase();
    const paidByBankTransfer = selectedInvoiceRow?.dataset.paidByBankTransfer === "true";
    const newStatus = (formFields.status?.value || "").toLowerCase();
    if (paidByBankTransfer || oldStatus === "paid" || newStatus !== "paid") {
      if (formFields.resumeKvh) formFields.resumeKvh.value = "false";
      return;
    }

    event.preventDefault();
    if (formFields.resumeKvh) formFields.resumeKvh.value = "false";
    const invoiceId = formFields.id?.value || "";
    try {
      const response = await fetch(`${kvhPaymentResumePrecheckAction}?invoiceId=${encodeURIComponent(invoiceId)}&subscriptionId=@Model.Subscription.Id`, { headers: { "Accept": "application/json" } });
      const data = await response.json();
      if (data.success && data.canResume) {
        const message = [
          "Subscription tren KVH hien dang PAUSED.",
          "",
          `Thiet bi: ${data.deviceName || data.vesselName || "-"}`,
          `KIT: ${data.kitNumber || "-"}`,
          "",
          "Invoice dang duoc chuyen sang trang thai Da thanh toan.",
          "Ban co muon Resume subscription tren KVH khong?"
        ].join("\n");
        if (window.confirm(message) && formFields.resumeKvh) {
          formFields.resumeKvh.value = "true";
        }
      } else if (data.success && data.kvhStatus) {
        window.alert(`Subscription tren KVH dang ${data.kvhStatus}. Khong can Resume.`);
      }
    } catch {
      window.alert("Khong the precheck KVH. Invoice se chi cap nhat thanh toan.");
    }

    updateInvoiceForm.dataset.kvhResumeChecked = "true";
    updateInvoiceForm.requestSubmit();
  }
  updateInvoiceForm?.addEventListener("submit", maybeConfirmKvhResumeBeforeInvoiceSubmit);
  window.addEventListener("message", (event) => {
    if (event.origin !== window.location.origin) return;
    if (event.data?.source !== "ninepay") return;
    startPaymentStatusPolling(activePaymentInvoiceId || makeQrButton?.dataset.invoiceId || "");
  });
  document.querySelector("#closeNinePayQrModal")?.addEventListener("click", closeQrModal);
  document.querySelector("#closeNinePayQrAction")?.addEventListener("click", closeQrModal);
  document.querySelector("#closeNinePayIpnModal")?.addEventListener("click", closeIpnModal);
  document.querySelector("#closeNinePayIpnAction")?.addEventListener("click", closeIpnModal);
  const selectedRow = document.querySelector(".invoice-row.is-selected");
  syncInvoiceEditLock(selectedRow);
  syncMakeQrButton(selectedRow);
  syncQrHistory(selectedRow);
  syncPdfPanel(selectedRow);
})();
</script>
}
