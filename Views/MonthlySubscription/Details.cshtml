        <button type="button" class="btn-secondary" id="copyNinePayIpnPayload">Sao chép payload / Copy payload</button>
        <button type="button" class="btn-primary" id="closeNinePayIpnAction">Hoàn tất / Done</button>
      </div>
    </div>
