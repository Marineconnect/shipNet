  const copyInvoiceRabbitMqPayload = document.querySelector("#copyInvoiceRabbitMqPayload");
  let activePaymentInvoiceId = "";
  let activeNinePayBanks = [];
  let activeNinePaySelectedBank = null;
  let ninePayExpireTimer = null;
  let ninePayExpiresAt = null;
  let paymentPollTimer = null;
  let paymentPollCount = 0;
  function formatUsd(value) {
    const currency = "@defaultCurrency";
    const number = Number(value || 0);
    return currency === "VND"
      ? `${number.toLocaleString("vi-VN", { maximumFractionDigits: 0 })} VND`
      : `${currency} ${number.toLocaleString("en-US", { maximumFractionDigits: 2 })}`;
  }
  function formatMoneyTextbox(value) {
    const currency = "@defaultCurrency";
    const number = Number(value || 0);
    return currency === "VND"
      ? number.toLocaleString("vi-VN", { maximumFractionDigits: 0 })
      : number.toLocaleString("en-US", { maximumFractionDigits: 2 });
  }
  function parseMoneyTextbox(value) {
    const currency = "@defaultCurrency";
    let text = String(value || "").trim();
    if (!text) return 0;
    if (currency === "VND") {
      text = text.replace(/[^\d-]/g, "");
    } else {
      text = text.replace(/,/g, "").replace(/[^\d.-]/g, "");
    }
    const number = Number(text);
    return Number.isFinite(number) ? number : 0;
  }
  function syncMoneyTextbox(input, shouldFormat = false) {
    const hiddenId = input?.dataset?.moneyHidden || "";
    const hidden = hiddenId ? document.getElementById(hiddenId) : null;
    if (!input || !hidden) return;
    const value = parseMoneyTextbox(input.value);
    hidden.value = value.toFixed("@defaultCurrency" === "VND" ? 0 : 2);
    if (shouldFormat) input.value = formatMoneyTextbox(value);
  }
  function setMoneyTextbox(display, hidden, value) {
