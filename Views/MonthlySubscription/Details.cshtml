</div>
}

@section Scripts {
<script>
(() => {
  const modal = document.querySelector("#invoiceModal");
  document.querySelector("#openInvoiceModal")?.addEventListener("click", () => { modal.hidden = false; });
  document.querySelector("#closeInvoiceModal")?.addEventListener("click", () => { modal.hidden = true; });
  document.querySelector("#cancelInvoiceModal")?.addEventListener("click", () => { modal.hidden = true; });
  const fields = {
    type: document.querySelector("#selectedInvoiceType"),
    created: document.querySelector("#selectedInvoiceCreated"),
    amount: document.querySelector("#selectedInvoiceAmount"),
    paid: document.querySelector("#selectedInvoicePaid"),
    refund: document.querySelector("#selectedInvoiceRefund"),
    status: document.querySelector("#selectedInvoiceStatus"),
    number: document.querySelector("#selectedInvoiceNumber"),
    receipt: document.querySelector("#selectedInvoiceReceipt"),
    po: document.querySelector("#selectedInvoicePo"),
    completed: document.querySelector("#selectedInvoiceCompleted")
  };
  const formFields = {
    id: document.querySelector("#UpdateInvoice_InvoiceId"),
    number: document.querySelector("#UpdateInvoice_InvoiceNumber"),
    amount: document.querySelector("#UpdateInvoice_Amount"),
    refund: document.querySelector("#UpdateInvoice_RefundAmount"),
    completed: document.querySelector("#UpdateInvoice_CompletedAt"),
    status: document.querySelector("#UpdateInvoice_Status")
  };
  const updateInvoiceButton = document.querySelector("#updateInvoiceButton");
  const bankTransferPaidNotice = document.querySelector("#bankTransferPaidNotice");
  const makeQrButton = document.querySelector("#makeQrButton");
  const qrHistoryRows = Array.from(document.querySelectorAll(".invoice-qr-session-row"));
  const qrHistoryEmptyRow = document.querySelector(".invoice-qr-empty-row");
  const qrHistoryMeta = document.querySelector("#invoiceQrHistoryMeta");
  const qrHistoryToggle = document.querySelector("#toggleInvoiceQrHistory");
  const qrHistoryBody = document.querySelector("#invoiceQrHistoryBody");
  const qrModal = document.querySelector("#ninePayQrModal");
  const ipnModal = document.querySelector("#ninePayIpnModal");
  const sampleModal = document.querySelector("#ninePaySampleModal");
  const qrError = document.querySelector("#ninePayQrError");
  const ipnFields = {
    subtitle: document.querySelector("#ninePayIpnSubtitle"),
    providerInvoice: document.querySelector("#ninePayIpnProviderInvoice"),
    qrStatus: document.querySelector("#ninePayIpnQrStatus"),
    received: document.querySelector("#ninePayIpnReceived"),
    processStatus: document.querySelector("#ninePayIpnProcessStatus"),
    processMessage: document.querySelector("#ninePayIpnProcessMessage"),
    paymentNo: document.querySelector("#ninePayIpnPaymentNo"),
    providerStatus: document.querySelector("#ninePayIpnProviderStatus"),
    latestTransaction: document.querySelector("#ninePayIpnLatestTransaction"),
    rawJson: document.querySelector("#ninePayIpnRawJson"),
    resultBase64: document.querySelector("#ninePayIpnResultBase64"),
    checksum: document.querySelector("#ninePayIpnChecksum"),
    error: document.querySelector("#ninePayIpnError"),
    copyPayload: document.querySelector("#copyNinePayIpnPayload")
  };
  const sampleFields = {
    request: document.querySelector("#ninePaySampleRequest"),
    response: document.querySelector("#ninePaySampleResponse"),
    close: document.querySelector("#closeNinePaySampleModal"),
    closeAction: document.querySelector("#closeNinePaySampleAction"),
    copyRequest: document.querySelector("#copyNinePaySampleRequest"),
    copyResponse: document.querySelector("#copyNinePaySampleResponse")
  };
  const qrFields = {
    invoice: document.querySelector("#ninePayQrInvoice"),
    bank: document.querySelector("#ninePayBankName"),
    method: document.querySelector("#ninePayMethod"),
    bankSelect: document.querySelector("#ninePayBankSelect"),
    bankSelectField: document.querySelector("#ninePayBankSelectField"),
    loading: document.querySelector("#ninePayLoading"),
    qrFrame: document.querySelector("#ninePayQrFrame"),
    qrImage: document.querySelector("#ninePayQrImage"),
    bankTable: document.querySelector("#ninePayBankTable"),
    bankActions: document.querySelector("#ninePayBankActions"),
    bankDetail: document.querySelector("#ninePayBankDetail"),
    accountNo: document.querySelector("#ninePayAccountNo"),
    accountName: document.querySelector("#ninePayAccountName"),
    bankAmount: document.querySelector("#ninePayBankAmount"),
    remark: document.querySelector("#ninePayRemark"),
    expires: document.querySelector("#ninePayExpires"),
    providerInfo: document.querySelector("#ninePayProviderInfo"),
    copyRemark: document.querySelector("#copyNinePayRemark"),
    copyAccountNo: document.querySelector("#copyNinePayAccountNo"),
    downloadQr: document.querySelector("#downloadNinePayQr"),
    orderTotal: document.querySelector("#ninePayOrderTotal"),
    exchangeRate: document.querySelector("#ninePayExchangeRate"),
    amountVnd: document.querySelector("#ninePayAmountVnd"),
    feeVnd: document.querySelector("#ninePayFeeVnd"),
    totalVnd: document.querySelector("#ninePayTotalVnd"),
    paymentLink: document.querySelector("#openNinePayPayment")
  };
  let activePaymentInvoiceId = "";
  let activeNinePayBanks = [];
  let activeNinePaySelectedBank = null;
  let ninePayExpireTimer = null;
  let ninePayExpiresAt = null;
  let paymentPollTimer = null;
  let paymentPollCount = 0;
  function formatUsd(value) {
    return `$ ${Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: 2 })}`;
  }
  function updateBillingCalculation() {
    const start = document.querySelector("#Billing_StartDate")?.value;
    const end = document.querySelector("#Billing_EndDate")?.value;
    const price = Number(document.querySelector("#Billing_BasePlanPrice")?.value || 0);
    const target = document.querySelector("#billingCalculation");
    if (!target) return;
    if (!start || !end) {
      target.textContent = "Chọn ngày billing để tính lại tiền subscription / Select billing dates to recalculate subscription amount.";
      return;
    }
    const startDate = new Date(start);
    const endDate = new Date(end);
    if (Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime()) || endDate < startDate) {
      target.textContent = "Kỳ billing không hợp lệ / Invalid billing period.";
      return;
    }
    const days = Math.round((endDate - startDate) / 86400000) + 1;
    const amount = price * days / 30;
    target.textContent = `${formatUsd(amount)} = (${formatUsd(price)} / 30 days) x ${days} days`;
  }
  ["#Billing_StartDate", "#Billing_EndDate", "#Billing_BasePlanPrice"].forEach((selector) => {
    document.querySelector(selector)?.addEventListener("input", updateBillingCalculation);
    document.querySelector(selector)?.addEventListener("change", updateBillingCalculation);
  });
  updateBillingCalculation();
  function formatVnd(value) {
    return `${Number(value || 0).toLocaleString("vi-VN")} VND`;
  }
  function closeQrModal() {
    if (qrModal) qrModal.hidden = true;
  }
  function closeIpnModal() {
    if (ipnModal) ipnModal.hidden = true;
  }
  function closeSampleModal() {
    if (sampleModal) sampleModal.hidden = true;
  }
  function setIpnText(field, value) {
    if (field) field.textContent = value || "-";
  }
  function resetIpnModal() {
    Object.values(ipnFields).forEach((field) => {
      if (field && field !== ipnFields.error && field !== ipnFields.copyPayload) field.textContent = "-";
    });
    if (ipnFields.error) ipnFields.error.hidden = true;
  }
  function showIpnDetail(detail) {
    const latestParts = [];
    if (detail.latestTransactionStatus) latestParts.push(detail.latestTransactionStatus);
    if (detail.latestTransactionProviderStatus) latestParts.push(`provider: ${detail.latestTransactionProviderStatus}`);
    if (detail.latestTransactionAtDisplay && detail.latestTransactionAtDisplay !== "-") latestParts.push(detail.latestTransactionAtDisplay);
    if (detail.latestTransactionFailureReason) latestParts.push(detail.latestTransactionFailureReason);
    setIpnText(ipnFields.subtitle, `QR #${detail.qrSessionId || "-"} - ${detail.invoiceNumber || "-"}`);
    setIpnText(ipnFields.providerInvoice, detail.providerInvoiceNo);
    setIpnText(ipnFields.qrStatus, detail.qrStatus);
    setIpnText(ipnFields.received, detail.ipnReceivedAtDisplay);
    setIpnText(ipnFields.processStatus, detail.ipnProcessStatus);
    setIpnText(ipnFields.processMessage, detail.ipnProcessMessage);
    setIpnText(ipnFields.paymentNo, detail.providerPaymentNo);
    setIpnText(ipnFields.providerStatus, detail.providerStatus);
    setIpnText(ipnFields.latestTransaction, latestParts.join(" | "));
    setIpnText(ipnFields.rawJson, detail.ipnRawJson);
    setIpnText(ipnFields.resultBase64, detail.ipnResultBase64);
    setIpnText(ipnFields.checksum, detail.ipnChecksum);
  }
  async function openIpnModal(qrSessionId) {
    if (!qrSessionId) return;
    resetIpnModal();
    if (ipnModal) ipnModal.hidden = false;
    try {
      const response = await fetch(`/Payments/NinePayQrSessionIpn?qrSessionId=${encodeURIComponent(qrSessionId)}`, {
        headers: { "Accept": "application/json" }
      });
      const payload = await response.json();
      if (!response.ok || !payload.success) {
        throw new Error(payload.message || "Không thể tải chi tiết IPN / Cannot load IPN details.");
      }
      showIpnDetail(payload.data || {});
    } catch (error) {
      if (ipnFields.error) {
        ipnFields.error.textContent = error.message || "Không thể tải chi tiết IPN / Cannot load IPN details.";
        ipnFields.error.hidden = false;
      }
    }
  }
  function showNinePaySampleModal(requestText, responseText) {
    if (sampleFields.request) sampleFields.request.textContent = requestText || "-";
    if (sampleFields.response) sampleFields.response.textContent = responseText || "-";
    if (sampleModal) sampleModal.hidden = false;
  }
  function setHostedFallbackVisible(visible) {
    if (qrFields.paymentLink) qrFields.paymentLink.hidden = !visible;
  }
  function setQrLoading(visible) {
    if (qrFields.loading) qrFields.loading.hidden = !visible;
  }
  function resetNinePayPaymentUi() {
    renderBanks([]);
    setExpires(0);
    setQrLoading(true);
    if (qrFields.invoice) qrFields.invoice.textContent = "-";
    if (qrFields.bank) qrFields.bank.textContent = "Đang chuẩn bị QR chuyển khoản / Preparing bank transfer QR...";
    if (qrFields.method) qrFields.method.textContent = "COLLECTION";
    if (qrFields.orderTotal) qrFields.orderTotal.textContent = "-";
    if (qrFields.exchangeRate) qrFields.exchangeRate.textContent = "-";
    if (qrFields.amountVnd) qrFields.amountVnd.textContent = "-";
    if (qrFields.feeVnd) qrFields.feeVnd.textContent = "-";
    if (qrFields.totalVnd) qrFields.totalVnd.textContent = "-";
    if (qrFields.providerInfo) qrFields.providerInfo.hidden = true;
    if (qrError) qrError.hidden = true;
  }
  function renderExpires() {
    if (!qrFields.expires || !ninePayExpiresAt) return;
    const remaining = Math.max(0, Math.floor((ninePayExpiresAt.getTime() - Date.now()) / 1000));
    const hours = Math.floor(remaining / 3600);
    const minutes = Math.floor((remaining % 3600) / 60);
    const seconds = remaining % 60;
    qrFields.expires.textContent = `QR còn hiệu lực / QR valid for ${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
    qrFields.expires.hidden = false;
  }
  function setExpires(expiresInSeconds) {
    if (ninePayExpireTimer) window.clearInterval(ninePayExpireTimer);
    ninePayExpiresAt = expiresInSeconds > 0 ? new Date(Date.now() + (expiresInSeconds * 1000)) : null;
    if (!ninePayExpiresAt) {
      if (qrFields.expires) qrFields.expires.hidden = true;
      return;
    }
    renderExpires();
    ninePayExpireTimer = window.setInterval(renderExpires, 1000);
  }
  function renderSelectedBank(bank) {
    activeNinePaySelectedBank = bank || null;
    const hasBank = !!bank;
    if (qrFields.qrFrame) qrFields.qrFrame.hidden = !hasBank || !bank.qrCodeUrl;
    if (qrFields.qrImage) qrFields.qrImage.src = bank?.qrCodeUrl || "";
    if (qrFields.bankTable) qrFields.bankTable.hidden = !hasBank;
    if (qrFields.bankActions) qrFields.bankActions.hidden = !hasBank;
    if (qrFields.bankDetail) qrFields.bankDetail.textContent = bank?.bankName || "-";
    if (qrFields.accountNo) qrFields.accountNo.textContent = bank?.bankAccountNo || "-";
    if (qrFields.accountName) qrFields.accountName.textContent = bank?.bankAccountName || "-";
    if (qrFields.bankAmount) qrFields.bankAmount.textContent = qrFields.totalVnd?.textContent || "-";
    if (qrFields.remark) qrFields.remark.textContent = bank?.remark || bank?.content || bank?.plaintext || "-";
    if (qrFields.downloadQr) qrFields.downloadQr.href = bank?.qrCodeUrl || "#";
  }
  function renderBanks(banks) {
    activeNinePayBanks = Array.isArray(banks) ? banks : [];
    const hasBanks = activeNinePayBanks.length > 0;
    if (qrFields.bankSelect) {
      qrFields.bankSelect.innerHTML = "";
      activeNinePayBanks.forEach((bank, index) => {
        const option = document.createElement("option");
        option.value = String(index);
        option.textContent = bank.displayName || `${bank.bankCode || ""} - ${bank.bankName || ""}`.trim();
        qrFields.bankSelect.appendChild(option);
      });
      if (qrFields.bankSelectField) qrFields.bankSelectField.hidden = !hasBanks;
    }
    renderSelectedBank(hasBanks ? activeNinePayBanks[0] : null);
    setHostedFallbackVisible(!hasBanks);
  }
  function updateInvoiceRowStatus(invoiceId, status) {
    const row = document.querySelector(`.invoice-row[data-invoice-id="${CSS.escape(String(invoiceId))}"]`);
    if (!row) return;
    row.dataset.status = status;
    const statusBadge = row.querySelector(".subscription-status");
    if (statusBadge) {
      statusBadge.className = `subscription-status ${status}`;
      statusBadge.textContent = status;
    }
    syncMakeQrButton(row);
  }
  function applyPaymentStatus(status) {
    if (!status) return;
    const invoiceId = status.invoiceId || activePaymentInvoiceId;
    if (!invoiceId) return;
    updateInvoiceRowStatus(invoiceId, status.invoiceStatus || "-");
    const row = document.querySelector(`.invoice-row[data-invoice-id="${CSS.escape(String(invoiceId))}"]`);
    if (row) {
      row.dataset.paid = formatUsd(status.paidAmount);
      row.dataset.receiptNumber = status.receiptNumber || status.providerPaymentNo || "-";
      row.dataset.completed = status.completedAtDisplay || "-";
      if (row.classList.contains("is-selected")) {
        if (fields.paid) fields.paid.textContent = row.dataset.paid;
        if (fields.status) fields.status.textContent = status.invoiceStatus || "-";
        if (fields.receipt) fields.receipt.textContent = row.dataset.receiptNumber;
        if (fields.completed) fields.completed.textContent = row.dataset.completed;
        if (formFields.status) formFields.status.value = status.invoiceStatus || "pending";
      }
    }
    if (status.isPaid) {
      stopPaymentStatusPolling();
      if (qrError) {
        qrError.textContent = `Đã xác nhận thanh toán / Payment confirmed: ${status.providerPaymentNo || status.receiptNumber || status.invoiceNumber || ""}`;
        qrError.hidden = false;
        qrError.classList.remove("is-error");
        qrError.classList.add("is-success");
      }
    }
  }
  async function refreshPaymentStatus(invoiceId) {
    const response = await fetch(`/Payments/NinePayInvoiceStatus?invoiceId=${encodeURIComponent(invoiceId)}`, {
      headers: { "Accept": "application/json" }
    });
    const payload = await response.json();
    if (!response.ok || !payload.success) {
      throw new Error(payload.message || "Không thể cập nhật trạng thái invoice / Cannot refresh invoice status.");
    }
    applyPaymentStatus(payload.data);
    return payload.data;
  }
  function stopPaymentStatusPolling() {
    if (paymentPollTimer) {
      window.clearInterval(paymentPollTimer);
      paymentPollTimer = null;
    }
  }
  function startPaymentStatusPolling(invoiceId) {
    if (!invoiceId) return;
    activePaymentInvoiceId = invoiceId;
    paymentPollCount = 0;
    stopPaymentStatusPolling();
    refreshPaymentStatus(invoiceId).catch(() => {});
    paymentPollTimer = window.setInterval(async () => {
      paymentPollCount += 1;
      if (paymentPollCount > 100) {
        stopPaymentStatusPolling();
        return;
      }
      try {
        const status = await refreshPaymentStatus(invoiceId);
        if (status?.isPaid) stopPaymentStatusPolling();
      } catch {
        if (paymentPollCount > 10) stopPaymentStatusPolling();
      }
    }, 3000);
  }
  function syncMakeQrButton(row) {
    if (!makeQrButton || !row) return;
    makeQrButton.dataset.invoiceId = row.dataset.invoiceId || "";
    const status = (row.dataset.status || "").toLowerCase();
    makeQrButton.hidden = status !== "pending";
  }
  function syncInvoiceEditLock(row) {
    const isLocked = row?.dataset.paidByBankTransfer === "true";
    Object.values(formFields).forEach((field) => {
      if (field) field.disabled = isLocked;
    });
    if (updateInvoiceButton) {
      updateInvoiceButton.disabled = isLocked;
      updateInvoiceButton.hidden = isLocked;
    }
    if (bankTransferPaidNotice) bankTransferPaidNotice.hidden = !isLocked;
  }
  function syncQrHistory(row) {
    const invoiceId = row?.dataset.invoiceId || "";
    let visibleCount = 0;
    qrHistoryRows.forEach((item) => {
      const isVisible = item.dataset.invoiceId === invoiceId;
      item.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });
    if (qrHistoryEmptyRow) qrHistoryEmptyRow.hidden = visibleCount > 0;
    if (qrHistoryMeta) {
      const invoiceNumber = row?.dataset.invoiceNumber || "-";
      qrHistoryMeta.textContent = `Danh sách QR đã tạo cho invoice ${invoiceNumber} / QR list created for invoice ${invoiceNumber}.`;
    }
  }
  qrHistoryToggle?.addEventListener("click", () => {
    const willExpand = qrHistoryBody?.hidden === true;
    if (qrHistoryBody) qrHistoryBody.hidden = !willExpand;
    qrHistoryToggle.textContent = willExpand ? "[-]" : "[+]";
    qrHistoryToggle.setAttribute("aria-expanded", String(willExpand));
  });
  function selectInvoice(row) {
    document.querySelectorAll(".invoice-row").forEach((item) => item.classList.toggle("is-selected", item === row));
    const radio = row.querySelector("input[name='selectedInvoice']");
    if (radio) radio.checked = true;
    if (fields.type) fields.type.textContent = row.dataset.type || "-";
    if (fields.created) fields.created.textContent = row.dataset.created || "-";
    if (fields.amount) fields.amount.textContent = row.dataset.amount || "$ 0";
    if (fields.paid) fields.paid.textContent = row.dataset.paid || "$ 0";
    if (fields.refund) fields.refund.textContent = row.dataset.refund || "$ 0";
    if (fields.status) fields.status.textContent = row.dataset.status || "-";
    if (fields.number) fields.number.textContent = row.dataset.invoiceNumber || "-";
    if (fields.receipt) fields.receipt.textContent = row.dataset.receiptNumber || "-";
    if (fields.po) fields.po.textContent = row.dataset.poNumber || "-";
    if (fields.completed) fields.completed.textContent = row.dataset.completed || "-";
    if (formFields.id) formFields.id.value = row.dataset.invoiceId || "";
    if (formFields.number) formFields.number.value = row.dataset.invoiceNumber || "";
    if (formFields.amount) formFields.amount.value = row.dataset.amountRaw || "0";
    if (formFields.refund) formFields.refund.value = row.dataset.refundRaw || "0";
    if (formFields.completed) formFields.completed.value = row.dataset.completedInput || "";
    if (formFields.status) formFields.status.value = row.dataset.status || "pending";
    syncInvoiceEditLock(row);
    syncMakeQrButton(row);
    syncQrHistory(row);
  }
  document.querySelectorAll(".invoice-row").forEach((row) => {
    row.addEventListener("click", (event) => {
      if (event.target.closest("form, select, button, input")) return;
      selectInvoice(row);
    });
    row.querySelector("input[name='selectedInvoice']")?.addEventListener("change", () => {
      selectInvoice(row);
    });
  });
  makeQrButton?.addEventListener("click", async () => {
    const invoiceId = makeQrButton.dataset.invoiceId || "";
    if (!invoiceId) return;
    makeQrButton.disabled = true;
    makeQrButton.textContent = "Đang tạo... / Creating...";
    resetNinePayPaymentUi();
    if (qrModal) qrModal.hidden = false;
    try {
      const requestUrl = `/Payments/NinePayBankTransferInfo?invoiceId=${encodeURIComponent(invoiceId)}`;
      const response = await fetch(requestUrl, {
        headers: { "Accept": "application/json" }
      });
      const responseText = await response.text();
      let payload;
      try {
        payload = JSON.parse(responseText);
      } catch {
        const error = new Error("Phản hồi máy chủ không phải JSON hợp lệ / Server response is not valid JSON.");
        throw error;
      }
      if (!response.ok || !payload.success) {
        const error = new Error(payload.message || "Không thể tạo thanh toán chuyển khoản / Cannot create bank transfer payment.");
        error.debug = payload.debug || "";
        throw error;
      }
      const data = payload.data;
      setQrLoading(false);
      activePaymentInvoiceId = data.invoiceId || invoiceId;
      if (qrFields.invoice) qrFields.invoice.textContent = data.invoiceNumber || "-";
      if (qrFields.bank) {
        qrFields.bank.textContent = data.instructions || "Mở 9Pay để chọn ngân hàng và hoàn tất thanh toán trên ứng dụng ngân hàng / Open 9Pay to choose a bank and complete payment in your banking app.";
      }
      if (qrFields.method) qrFields.method.textContent = data.paymentMethod || "bank_transfer";
      if (qrFields.orderTotal) qrFields.orderTotal.textContent = formatUsd(data.orderTotalUsd);
      if (qrFields.exchangeRate) qrFields.exchangeRate.textContent = `${Number(data.exchangeRateVndPerUsd || 0).toLocaleString("vi-VN")} VND/USD`;
      if (qrFields.amountVnd) qrFields.amountVnd.textContent = formatVnd(data.amountVnd);
      if (qrFields.feeVnd) qrFields.feeVnd.textContent = formatVnd(data.transactionFeeVnd);
      if (qrFields.totalVnd) qrFields.totalVnd.textContent = formatVnd(data.totalToPayVnd);
      if (qrFields.paymentLink) qrFields.paymentLink.href = data.paymentUrl || "#";
      renderBanks(data.banks || []);
      if (!data.banks || data.banks.length === 0) {
        if (qrError) {
          qrError.textContent = "9Pay không trả về ngân hàng / No banks returned from 9Pay response.";
          qrError.hidden = false;
        }
      }
      setExpires(Number(data.expiresInSeconds || 0));
      if (qrFields.providerInfo) {
        const providerParts = [];
        if (data.invoiceNumber) providerParts.push(`Invoice / Invoice: ${data.invoiceNumber}`);
        if (data.providerPaymentId) providerParts.push(`Mã thanh toán / PaymentNo: ${data.providerPaymentId}`);
        if (data.providerOrderRef) providerParts.push(`Mã đơn / OrderRef: ${data.providerOrderRef}`);
        if (data.reusedQr) providerParts.push("Dùng lại QR còn hiệu lực / Reused active QR");
        qrFields.providerInfo.textContent = providerParts.join(" • ");
        qrFields.providerInfo.hidden = providerParts.length === 0;
      }
      if (qrModal) qrModal.hidden = false;
      startPaymentStatusPolling(activePaymentInvoiceId);
    } catch (error) {
      setQrLoading(false);
      if (qrError) {
        qrError.classList.add("is-error");
        qrError.classList.remove("is-success");
        qrError.textContent = error.message || "Không thể tạo thanh toán chuyển khoản / Cannot create bank transfer payment.";
        qrError.hidden = false;
      }
      if (qrModal) qrModal.hidden = false;
    } finally {
      setQrLoading(false);
      makeQrButton.disabled = false;
      makeQrButton.textContent = "Tạo QR / Make QR";
    }
  });
  sampleFields.close?.addEventListener("click", closeSampleModal);
  sampleFields.closeAction?.addEventListener("click", closeSampleModal);
  sampleFields.copyRequest?.addEventListener("click", async () => {
    const value = sampleFields.request?.textContent || "";
    if (value) await navigator.clipboard.writeText(value);
  });
  sampleFields.copyResponse?.addEventListener("click", async () => {
    const value = sampleFields.response?.textContent || "";
    if (value) await navigator.clipboard.writeText(value);
  });
  qrFields.paymentLink?.addEventListener("click", (event) => {
    const href = qrFields.paymentLink.getAttribute("href") || "";
    if (!href || href === "#") return;
    event.preventDefault();
    window.open(href, "ninePayPayment", "width=520,height=720,menubar=no,toolbar=no,location=yes,status=no");
    startPaymentStatusPolling(activePaymentInvoiceId || makeQrButton?.dataset.invoiceId || "");
  });
  qrFields.bankSelect?.addEventListener("change", () => {
    const index = Number(qrFields.bankSelect.value || 0);
    renderSelectedBank(activeNinePayBanks[index]);
  });
  qrFields.copyRemark?.addEventListener("click", async () => {
    const value = activeNinePaySelectedBank?.remark || activeNinePaySelectedBank?.content || activeNinePaySelectedBank?.plaintext || "";
    if (value) await navigator.clipboard.writeText(value);
  });
  qrFields.copyAccountNo?.addEventListener("click", async () => {
    const value = activeNinePaySelectedBank?.bankAccountNo || "";
    if (value) await navigator.clipboard.writeText(value);
  });
  document.querySelectorAll(".view-qr-ipn").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      openIpnModal(button.dataset.qrSessionId || "");
    });
  });
  ipnFields.copyPayload?.addEventListener("click", async () => {
    const value = ipnFields.rawJson?.textContent || "";
    if (value && value !== "-") await navigator.clipboard.writeText(value);
  });
  window.addEventListener("message", (event) => {
    if (event.origin !== window.location.origin) return;
    if (event.data?.source !== "ninepay") return;
    startPaymentStatusPolling(activePaymentInvoiceId || makeQrButton?.dataset.invoiceId || "");
  });
  document.querySelector("#closeNinePayQrModal")?.addEventListener("click", closeQrModal);
  document.querySelector("#closeNinePayQrAction")?.addEventListener("click", closeQrModal);
  document.querySelector("#closeNinePayIpnModal")?.addEventListener("click", closeIpnModal);
  document.querySelector("#closeNinePayIpnAction")?.addEventListener("click", closeIpnModal);
  const selectedRow = document.querySelector(".invoice-row.is-selected");
  syncInvoiceEditLock(selectedRow);
  syncMakeQrButton(selectedRow);
  syncQrHistory(selectedRow);
})();
</script>
}
