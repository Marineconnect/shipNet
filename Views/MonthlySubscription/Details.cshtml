  function updateBillingCalculation() {
    const start = document.querySelector("#Billing_StartDate")?.value;
    const end = document.querySelector("#Billing_EndDate")?.value;
    const price = Number(document.querySelector("#Billing_BasePlanPrice")?.value || 0);
    const target = document.querySelector("#billingCalculation");
    if (!target) return;
    if (!start || !end) {
      target.innerHTML = `<span class="subscription-calculation-label">Tổng subscription / Subscription amount</span><span>Chọn ngày billing để tính lại tiền subscription / Select billing dates to recalculate subscription amount.</span>`;
      return;
    }
    const startDate = parseDateInput(start);
    const endDate = parseDateInput(end);
    if (!startDate || !endDate || Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime()) || endDate < startDate) {
      target.innerHTML = `<span class="subscription-calculation-label">Tổng subscription / Subscription amount</span><span>Kỳ billing không hợp lệ / Invalid billing period.</span>`;
      return;
    }
    const result = calculateSubscriptionAmount(price, startDate, endDate);
    const amount = result.amount;
    const formula = result.isFullPeriod
      ? `${formatUsd(amount)} = Full package / Trọn gói`
      : `${formatUsd(amount)} = (${formatUsd(price)} / 30 days) x ${result.days} days`;
    target.innerHTML = `<span class="subscription-calculation-label">Tổng subscription / Subscription amount</span><strong>${formatUsd(amount)}</strong><span class="subscription-calculation-formula">${formula}</span>`;
    target.title = formula;
  }
  function calculateSubscriptionAmount(price, start, end) {
    const days = Math.round((end - start) / 86400000) + 1;
    const monthEnd = new Date(start.getFullYear(), start.getMonth() + 1, 0);
    const daysInMonth = monthEnd.getDate();
    const isMonthEnd = end.getFullYear() === monthEnd.getFullYear()
      && end.getMonth() === monthEnd.getMonth()
      && end.getDate() === monthEnd.getDate();
    const isFullPeriod = isMonthEnd && (start.getDate() === 1 || (daysInMonth === 31 && start.getDate() === 2));
    return {
      days,
      isFullPeriod,
      amount: isFullPeriod ? price : price * days / 30
    };
  }
