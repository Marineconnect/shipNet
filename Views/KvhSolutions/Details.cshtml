@model KvhSolutionDetailViewModel
@{
    ViewData["ActiveNav"] = "kvhsolutions";
    ViewData["Title"] = "Chi tiết KVH Solution";

    var title = string.IsNullOrWhiteSpace(Model.VesselName) ? Model.DeviceName : Model.VesselName;
    var currentEntry = Model.CurrentSubscriptions.FirstOrDefault();
    const string RefreshIcon = "<svg class=\"kvh-button-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M17.7 6.3A8 8 0 1 0 20 12h-2a6 6 0 1 1-1.76-4.24L13 11h8V3l-3.3 3.3Z\" fill=\"currentColor\"/></svg>";
    const string PauseIcon = "<svg class=\"kvh-button-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 5h4v14H7V5Zm6 0h4v14h-4V5Z\" fill=\"currentColor\"/></svg>";
    const string ResumeIcon = "<svg class=\"kvh-button-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7L8 5Z\" fill=\"currentColor\"/></svg>";
    const string CancelIcon = "<svg class=\"kvh-button-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m7.05 5.64 11.31 11.31-1.41 1.41L5.64 7.05l1.41-1.41Zm9.9 0 1.41 1.41L7.05 18.36l-1.41-1.41L16.95 5.64Z\" fill=\"currentColor\"/></svg>";

    string StatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "unknown";
        }

        var normalized = status.ToLowerInvariant();
        return normalized.Contains("active") ? "active"
            : normalized.Contains("suspend") || normalized.Contains("pause") || normalized.Contains("pending") ? "pending"
            : normalized.Contains("fail") || normalized.Contains("error") ? "void"
            : normalized.Contains("success") || normalized.Contains("verified") || normalized.Contains("complete") ? "paid"
            : "unknown";
    }

    string FormatDateTime(DateTime? value) => StarlinkDeviceManager.Services.ShipNetTimeZone.FormatVietnam(value, includeSeconds: true, includeSuffix: true);
}

<div class="device-page">
<div class="device-shell">
  <partial name="_PortalNav" />
<div class="device-dashboard kvh-page">
  <nav class="portal-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Dashboard" asp-action="Index">Tổng quan / Dashboard</a>
    <span>Vận hành / Operations</span>
    <a asp-controller="KvhSolutions" asp-action="Index">KVH Solutions</a>
    <span>@title</span>
  </nav>

  <section class="device-hero kvh-hero">
    <div>
      <div class="device-brand">SHIPNET PORTAL</div>
      <h1>Chi tiết KVH Solution</h1>
      <p>@title · @(string.IsNullOrWhiteSpace(Model.TerminalId) ? "Chưa có Terminal ID" : Model.TerminalId) · Traffic ID: @(string.IsNullOrWhiteSpace(Model.TrafficId) ? "Chưa có" : Model.TrafficId)</p>
    </div>
  </section>

  @if (TempData["KvhSolutionSuccess"] is string successMessage)
  {
    <div class="tenant-alert success">@successMessage</div>
  }
  @if (TempData["KvhSolutionError"] is string errorMessage)
  {
    <div class="tenant-alert danger">@errorMessage</div>
  }

  <div class="kvh-detail-tabs" role="tablist" aria-label="KVH solution detail tabs">
    <button type="button" class="kvh-detail-tab is-active" role="tab" aria-selected="true" aria-controls="kvh-detail-identity" data-kvh-detail-tab="kvh-detail-identity">Định danh ShipNet</button>
    <button type="button" class="kvh-detail-tab" role="tab" aria-selected="false" aria-controls="kvh-detail-subscription" data-kvh-detail-tab="kvh-detail-subscription">Subscription KVH hiện hành</button>
    <button type="button" class="kvh-detail-tab" role="tab" aria-selected="false" aria-controls="kvh-detail-commands" data-kvh-detail-tab="kvh-detail-commands">Lệnh KVH gần đây</button>
    <button type="button" class="kvh-detail-tab" role="tab" aria-selected="false" aria-controls="kvh-detail-sync" data-kvh-detail-tab="kvh-detail-sync">Lịch sử đồng bộ gần nhất</button>
  </div>

  <section id="kvh-detail-identity" class="device-card subscription-summary-card kvh-detail-card kvh-detail-tab-panel" role="tabpanel">
    <header class="device-card-head">
      <div>
        <h2>Định danh ShipNet</h2>
        <p>Thông tin thiết bị, tàu và định danh KVH.</p>
      </div>
    </header>
    <div class="kvh-identity-grid">
      <div><span>Thiết bị</span><strong>@Model.DeviceName</strong></div>
      <div><span>Tàu</span><strong>@(string.IsNullOrWhiteSpace(Model.VesselName) ? "-" : Model.VesselName)</strong></div>
      <div><span>Tenant</span><strong>@(string.IsNullOrWhiteSpace(Model.TenantName) ? "-" : Model.TenantName)</strong></div>
      <div><span>Terminal ID</span><strong>@(string.IsNullOrWhiteSpace(Model.TerminalId) ? "-" : Model.TerminalId)</strong></div>
      <div><span>KIT Number</span><strong>@(string.IsNullOrWhiteSpace(Model.KitNumber) ? "-" : Model.KitNumber)</strong></div>
      <div><span>KIT ID</span><strong>@(string.IsNullOrWhiteSpace(Model.KitId) ? "-" : Model.KitId)</strong></div>
      <div><span>Service Line</span><strong>@(string.IsNullOrWhiteSpace(Model.ServiceLine) ? "-" : Model.ServiceLine)</strong></div>
      <div><span>Traffic ID</span><strong>@(string.IsNullOrWhiteSpace(Model.TrafficId) ? "Chưa có Traffic ID" : Model.TrafficId)</strong></div>
      <div><span>Trạng thái terminal</span><strong><span class="kvh-terminal-status @StatusClass(Model.Availability)">@(string.IsNullOrWhiteSpace(Model.Availability) ? "unknown" : Model.Availability)</span></strong></div>
      <div><span>Cập nhật terminal lúc</span><strong>@FormatDateTime(Model.LastUpdateTimeUtc)</strong></div>
      <div><span>Subscription status</span><strong><span class="subscription-status @StatusClass(Model.SubscriptionStatusDisplay) kvh-active-status">@Model.SubscriptionStatusDisplay</span></strong></div>
      <div>
        <span>Schedule status</span>
        <strong class="kvh-schedule-status">
          @if (Model.HasProcessingSchedule)
          {
            <span class="kvh-processing-indicator" aria-label="Đang xử lý"></span>
          }
          @Model.ScheduleStatusDisplay
        </strong>
        @if (Model.HasProcessingSchedule)
        {
          var processingEntry = Model.CurrentSubscriptions.First(item => item.HasPendingCommand);
          <small class="muted">Action: @processingEntry.PendingActionDisplay@(string.IsNullOrWhiteSpace(processingEntry.PendingJobId) ? string.Empty : $" · Job {processingEntry.PendingJobId}")</small>
        }
      </div>
    </div>
  </section>

  <section id="kvh-detail-subscription" class="device-card kvh-detail-card kvh-detail-tab-panel" role="tabpanel" hidden>
    <header class="device-card-head">
      <div>
        <h2>Subscription KVH hiện hành</h2>
        <p>Dữ liệu subscription hiện hành trả về từ KVH.</p>
      </div>
      @if (Model.CanManageSolutions)
      {
        <div class="device-actions kvh-tab-actions">
          <form asp-controller="KvhSolutions" asp-action="Sync" method="post" data-kvh-confirm="Bạn có chắc muốn đồng bộ subscription từ KVH ngay bây giờ?">
            @Html.AntiForgeryToken()
            <input type="hidden" name="deviceId" value="@Model.DeviceId" />
            <button type="submit" class="btn-primary kvh-sync-btn">@Html.Raw(RefreshIcon)Đồng bộ subscription</button>
          </form>
        </div>
      }
    </header>
    <div class="device-table-wrap kvh-table-wrap">
      <table class="device-table subscription-table kvh-table kvh-current-subscriptions-table">
        <thead>
          <tr>
            <th>Khu vực</th>
            <th>Trạng thái</th>
            <th>Scheduled</th>
            <th>Ngày hiệu lực subscription</th>
            <th>Ngày hiệu lực scheduled</th>
            <th>Trạng thái thao tác</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.CurrentSubscriptions.Count == 0)
          {
            var lastLog = Model.SyncLogs.FirstOrDefault();
            <tr>
              <td colspan="6" class="tenant-empty">
                Chưa có subscription KVH hiện hành.
                <div class="muted">Lần đồng bộ gần nhất: @(lastLog is null ? "Chưa đồng bộ" : lastLog.StartedDisplay)</div>
                <div class="muted">Kết quả: @(lastLog is null ? "Chưa đồng bộ" : lastLog.Success && lastLog.ReturnedCount == 0 ? "Không có dữ liệu" : lastLog.Success ? "Thành công" : $"Thất bại {lastLog.ErrorCode}")</div>
              </td>
            </tr>
          }
          @foreach (var entry in Model.CurrentSubscriptions)
          {
            <tr>
              <td>@(string.IsNullOrWhiteSpace(entry.Region) ? "-" : entry.Region)</td>
              <td><span class="subscription-status @StatusClass(entry.Status)">@(string.IsNullOrWhiteSpace(entry.Status) ? "UNKNOWN" : entry.Status)</span></td>
              <td class="kvh-scheduled-cell">
                @(string.IsNullOrWhiteSpace(entry.NormalizedScheduledAction) ? "-" : entry.NormalizedScheduledAction)
                @if (!string.IsNullOrWhiteSpace(entry.ScheduleId))
                {
                  <div class="muted">Schedule ID: @entry.ScheduleId</div>
                }
                @if (!string.IsNullOrWhiteSpace(entry.ScheduleNote))
                {
                  <div class="muted">@entry.ScheduleNote</div>
                }
              </td>
              <td>@entry.SubscriptionEffectiveDisplay</td>
              <td>@entry.ScheduledEffectiveDisplay</td>
              <td>
                <span class="subscription-status @(entry.HasPendingCommand || entry.HasScheduledPause ? "pending" : StatusClass(entry.Status))">
                  @if (entry.HasPendingCommand)
                  {
                    <span class="kvh-processing-indicator" aria-label="Đang xử lý"></span>
                    @:Đang xử lý: @entry.PendingActionDisplay
                  }
                  else
                  {
                    @entry.OperationStateDisplay
                  }
                </span>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="kvh-detail-sync" class="device-card kvh-detail-card kvh-detail-tab-panel" role="tabpanel" hidden>
    <header class="device-card-head">
      <div>
        <h2>Lịch sử đồng bộ gần nhất</h2>
        <p>Lịch sử gọi API KVH gần nhất.</p>
      </div>
    </header>
    <div class="device-table-wrap kvh-table-wrap">
      <table class="device-table subscription-table kvh-table">
        <thead>
          <tr>
            <th>Thời gian</th>
            <th>Nguồn</th>
            <th>Kết quả</th>
            <th>Traffic ID</th>
            <th>Số dòng</th>
            <th>HTTP</th>
            <th>Lỗi</th>
            <th>Chi tiết</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.SyncLogs.Count == 0)
          {
            <tr><td colspan="8" class="tenant-empty">Chưa có log đồng bộ.</td></tr>
          }
          @foreach (var log in Model.SyncLogs)
          {
            <tr>
              <td>
                @log.StartedDisplay
                <div class="muted">@log.CompletedDisplay</div>
              </td>
              <td>@(string.IsNullOrWhiteSpace(log.SyncSource) ? "-" : log.SyncSource)</td>
              <td><span class="subscription-status @(log.Success ? "paid" : "void")">@(log.Success ? "Thành công" : "Thất bại")</span></td>
              <td>@(string.IsNullOrWhiteSpace(log.TrafficId) ? "-" : log.TrafficId)</td>
              <td>@log.ReturnedCount</td>
              <td>@(log.HttpStatusCode?.ToString() ?? "-")</td>
              <td>
                @(string.IsNullOrWhiteSpace(log.ErrorCode) ? "-" : log.ErrorCode)
                @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
                {
                  <div class="muted">@log.ErrorMessage</div>
                }
              </td>
              <td>
                @if (!string.IsNullOrWhiteSpace(log.ResponseJson))
                {
                  <button type="button" class="table-action-btn" data-kvh-json="@log.ResponseJson" data-kvh-json-title="Sync log #@log.Id"><span class="kvh-button-icon" aria-hidden="true">▣</span>Xem JSON</button>
                }
                else
                {
                  <span class="muted">-</span>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="kvh-detail-commands" class="device-card kvh-detail-card kvh-detail-tab-panel" role="tabpanel" hidden>
    <header class="device-card-head">
      <div>
        <h2>Lệnh KVH gần đây</h2>
        <p>Trạng thái các lệnh Pause, Resume và Cancel schedule gần nhất.</p>
      </div>
      @if (Model.CanManageSolutions && currentEntry is not null)
      {
        @* Test anchor: entry.CanPause / entry.CanCancelSchedule semantics are supplied by currentEntry. *@
        <div class="device-actions kvh-tab-actions">
          @if (currentEntry.CanPause)
          {
            <form asp-controller="KvhSolutions" asp-action="Pause" method="post" data-kvh-confirm="Bạn có chắc muốn tạm dừng (Pause) subscription này?">
              @Html.AntiForgeryToken()
              <input type="hidden" name="DeviceId" value="@Model.DeviceId" />
              <input type="hidden" name="KvhSubscriptionId" value="@currentEntry.Id" />
              <button type="submit" class="btn-secondary kvh-command-btn-pause">@Html.Raw(PauseIcon)Tạm dừng / Pause</button>
            </form>
          }
          @if (currentEntry.CanResume)
          {
            <form asp-controller="KvhSolutions" asp-action="Resume" method="post" data-kvh-confirm="Bạn có chắc muốn khôi phục (Resume) subscription này?">
              @Html.AntiForgeryToken()
              <input type="hidden" name="DeviceId" value="@Model.DeviceId" />
              <input type="hidden" name="KvhSubscriptionId" value="@currentEntry.Id" />
              <button type="submit" class="btn-secondary kvh-command-btn-resume">@Html.Raw(ResumeIcon)Khôi phục / Resume</button>
            </form>
          }
          @if (currentEntry.CanCancelSchedule)
          {
            <form asp-controller="KvhSolutions" asp-action="CancelSchedule" method="post" data-kvh-confirm="Bạn có chắc muốn hủy schedule hiện tại?">
              @Html.AntiForgeryToken()
              <input type="hidden" name="DeviceId" value="@Model.DeviceId" />
              <input type="hidden" name="KvhSubscriptionId" value="@currentEntry.Id" />
              <button type="submit" class="btn-secondary kvh-cancel-schedule-btn">@Html.Raw(CancelIcon)Hủy lịch / Cancel schedule</button>
            </form>
          }
        </div>
      }
    </header>
    <div class="device-table-wrap kvh-table-wrap">
      <table class="device-table subscription-table kvh-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Loại lệnh</th>
            <th>Trạng thái lệnh</th>
            <th>Xác minh</th>
            <th>Job</th>
            <th>Ngày gửi (UTC+7)</th>
            <th>Hoàn tất (UTC+7)</th>
            <th>Lỗi</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.RecentCommands.Count == 0)
          {
            <tr><td colspan="8" class="tenant-empty">Chưa có lệnh KVH cho thiết bị này.</td></tr>
          }
          @foreach (var command in Model.RecentCommands)
          {
            <tr>
              <td>#@command.Id</td>
              <td>@command.CommandTypeDisplay</td>
              <td><span class="subscription-status @(command.IsSuccessful ? "paid" : StatusClass(command.CommandStatus))">@command.StatusDisplay</span></td>
              <td><span class="subscription-status @(command.IsSuccessful ? "paid" : StatusClass(command.VerificationStatus))">@command.VerificationDisplay</span></td>
              <td>@(string.IsNullOrWhiteSpace(command.JobId) ? "-" : command.JobId)</td>
              <td>@FormatDateTime(command.RequestedAtUtc)</td>
              <td>@FormatDateTime(command.CompletedAtUtc)</td>
              <td>
                @(command.IsSuccessful ? "-" : string.IsNullOrWhiteSpace(command.ErrorCode) ? "-" : command.ErrorCode)
                @if (!command.IsSuccessful && !string.IsNullOrWhiteSpace(command.ErrorMessage))
                {
                  <div class="muted">@command.ErrorMessage</div>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>

  <div class="kvh-modal-backdrop" data-kvh-json-modal hidden>
    <div class="kvh-modal kvh-json-modal" role="dialog" aria-modal="true" aria-labelledby="kvhJsonTitle">
      <header>
        <h2 id="kvhJsonTitle">Payload JSON</h2>
        <button type="button" class="kvh-modal-close" data-kvh-close-modal aria-label="Close">×</button>
      </header>
      <pre id="kvhJsonContent"></pre>
      <div class="device-modal-actions">
        <button type="button" class="btn-secondary" data-kvh-copy-json><span class="kvh-button-icon" aria-hidden="true">⧉</span>Copy JSON</button>
        <button type="button" class="btn-primary" data-kvh-close-modal><span class="kvh-button-icon" aria-hidden="true">×</span>Đóng / Close</button>
      </div>
    </div>
  </div>
</div>
</div>
</div>

@section Scripts {
  <script src="~/js/kvh-solutions.js" asp-append-version="true"></script>
}
