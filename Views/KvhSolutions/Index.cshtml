@model KvhSolutionPageResult
@{
    ViewData["ActiveNav"] = "kvhsolutions";
    ViewData["Title"] = "Giải pháp KVH";

    var previousPage = Math.Max(1, Model.CurrentPage - 1);
    var nextPage = Math.Min(Model.TotalPages <= 0 ? 1 : Model.TotalPages, Model.CurrentPage + 1);
    var historyPreviousPage = Math.Max(1, Model.SyncHistory.CurrentPage - 1);
    var historyNextPage = Math.Min(Model.SyncHistory.TotalPages <= 0 ? 1 : Model.SyncHistory.TotalPages, Model.SyncHistory.CurrentPage + 1);

    string TerminalStatusClass(string? availability)
    {
        var normalized = (availability ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "ONLINE" or "AVAILABLE" => "online",
            "OFFLINE" => "offline",
            "AGED" => "aged",
            _ => "unknown"
        };
    }

    string TerminalStatusLabel(string? availability)
    {
        var normalized = (availability ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "ONLINE" or "AVAILABLE" => "Trực tuyến",
            "OFFLINE" => "Ngoại tuyến",
            "AGED" => "Dữ liệu cũ",
            _ => "Chưa xác định"
        };
    }

    string TerminalStatusTitle(string? availability)
    {
        var normalized = (availability ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "ONLINE" or "AVAILABLE" => "KVH vừa nhận dữ liệu trạng thái từ terminal.",
            "OFFLINE" => "Không có cập nhật trạng thái terminal gần đây.",
            "AGED" => "Dữ liệu terminal đã cũ.",
            _ => "Chưa xác định được trạng thái terminal."
        };
    }

    string SubscriptionStatusClass(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "ACTIVE" => "active",
            "PAUSED" or "SUSPEND" or "SUSPENDED" => "paused",
            "PAUSE_SCHEDULED" => "scheduled",
            "RESUME_PENDING" or "PENDING" => "pending",
            _ => "unknown"
        };
    }

    string SubscriptionStatusLabel(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "ACTIVE" => "Đang hoạt động",
            "PAUSED" or "SUSPEND" or "SUSPENDED" => "Đang tạm dừng",
            "PAUSE_SCHEDULED" => "Đã lên lịch tạm dừng",
            "RESUME_PENDING" or "PENDING" => "Đang chờ xử lý",
            _ => "Chưa xác định"
        };
    }

    string SyncResultClass(string? result)
    {
        var normalized = (result ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "SUCCESS" => "paid",
            "EMPTY" or "MISSING_TRAFFIC" => "debit",
            "SYNCING" => "pending",
            "FAILED" or "SYNC_FAILED" => "void",
            _ => "unknown"
        };
    }

    string SyncResultLabel(string? result)
    {
        var normalized = (result ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "SUCCESS" => "Thành công",
            "EMPTY" => "Không có subscription",
            "SYNCING" => "Đang đồng bộ",
            "FAILED" or "SYNC_FAILED" => "Thất bại",
            "MISSING_TRAFFIC" => "Thiếu Traffic ID",
            "NOT_SYNCED" or "" => "Chưa đồng bộ",
            _ => result ?? "-"
        };
    }

    string BatchStatusClass(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "COMPLETED" => "paid",
            "COMPLETED_WITH_ERRORS" => "debit",
            "FAILED" or "CANCELLED" => "void",
            "CREATED" or "QUEUED" or "RUNNING" or "CANCEL_REQUESTED" => "pending",
            _ => "unknown"
        };
    }

    string BatchStatusLabel(string? status)
    {
        var normalized = (status ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "CREATED" => "Đã tạo",
            "QUEUED" => "Đang chờ",
            "RUNNING" => "Đang chạy",
            "COMPLETED" => "Hoàn tất",
            "COMPLETED_WITH_ERRORS" => "Hoàn tất có lỗi",
            "FAILED" => "Thất bại",
            "CANCEL_REQUESTED" => "Đang hủy",
            "CANCELLED" => "Đã hủy",
            _ => string.IsNullOrWhiteSpace(status) ? "Chưa xác định" : status
        };
    }

    string BatchTypeLabel(string? batchType)
    {
        var normalized = (batchType ?? string.Empty).Trim().ToUpperInvariant();
        return normalized switch
        {
            "SYNC_SELECTED" => "Đồng bộ đã chọn",
            "SYNC_MISSING" => "Đồng bộ dữ liệu thiếu",
            "SYNC_ALL" => "Đồng bộ tất cả",
            "RETRY_FAILED" => "Chạy lại lỗi",
            _ => string.IsNullOrWhiteSpace(batchType) ? "-" : batchType
        };
    }

    string CommandStatusLabel(bool hasPendingCommand) => hasPendingCommand ? "Đang xử lý" : "Sẵn sàng";

    string ScheduledActionLabel(string? action)
    {
        var normalized = (action ?? string.Empty).Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(normalized)) return "-";
        if (normalized.Contains("PAUSE") || normalized.Contains("SUSPEND")) return "Tạm dừng";
        if (normalized.Contains("RESUME")) return "Khôi phục";
        return action ?? "-";
    }
}

<div class="device-page">
<div class="device-shell">
  <partial name="_PortalNav" />
<div class="device-dashboard kvh-page">
  <nav class="portal-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Dashboard" asp-action="Index">Tổng quan</a>
    <span>Vận hành</span>
    <span>Giải pháp KVH</span>
  </nav>

  <section class="device-hero kvh-hero">
    <div>
      <div class="device-brand">VẬN HÀNH KVH</div>
      <h1>Giải pháp KVH</h1>
      <p>Theo dõi trạng thái subscription KVH, Traffic ID, lịch tạm dừng/khôi phục và tiến độ đồng bộ.</p>
    </div>
    @if (Model.CanManageSolutions)
    {
      <div class="device-actions kvh-hero-actions">
        <form asp-controller="KvhSolutions" asp-action="CreateSyncBatch" method="post" title="Chỉ đồng bộ thiết bị chưa từng sync hoặc chưa có bản ghi subscription KVH hiện hành.">
          @Html.AntiForgeryToken()
          <input type="hidden" name="Mode" value="SYNC_MISSING" />
          <button type="submit" class="btn-secondary">Đồng bộ dữ liệu thiếu</button>
        </form>
        <button type="button" class="btn-primary" data-kvh-open-sync-all title="Tạo batch nền để đồng bộ toàn bộ thiết bị KVH có quyền truy cập.">Đồng bộ tất cả</button>
      </div>
    }
  </section>

  @if (TempData["KvhSolutionSuccess"] is string successMessage)
  {
    <div class="tenant-alert success">@successMessage</div>
  }
  @if (TempData["KvhSolutionError"] is string errorMessage)
  {
    <div class="tenant-alert danger">@errorMessage</div>
  }

  <nav class="kvh-tabs" role="tablist" aria-label="Tab KVH Solutions">
    <a id="kvh-tab-devices-link" class="kvh-tab-button @(Model.ActiveTab == "devices" ? "is-active" : string.Empty)" role="tab" aria-controls="kvh-tab-devices" aria-selected="@(Model.ActiveTab == "devices")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="devices" asp-route-page="@Model.CurrentPage" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Filter.Search" asp-route-status="@Model.Filter.Status" asp-route-region="@Model.Filter.Region" asp-route-tenantId="@Model.Filter.TenantId" asp-route-syncState="@Model.Filter.SyncState">Thiết bị KVH</a>
    <a id="kvh-tab-history-link" class="kvh-tab-button @(Model.ActiveTab == "history" ? "is-active" : string.Empty)" role="tab" aria-controls="kvh-tab-history" aria-selected="@(Model.ActiveTab == "history")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="history" asp-route-historyPage="@Model.SyncHistory.CurrentPage" asp-route-historyPageSize="@Model.SyncHistory.PageSize" asp-route-historySearch="@Model.SyncHistory.Filter.Search" asp-route-historyTenantId="@Model.SyncHistory.Filter.TenantId" asp-route-historyResult="@Model.SyncHistory.Filter.Result" asp-route-historySource="@Model.SyncHistory.Filter.SyncSource" asp-route-historyDateFrom="@Model.SyncHistory.Filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-historyDateTo="@Model.SyncHistory.Filter.DateTo?.ToString("yyyy-MM-dd")">Lịch sử đồng bộ</a>
    <a id="kvh-tab-batches-link" class="kvh-tab-button @(Model.ActiveTab == "batches" ? "is-active" : string.Empty)" role="tab" aria-controls="kvh-tab-batches" aria-selected="@(Model.ActiveTab == "batches")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="batches">Batch đồng bộ gần đây</a>
  </nav>

  <div class="kvh-tabs kvh-operation-shortcut">
    <a id="kvh-tab-operations-link" class="kvh-tab-button" asp-controller="KvhSubscriptionOperations" asp-action="Index">Lich su Pause/Resume</a>
  </div>

  <section class="kvh-tab-panel @(Model.ActiveTab == "devices" ? "is-active" : string.Empty)" role="tabpanel" id="kvh-tab-devices" aria-labelledby="kvh-tab-devices-link">
    <div class="device-card kvh-inventory-card">
      <header class="device-card-head kvh-card-head">
        <div>
          <h2>Danh sách subscription KVH</h2>
          <p>Tổng số thiết bị: @Model.TotalItems</p>
        </div>
        <form asp-controller="KvhSolutions" asp-action="Index" method="get" class="device-search kvh-search">
          <input type="hidden" name="tab" value="devices" />
          <input type="hidden" name="status" value="@Model.Filter.Status" />
          <input type="hidden" name="region" value="@Model.Filter.Region" />
          <input type="hidden" name="tenantId" value="@Model.Filter.TenantId" />
          <input type="hidden" name="syncState" value="@Model.Filter.SyncState" />
          <input type="hidden" name="pageSize" value="@Model.PageSize" />
          <label class="device-search-field">
            <input class="device-search-input" type="search" name="search" value="@Model.Filter.Search" placeholder="Terminal, tàu, KIT, Traffic ID" />
            <button type="submit" class="device-search-icon-btn" aria-label="Tìm kiếm">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 3a6.5 6.5 0 0 1 5.18 10.43l4.45 4.45-1.41 1.41-4.45-4.45A6.5 6.5 0 1 1 9.5 3Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z"/></svg>
            </button>
          </label>
        </form>
      </header>

      <form asp-controller="KvhSolutions" asp-action="Index" method="get" class="kvh-filter-bar">
        <input type="hidden" name="tab" value="devices" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <label>
          <span>Trạng thái subscription</span>
          <select name="status" title="Trạng thái dịch vụ KVH, tách biệt với trạng thái online của terminal.">
            <option value="">Tất cả</option>
            <option value="ACTIVE" selected="@(Model.Filter.Status == "ACTIVE")">Đang hoạt động</option>
            <option value="PAUSED" selected="@(Model.Filter.Status == "PAUSED")">Đang tạm dừng</option>
            <option value="SUSPEND" selected="@(Model.Filter.Status == "SUSPEND")">Tạm dừng</option>
            <option value="UNKNOWN" selected="@(Model.Filter.Status == "UNKNOWN")">Chưa xác định</option>
          </select>
        </label>
        <label>
          <span>Khu vực</span>
          <input type="text" name="region" value="@Model.Filter.Region" placeholder="GLOBAL" />
        </label>
        @if (!Model.IsTenantScoped)
        {
          <label>
            <span>Tenant</span>
            <select name="tenantId">
              <option value="">Tất cả tenant</option>
              @foreach (var tenant in Model.Tenants)
              {
                <option value="@tenant.Id" selected="@(Model.Filter.TenantId == tenant.Id)">@tenant.TenantName</option>
              }
            </select>
          </label>
        }
        <label>
          <span>Trạng thái đồng bộ</span>
          <select name="syncState" title="Kết quả đồng bộ subscription gần nhất.">
            <option value="">Tất cả</option>
            <option value="not_synced" selected="@(Model.Filter.SyncState == "not_synced")">Chưa đồng bộ</option>
            <option value="syncing" selected="@(Model.Filter.SyncState == "syncing")">Đang đồng bộ</option>
            <option value="success" selected="@(Model.Filter.SyncState == "success")">Thành công</option>
            <option value="empty" selected="@(Model.Filter.SyncState == "empty")">Không có subscription</option>
            <option value="sync_failed" selected="@(Model.Filter.SyncState == "sync_failed")">Thất bại</option>
            <option value="missing_traffic" selected="@(Model.Filter.SyncState == "missing_traffic")">Thiếu Traffic ID</option>
          </select>
        </label>
        <input type="hidden" name="search" value="@Model.Filter.Search" />
        <div class="kvh-filter-actions">
          <button type="submit" class="btn-primary">Lọc</button>
          <a asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="devices" class="btn-secondary">Đặt lại</a>
        </div>
      </form>

      @if (Model.CanManageSolutions)
      {
        <div class="kvh-bulk-toolbar">
          <label class="kvh-check-control">
            <input type="checkbox" id="kvhSelectAll" />
            <span>Chọn trang</span>
          </label>
          <span class="kvh-selected-count">Đã chọn: <strong id="kvhSelectedCount">0</strong></span>
          <form id="kvhSyncSelectedForm" asp-controller="KvhSolutions" asp-action="CreateSyncBatch" method="post" title="Tạo batch cho các thiết bị đã chọn trên trang hiện tại.">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Mode" value="SYNC_SELECTED" />
            <span id="kvhSelectedInputs"></span>
            <button type="submit" class="btn-primary" id="kvhSyncSelectedButton" disabled>Đồng bộ đã chọn</button>
          </form>
          <form asp-controller="KvhSolutions" asp-action="CreateSyncBatch" method="post" title="Chỉ đồng bộ thiết bị chưa từng sync hoặc chưa có bản ghi subscription KVH hiện hành.">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Mode" value="SYNC_MISSING" />
            <button type="submit" class="btn-secondary">Đồng bộ dữ liệu thiếu</button>
          </form>
          <button type="button" class="btn-secondary" data-kvh-open-sync-all title="Tạo batch nền để đồng bộ toàn bộ thiết bị KVH có quyền truy cập.">Đồng bộ tất cả</button>
        </div>
      }

      <div class="device-table-wrap kvh-table-wrap">
        <table class="device-table subscription-table kvh-table">
          <thead>
            <tr>
              <th></th>
              <th>Thiết bị</th>
              <th>Tàu</th>
              <th>Tenant</th>
              <th>KIT Number</th>
              <th>Traffic ID</th>
              <th>Gói KVH</th>
              <th>Khu vực</th>
              <th title="Trạng thái dịch vụ KVH, tách biệt với trạng thái online của terminal.">Trạng thái subscription</th>
              <th title="Ngay subscription hien hanh bat dau co hieu luc.">Subscription effective</th>
              <th title="Thay doi Pause/Resume da duoc KVH len lich nhung chua co hieu luc.">Da len lich</th>
              <th title="Dung lượng dữ liệu được cấp trong chu kỳ hiện tại.">Dung lượng gói</th>
              <th title="Trạng thái terminal gần nhất do KVH trả về.">Trạng thái terminal</th>
              <th title="Kết quả đồng bộ subscription gần nhất.">Kết quả đồng bộ</th>
              <th title="Trang thai lenh Pause/Resume.">Lenh</th>
              <th>Tác vụ</th>
            </tr>
          </thead>
          <tbody>
            @if (Model.Items.Count == 0)
            {
              <tr><td colspan="16" class="tenant-empty">Không có thiết bị KVH phù hợp với bộ lọc hiện tại.</td></tr>
            }
            @foreach (var item in Model.Items)
            {
              var terminalClass = TerminalStatusClass(item.Availability);
              var terminalLabel = TerminalStatusLabel(item.Availability);
              var subscriptionClass = SubscriptionStatusClass(item.Status);
              var syncStatusClass = SyncResultClass(item.LastSyncStatus);
              <tr>
                <td>
                  @if (Model.CanManageSolutions)
                  {
                    <input type="checkbox" class="kvh-device-checkbox" value="@item.DeviceId" aria-label="Chọn @item.DeviceName" />
                  }
                </td>
                <td>
                  <a asp-controller="KvhSolutions" asp-action="Details" asp-route-deviceId="@item.DeviceId" class="kvh-primary-link">@item.DeviceName</a>
                  <div class="kvh-inline-code">
                    <span>@(string.IsNullOrWhiteSpace(item.TerminalId) ? "-" : item.TerminalId)</span>
                    @if (!string.IsNullOrWhiteSpace(item.TerminalId))
                    {
                      <button type="button" class="kvh-copy-btn" data-copy-value="@item.TerminalId" aria-label="Sao chép terminal ID">Sao chép</button>
                    }
                  </div>
                </td>
                <td>@(string.IsNullOrWhiteSpace(item.VesselName) ? "-" : item.VesselName)</td>
                <td>@(string.IsNullOrWhiteSpace(item.TenantName) ? "-" : item.TenantName)</td>
                <td>@(string.IsNullOrWhiteSpace(item.KitNumber) ? "-" : item.KitNumber)</td>
                <td>
                  @if (item.MissingTrafficId)
                  {
                    <span class="subscription-status debit">Thiếu Traffic ID</span>
                  }
                  else
                  {
                    <span>@item.TrafficId</span>
                    <button type="button" class="kvh-copy-btn" data-copy-value="@item.TrafficId" aria-label="Sao chép Traffic ID">Sao chép</button>
                  }
                </td>
                <td>@(string.IsNullOrWhiteSpace(item.PlanName) ? "-" : item.PlanName)</td>
                <td>@(string.IsNullOrWhiteSpace(item.Region) ? "-" : item.Region)</td>
                <td><span class="subscription-status @subscriptionClass" title="Trạng thái gốc từ KVH: @(string.IsNullOrWhiteSpace(item.Status) ? "UNKNOWN" : item.Status)">@SubscriptionStatusLabel(item.Status)</span></td>
                <td>@item.SubscriptionEffectiveDisplay</td>
                <td>
                  <span title="Thay đổi dịch vụ đã được lên lịch trên KVH.">@ScheduledActionLabel(item.NormalizedScheduledAction)</span>
                  @if (item.ScheduledEffectiveDateUtc.HasValue)
                  {
                    <div class="muted">Hiệu lực: @item.ScheduledEffectiveDisplay</div>
                  }
                  @if (!string.IsNullOrWhiteSpace(item.ScheduleId))
                  {
                    <div class="muted">Schedule ID: @item.ScheduleId</div>
                  }
                  @if (!string.IsNullOrWhiteSpace(item.ScheduleNote))
                  {
                    <div class="muted">@item.ScheduleNote</div>
                  }
                </td>
                <td title="Dung lượng dữ liệu trong chu kỳ subscription hiện tại.">@item.AllowanceDisplay</td>
                <td>
                  <span class="kvh-terminal-status @terminalClass" title="@TerminalStatusTitle(item.Availability)">
                    <span class="kvh-status-dot" aria-hidden="true"></span>
                    <span>@terminalLabel</span>
                  </span>
                  <div class="muted">@item.LastUpdateDisplay</div>
                </td>
                <td>
                  <span class="subscription-status @syncStatusClass">@SyncResultLabel(item.LastSyncStatus)</span>
                  @if (!string.IsNullOrWhiteSpace(item.LastSyncErrorCode))
                  {
                    <div class="muted">@item.LastSyncErrorCode</div>
                  }
                  <div class="muted">@item.LastSyncDisplay</div>
                </td>
                <td>
                  <span class="subscription-status @(item.HasPendingCommand ? "pending" : "paid")" title="Trạng thái lệnh KVH.">@CommandStatusLabel(item.HasPendingCommand)</span>
                </td>
                <td>
                  <details class="kvh-action-menu">
                    <summary aria-label="Mở tác vụ">...</summary>
                    <div class="kvh-action-panel" role="menu">
                      <a role="menuitem" asp-controller="KvhSolutions" asp-action="Details" asp-route-deviceId="@item.DeviceId">Chi tiết</a>
                      @if (Model.CanManageSolutions)
                      {
                        <form asp-controller="KvhSolutions" asp-action="Sync" method="post" role="none">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="deviceId" value="@item.DeviceId" />
                          <button type="submit" role="menuitem">Đồng bộ</button>
                        </form>
                        @if (item.KvhSubscriptionId.HasValue && item.CanPause)
                        {
                          <form asp-controller="KvhSolutions" asp-action="Pause" method="post" role="none">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="DeviceId" value="@item.DeviceId" />
                            <input type="hidden" name="KvhSubscriptionId" value="@item.KvhSubscriptionId" />
                            <button type="submit" role="menuitem">Tạm dừng</button>
                          </form>
                        }
                        @if (item.KvhSubscriptionId.HasValue && item.CanResume)
                        {
                          <form asp-controller="KvhSolutions" asp-action="Resume" method="post" role="none">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="DeviceId" value="@item.DeviceId" />
                            <input type="hidden" name="KvhSubscriptionId" value="@item.KvhSubscriptionId" />
                            <button type="submit" role="menuitem">Khôi phục</button>
                          </form>
                        }
                        @if (item.KvhSubscriptionId.HasValue && item.CanCancelSchedule)
                        {
                          <form asp-controller="KvhSolutions" asp-action="CancelSchedule" method="post" role="none">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="DeviceId" value="@item.DeviceId" />
                            <input type="hidden" name="KvhSubscriptionId" value="@item.KvhSubscriptionId" />
                            <button type="submit" role="menuitem">Huy lich Pause</button>
                          </form>
                        }
                      }
                    </div>
                  </details>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>

      <footer class="device-pagination">
        <div class="device-pagination-meta">
          <span>Số dòng</span>
          <form asp-controller="KvhSolutions" asp-action="Index" method="get" class="kvh-page-size-form">
            <input type="hidden" name="tab" value="devices" />
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="search" value="@Model.Filter.Search" />
            <input type="hidden" name="status" value="@Model.Filter.Status" />
            <input type="hidden" name="region" value="@Model.Filter.Region" />
            <input type="hidden" name="tenantId" value="@Model.Filter.TenantId" />
            <input type="hidden" name="syncState" value="@Model.Filter.SyncState" />
            <select class="page-size-select" name="pageSize" onchange="this.form.submit()">
              <option value="20" selected="@(Model.PageSize == 20)">20</option>
              <option value="50" selected="@(Model.PageSize == 50)">50</option>
              <option value="100" selected="@(Model.PageSize == 100)">100</option>
              <option value="140" selected="@(Model.PageSize == 140)">140</option>
            </select>
          </form>
          <span>Hiển thị @Model.StartItem-@Model.EndItem trên @Model.TotalItems</span>
          <span>Trang @Model.CurrentPage / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
        </div>
        <div class="device-pagination-actions">
          <a class="pagination-btn @(Model.HasPreviousPage ? string.Empty : "is-disabled")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="devices" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Filter.Search" asp-route-status="@Model.Filter.Status" asp-route-region="@Model.Filter.Region" asp-route-tenantId="@Model.Filter.TenantId" asp-route-syncState="@Model.Filter.SyncState">Đầu</a>
          <a class="pagination-btn @(Model.HasPreviousPage ? string.Empty : "is-disabled")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="devices" asp-route-page="@previousPage" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Filter.Search" asp-route-status="@Model.Filter.Status" asp-route-region="@Model.Filter.Region" asp-route-tenantId="@Model.Filter.TenantId" asp-route-syncState="@Model.Filter.SyncState">Trước</a>
          <span class="pagination-btn is-active" aria-current="page">@Model.CurrentPage</span>
          <a class="pagination-btn @(Model.HasNextPage ? string.Empty : "is-disabled")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="devices" asp-route-page="@nextPage" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Filter.Search" asp-route-status="@Model.Filter.Status" asp-route-region="@Model.Filter.Region" asp-route-tenantId="@Model.Filter.TenantId" asp-route-syncState="@Model.Filter.SyncState">Sau</a>
          <a class="pagination-btn @(Model.HasNextPage ? string.Empty : "is-disabled")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="devices" asp-route-page="@(Model.TotalPages == 0 ? 1 : Model.TotalPages)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Filter.Search" asp-route-status="@Model.Filter.Status" asp-route-region="@Model.Filter.Region" asp-route-tenantId="@Model.Filter.TenantId" asp-route-syncState="@Model.Filter.SyncState">Cuối</a>
        </div>
      </footer>
    </div>
  </section>

  <section class="kvh-tab-panel @(Model.ActiveTab == "history" ? "is-active" : string.Empty)" role="tabpanel" id="kvh-tab-history" aria-labelledby="kvh-tab-history-link">
    <div class="device-card kvh-history-card">
      <header class="device-card-head kvh-card-head">
        <div>
          <h2>Lịch sử đồng bộ</h2>
          <p>Danh sách log từ TblKvhSubscriptionSyncLog.</p>
        </div>
      </header>
      <form asp-controller="KvhSolutions" asp-action="Index" method="get" class="kvh-filter-bar kvh-history-filter">
        <input type="hidden" name="tab" value="history" />
        <input type="hidden" name="historyPageSize" value="@Model.SyncHistory.PageSize" />
        <label>
          <span>Thiết bị</span>
          <input type="search" name="historySearch" value="@Model.SyncHistory.Filter.Search" placeholder="Terminal, tàu, KIT, Traffic ID" />
        </label>
        @if (!Model.IsTenantScoped)
        {
          <label>
            <span>Tenant</span>
            <select name="historyTenantId">
              <option value="">Tất cả tenant</option>
              @foreach (var tenant in Model.Tenants)
              {
                <option value="@tenant.Id" selected="@(Model.SyncHistory.Filter.TenantId == tenant.Id)">@tenant.TenantName</option>
              }
            </select>
          </label>
        }
        <label>
          <span>Kết quả</span>
          <select name="historyResult">
            <option value="">Tất cả</option>
            <option value="success" selected="@(Model.SyncHistory.Filter.Result == "success")">Thành công</option>
            <option value="empty" selected="@(Model.SyncHistory.Filter.Result == "empty")">Không có subscription</option>
            <option value="failed" selected="@(Model.SyncHistory.Filter.Result == "failed")">Thất bại</option>
          </select>
        </label>
        <label>
          <span>Nguồn đồng bộ</span>
          <input type="text" name="historySource" value="@Model.SyncHistory.Filter.SyncSource" placeholder="PORTAL / BULK / WORKER / API" />
        </label>
        <label>
          <span>Từ ngày</span>
          <input type="date" name="historyDateFrom" value="@Model.SyncHistory.Filter.DateFrom?.ToString("yyyy-MM-dd")" />
        </label>
        <label>
          <span>Đến ngày</span>
          <input type="date" name="historyDateTo" value="@Model.SyncHistory.Filter.DateTo?.ToString("yyyy-MM-dd")" />
        </label>
        <div class="kvh-filter-actions">
          <button type="submit" class="btn-primary">Lọc</button>
          <a asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="history" class="btn-secondary">Đặt lại</a>
        </div>
      </form>
      <div class="device-table-wrap kvh-table-wrap">
        <table class="device-table subscription-table kvh-table kvh-history-table">
          <thead>
            <tr>
              <th>Bắt đầu</th>
              <th>Hoàn tất</th>
              <th>Thiết bị</th>
              <th>Tàu</th>
              <th>Terminal ID</th>
              <th>Traffic ID</th>
              <th>Nguồn đồng bộ</th>
              <th title="Kết quả đồng bộ: thành công, không có dữ liệu, hoặc thất bại.">Kết quả</th>
              <th>HTTP</th>
              <th>Số bản ghi trả về</th>
              <th>Mã lỗi</th>
              <th>Nội dung lỗi</th>
              <th>Response gốc</th>
            </tr>
          </thead>
          <tbody>
            @if (Model.SyncHistory.Items.Count == 0)
            {
              <tr><td colspan="13" class="tenant-empty">Chưa có lịch sử đồng bộ phù hợp.</td></tr>
            }
            @foreach (var log in Model.SyncHistory.Items)
            {
              <tr>
                <td>@log.StartedDisplay</td>
                <td>@log.CompletedDisplay</td>
                <td><a class="kvh-primary-link" asp-controller="KvhSolutions" asp-action="Details" asp-route-deviceId="@log.DeviceId">@log.DeviceName</a></td>
                <td>@(string.IsNullOrWhiteSpace(log.VesselName) ? "-" : log.VesselName)</td>
                <td>@(string.IsNullOrWhiteSpace(log.TerminalId) ? "-" : log.TerminalId)</td>
                <td>@(string.IsNullOrWhiteSpace(log.TrafficId) ? "-" : log.TrafficId)</td>
                <td>@(string.IsNullOrWhiteSpace(log.SyncSource) ? "-" : log.SyncSource)</td>
                <td><span class="subscription-status @SyncResultClass(log.ResultKey)">@SyncResultLabel(log.ResultKey)</span></td>
                <td>@(log.HttpStatusCode?.ToString() ?? "-")</td>
                <td>@log.ReturnedCount</td>
                <td>@(string.IsNullOrWhiteSpace(log.ErrorCode) ? "-" : log.ErrorCode)</td>
                <td class="kvh-wrap-cell">@(string.IsNullOrWhiteSpace(log.ErrorMessage) ? "-" : log.ErrorMessage)</td>
                <td>
                  @if (!string.IsNullOrWhiteSpace(log.ResponseJson))
                  {
                    <button type="button" class="table-action-btn" data-kvh-json="@log.ResponseJson" data-kvh-json-title="Log đồng bộ #@log.Id">Xem JSON</button>
                  }
                  else
                  {
                    <span>-</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      <footer class="device-pagination">
        <div class="device-pagination-meta">
          <span>Số dòng</span>
          <form asp-controller="KvhSolutions" asp-action="Index" method="get" class="kvh-page-size-form">
            <input type="hidden" name="tab" value="history" />
            <input type="hidden" name="historyPage" value="1" />
            <input type="hidden" name="historySearch" value="@Model.SyncHistory.Filter.Search" />
            <input type="hidden" name="historyTenantId" value="@Model.SyncHistory.Filter.TenantId" />
            <input type="hidden" name="historyResult" value="@Model.SyncHistory.Filter.Result" />
            <input type="hidden" name="historySource" value="@Model.SyncHistory.Filter.SyncSource" />
            <input type="hidden" name="historyDateFrom" value="@Model.SyncHistory.Filter.DateFrom?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="historyDateTo" value="@Model.SyncHistory.Filter.DateTo?.ToString("yyyy-MM-dd")" />
            <select class="page-size-select" name="historyPageSize" onchange="this.form.submit()">
              <option value="20" selected="@(Model.SyncHistory.PageSize == 20)">20</option>
              <option value="50" selected="@(Model.SyncHistory.PageSize == 50)">50</option>
              <option value="100" selected="@(Model.SyncHistory.PageSize == 100)">100</option>
            </select>
          </form>
          <span>Hiển thị @Model.SyncHistory.StartItem-@Model.SyncHistory.EndItem trên @Model.SyncHistory.TotalItems</span>
          <span>Trang @Model.SyncHistory.CurrentPage / @(Model.SyncHistory.TotalPages == 0 ? 1 : Model.SyncHistory.TotalPages)</span>
        </div>
        <div class="device-pagination-actions">
          <a class="pagination-btn @(Model.SyncHistory.HasPreviousPage ? string.Empty : "is-disabled")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="history" asp-route-historyPage="1" asp-route-historyPageSize="@Model.SyncHistory.PageSize" asp-route-historySearch="@Model.SyncHistory.Filter.Search" asp-route-historyTenantId="@Model.SyncHistory.Filter.TenantId" asp-route-historyResult="@Model.SyncHistory.Filter.Result" asp-route-historySource="@Model.SyncHistory.Filter.SyncSource" asp-route-historyDateFrom="@Model.SyncHistory.Filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-historyDateTo="@Model.SyncHistory.Filter.DateTo?.ToString("yyyy-MM-dd")">Đầu</a>
          <a class="pagination-btn @(Model.SyncHistory.HasPreviousPage ? string.Empty : "is-disabled")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="history" asp-route-historyPage="@historyPreviousPage" asp-route-historyPageSize="@Model.SyncHistory.PageSize" asp-route-historySearch="@Model.SyncHistory.Filter.Search" asp-route-historyTenantId="@Model.SyncHistory.Filter.TenantId" asp-route-historyResult="@Model.SyncHistory.Filter.Result" asp-route-historySource="@Model.SyncHistory.Filter.SyncSource" asp-route-historyDateFrom="@Model.SyncHistory.Filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-historyDateTo="@Model.SyncHistory.Filter.DateTo?.ToString("yyyy-MM-dd")">Trước</a>
          <span class="pagination-btn is-active" aria-current="page">@Model.SyncHistory.CurrentPage</span>
          <a class="pagination-btn @(Model.SyncHistory.HasNextPage ? string.Empty : "is-disabled")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="history" asp-route-historyPage="@historyNextPage" asp-route-historyPageSize="@Model.SyncHistory.PageSize" asp-route-historySearch="@Model.SyncHistory.Filter.Search" asp-route-historyTenantId="@Model.SyncHistory.Filter.TenantId" asp-route-historyResult="@Model.SyncHistory.Filter.Result" asp-route-historySource="@Model.SyncHistory.Filter.SyncSource" asp-route-historyDateFrom="@Model.SyncHistory.Filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-historyDateTo="@Model.SyncHistory.Filter.DateTo?.ToString("yyyy-MM-dd")">Sau</a>
          <a class="pagination-btn @(Model.SyncHistory.HasNextPage ? string.Empty : "is-disabled")" asp-controller="KvhSolutions" asp-action="Index" asp-route-tab="history" asp-route-historyPage="@(Model.SyncHistory.TotalPages == 0 ? 1 : Model.SyncHistory.TotalPages)" asp-route-historyPageSize="@Model.SyncHistory.PageSize" asp-route-historySearch="@Model.SyncHistory.Filter.Search" asp-route-historyTenantId="@Model.SyncHistory.Filter.TenantId" asp-route-historyResult="@Model.SyncHistory.Filter.Result" asp-route-historySource="@Model.SyncHistory.Filter.SyncSource" asp-route-historyDateFrom="@Model.SyncHistory.Filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-historyDateTo="@Model.SyncHistory.Filter.DateTo?.ToString("yyyy-MM-dd")">Cuối</a>
        </div>
      </footer>
    </div>
  </section>

  <section class="kvh-tab-panel @(Model.ActiveTab == "batches" ? "is-active" : string.Empty)" role="tabpanel" id="kvh-tab-batches" aria-labelledby="kvh-tab-batches-link">
    <div class="device-card kvh-batches-card">
      <header class="device-card-head">
        <div>
          <h2>Batch đồng bộ gần đây</h2>
          <p>Tiến độ đồng bộ subscription KVH chạy nền.</p>
        </div>
      </header>
      <div class="device-table-wrap kvh-table-wrap">
        <table class="device-table subscription-table kvh-table">
          <thead>
            <tr>
              <th>Mã batch</th>
              <th>Loại batch</th>
              <th>Trạng thái</th>
              <th>Tổng</th>
              <th>Chờ xử lý</th>
              <th>Đang xử lý</th>
              <th>Thành công</th>
              <th>Không có dữ liệu</th>
              <th>Thất bại</th>
              <th>Bỏ qua</th>
              <th>Tiến độ</th>
              <th>Ngày tạo</th>
              <th>Bắt đầu</th>
              <th>Hoàn tất</th>
              <th>Tác vụ</th>
            </tr>
          </thead>
          <tbody>
            @if (Model.RecentBatches.Count == 0)
            {
              <tr><td colspan="16" class="tenant-empty">Chưa có batch đồng bộ KVH.</td></tr>
            }
            @foreach (var batch in Model.RecentBatches)
            {
              var batchStatusClass = BatchStatusClass(batch.Status);
              <tr class="kvh-batch-row" data-batch-id="@batch.Id" data-kvh-running="@batch.IsRunning.ToString().ToLowerInvariant()">
                <td>#@batch.Id</td>
                <td title="@batch.BatchType">@BatchTypeLabel(batch.BatchType)</td>
                <td><span class="subscription-status kvh-batch-status @batchStatusClass" title="@batch.Status">@BatchStatusLabel(batch.Status)</span></td>
                <td>@batch.TotalItems</td>
                <td>@batch.PendingItems</td>
                <td>@batch.ProcessingItems</td>
                <td class="kvh-batch-success">@batch.SuccessItems</td>
                <td class="kvh-batch-empty">@batch.EmptyItems</td>
                <td class="kvh-batch-failed">@batch.FailedItems</td>
                <td>@batch.SkippedItems</td>
                <td>
                  <div class="progress-shell"><span class="kvh-batch-progress" style="width:@batch.ProgressPercent%"></span></div>
                  <div class="muted kvh-batch-progress-text">@batch.ProcessedItems / @batch.TotalItems</div>
                </td>
                <td>@batch.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@batch.StartedAtUtc?.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="kvh-batch-completed">@batch.CompletedAtUtc?.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                  <div class="kvh-row-actions">
                    @if (Model.CanManageSolutions && batch.IsRunning)
                    {
                      <form asp-controller="KvhSolutions" asp-action="CancelSyncBatch" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@batch.Id" />
                        <button type="submit" class="table-action-btn">Hủy</button>
                      </form>
                    }
                    @if (Model.CanManageSolutions && batch.FailedItems > 0)
                    {
                      <form asp-controller="KvhSolutions" asp-action="RetryFailedBatch" method="post" title="Tạo batch mới chỉ gồm các thiết bị thất bại trong batch này. Thiết bị thành công hoặc không có dữ liệu sẽ không chạy lại.">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@batch.Id" />
                        <button type="submit" class="table-action-btn">Chạy lại lỗi #@batch.Id</button>
                      </form>
                    }
                  </div>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <div class="kvh-modal-backdrop" data-kvh-sync-all-modal hidden>
    <div class="kvh-modal" role="dialog" aria-modal="true" aria-labelledby="kvhSyncAllTitle">
      <header>
        <h2 id="kvhSyncAllTitle">Xác nhận đồng bộ tất cả</h2>
        <button type="button" class="kvh-modal-close" data-kvh-close-modal aria-label="Đóng">x</button>
      </header>
      <p>Hệ thống sẽ tạo batch chạy nền để đồng bộ toàn bộ thiết bị KVH có quyền truy cập. Quá trình này có thể mất vài phút.</p>
      <div class="device-modal-actions">
        <button type="button" class="btn-secondary" data-kvh-close-modal>Hủy</button>
        <form asp-controller="KvhSolutions" asp-action="CreateSyncBatch" method="post">
          @Html.AntiForgeryToken()
          <input type="hidden" name="Mode" value="SYNC_ALL" />
          <button type="submit" class="btn-primary">Đồng ý đồng bộ</button>
        </form>
      </div>
    </div>
  </div>

  <div class="kvh-modal-backdrop" data-kvh-json-modal hidden>
    <div class="kvh-modal kvh-json-modal" role="dialog" aria-modal="true" aria-labelledby="kvhJsonTitle">
      <header>
        <h2 id="kvhJsonTitle">Response gốc</h2>
        <button type="button" class="kvh-modal-close" data-kvh-close-modal aria-label="Đóng">x</button>
      </header>
      <pre id="kvhJsonContent" class="kvh-json-content"></pre>
      <div class="device-modal-actions">
        <button type="button" class="btn-secondary" data-kvh-copy-json>Sao chép JSON</button>
        <button type="button" class="btn-primary" data-kvh-close-modal>Đóng</button>
      </div>
    </div>
  </div>
</div>
</div>
</div>

@section Scripts {
  <script src="~/js/kvh-solutions.js" asp-append-version="true"></script>
}
