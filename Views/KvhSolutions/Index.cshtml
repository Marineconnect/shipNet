@model KvhSolutionPageResult
@{
    ViewData["ActiveNav"] = "kvhsolutions";
    ViewData["Title"] = "KVH Solutions";
}

<div class="device-dashboard">
  <nav class="portal-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    <span>KVH Solutions</span>
  </nav>
  <section class="device-hero">
    <div>
      <div class="device-brand">KVH Operations</div>
      <h1>KVH Solutions</h1>
      <p>Operational KVH subscription state, traffic IDs, scheduled actions, and command status.</p>
    </div>
  </section>

  @if (TempData["KvhSolutionSuccess"] is string successMessage)
  {
    <div class="tenant-alert success">@successMessage</div>
  }
  @if (TempData["KvhSolutionError"] is string errorMessage)
  {
    <div class="tenant-alert danger">@errorMessage</div>
  }

  <section class="subscription-filter-panel">
    <form asp-controller="KvhSolutions" asp-action="Index" method="get" class="subscription-filter-grid">
      <label>
        <span>Search</span>
        <input type="search" name="search" value="@Model.Filter.Search" placeholder="Terminal, vessel, KIT, traffic ID" />
      </label>
      <label>
        <span>Status</span>
        <input type="text" name="status" value="@Model.Filter.Status" placeholder="ACTIVE, SUSPEND" />
      </label>
      <label>
        <span>Region</span>
        <input type="text" name="region" value="@Model.Filter.Region" />
      </label>
      @if (!Model.IsTenantScoped)
      {
        <label>
          <span>Tenant</span>
          <select name="tenantId">
            <option value="">All tenants</option>
            @foreach (var tenant in Model.Tenants)
            {
              <option value="@tenant.Id" selected="@(Model.Filter.TenantId == tenant.Id)">@tenant.TenantName</option>
            }
          </select>
        </label>
      }
      <label>
        <span>Sync state</span>
        <select name="syncState">
          <option value="">All</option>
          <option value="missing_traffic" selected="@(Model.Filter.SyncState == "missing_traffic")">Missing traffic ID</option>
          <option value="sync_failed" selected="@(Model.Filter.SyncState == "sync_failed")">Sync failed</option>
        </select>
      </label>
      <div class="subscription-filter-actions">
        <button type="submit" class="btn-primary">Filter</button>
        <a asp-controller="KvhSolutions" asp-action="Index" class="btn-secondary">Reset</a>
      </div>
    </form>
  </section>

  @if (Model.CanManageSolutions)
  {
    <section class="subscription-filter-panel">
      <div class="device-actions">
        <label class="table-action-btn">
          <input type="checkbox" id="kvhSelectAll" />
          Select page
        </label>
        <form id="kvhSyncSelectedForm" asp-controller="KvhSolutions" asp-action="CreateSyncBatch" method="post">
          @Html.AntiForgeryToken()
          <input type="hidden" name="Mode" value="SYNC_SELECTED" />
          <span id="kvhSelectedInputs"></span>
          <button type="submit" class="btn-primary" id="kvhSyncSelectedButton" disabled>Sync selected</button>
        </form>
        <form asp-controller="KvhSolutions" asp-action="CreateSyncBatch" method="post">
          @Html.AntiForgeryToken()
          <input type="hidden" name="Mode" value="SYNC_MISSING" />
          <button type="submit" class="btn-secondary">Sync missing</button>
        </form>
        <form asp-controller="KvhSolutions" asp-action="CreateSyncBatch" method="post" onsubmit="return confirm('You are about to create a background sync batch for available devices. This may take several minutes.');">
          @Html.AntiForgeryToken()
          <input type="hidden" name="Mode" value="SYNC_ALL" />
          <button type="submit" class="btn-secondary">Sync all</button>
        </form>
      </div>
    </section>
  }

  <section class="device-card">
    <header class="card-header">
      <div>
        <h2>Recent Sync Batches</h2>
        <p>Background KVH subscription synchronization progress.</p>
      </div>
    </header>
    <div class="device-table-wrap">
      <table class="device-table subscription-table">
        <thead>
          <tr>
            <th>Batch ID</th>
            <th>Mode</th>
            <th>Status</th>
            <th>Total</th>
            <th>Pending</th>
            <th>Success</th>
            <th>Empty</th>
            <th>Failed</th>
            <th>Started</th>
            <th>Completed</th>
            <th>Progress</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.RecentBatches.Count == 0)
          {
            <tr><td colspan="12" class="tenant-empty">No KVH sync batches yet.</td></tr>
          }
          @foreach (var batch in Model.RecentBatches)
          {
            <tr class="kvh-batch-row" data-batch-id="@batch.Id" data-running="@batch.IsRunning.ToString().ToLowerInvariant()">
              <td>#@batch.Id</td>
              <td>@batch.BatchType</td>
              <td class="kvh-batch-status">@batch.Status</td>
              <td>@batch.TotalItems</td>
              <td class="kvh-batch-pending">@batch.PendingItems</td>
              <td class="kvh-batch-success">@batch.SuccessItems</td>
              <td class="kvh-batch-empty">@batch.EmptyItems</td>
              <td class="kvh-batch-failed">@batch.FailedItems</td>
              <td>@batch.StartedAtUtc?.ToString("dd/MM/yyyy HH:mm")</td>
              <td class="kvh-batch-completed">@batch.CompletedAtUtc?.ToString("dd/MM/yyyy HH:mm")</td>
              <td>
                <div class="progress-shell"><span class="kvh-batch-progress" style="width:@batch.ProgressPercent%"></span></div>
                <div class="muted kvh-batch-progress-text">@batch.ProcessedItems / @batch.TotalItems</div>
              </td>
              <td class="table-actions">
                @if (Model.CanManageSolutions && batch.IsRunning)
                {
                  <form asp-controller="KvhSolutions" asp-action="CancelSyncBatch" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@batch.Id" />
                    <button type="submit" class="table-action-btn">Cancel</button>
                  </form>
                }
                @if (Model.CanManageSolutions && batch.FailedItems > 0)
                {
                  <form asp-controller="KvhSolutions" asp-action="RetryFailedBatch" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@batch.Id" />
                    <button type="submit" class="table-action-btn">Retry failed</button>
                  </form>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="device-card">
    <div class="device-table-wrap">
      <table class="device-table subscription-table">
        <thead>
          <tr>
            <th></th>
            <th>Device / Terminal</th>
            <th>Vessel</th>
            <th>Tenant</th>
            <th>KIT</th>
            <th>Traffic ID</th>
            <th>Region</th>
            <th>KVH Plan</th>
            <th>Status</th>
            <th>Scheduled</th>
            <th>Allowance</th>
            <th>Last sync</th>
            <th>Sync result</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Items.Count == 0)
          {
            <tr><td colspan="14" class="tenant-empty">No KVH Solutions found.</td></tr>
          }
          @foreach (var item in Model.Items)
          {
            <tr>
              <td>
                @if (Model.CanManageSolutions)
                {
                  <input type="checkbox" class="kvh-device-checkbox" value="@item.DeviceId" />
                }
              </td>
              <td>
                <a asp-controller="KvhSolutions" asp-action="Details" asp-route-deviceId="@item.DeviceId">@item.DeviceName</a>
                <div class="muted">@item.TerminalId</div>
              </td>
              <td>@(string.IsNullOrWhiteSpace(item.VesselName) ? "-" : item.VesselName)</td>
              <td>@(string.IsNullOrWhiteSpace(item.TenantName) ? "-" : item.TenantName)</td>
              <td>@(string.IsNullOrWhiteSpace(item.KitNumber) ? "-" : item.KitNumber)</td>
              <td>@(item.MissingTrafficId ? "Traffic ID unavailable" : item.TrafficId)</td>
              <td>@(string.IsNullOrWhiteSpace(item.Region) ? "-" : item.Region)</td>
              <td>@(string.IsNullOrWhiteSpace(item.PlanName) ? "-" : item.PlanName)</td>
              <td><span class="subscription-status @item.Status">@(!string.IsNullOrWhiteSpace(item.Status) ? item.Status : "-")</span></td>
              <td>
                @(string.IsNullOrWhiteSpace(item.ScheduledAction) ? "-" : item.ScheduledAction)
                @if (item.ScheduledEffectiveDateUtc.HasValue)
                {
                  <div class="muted">@item.ScheduledEffectiveDisplay</div>
                }
              </td>
              <td>@item.AllowanceDisplay</td>
              <td>@item.LastSyncDisplay</td>
              <td>@item.LastSyncStatus @item.LastSyncErrorCode</td>
              <td class="table-actions">
                <form asp-controller="KvhSolutions" asp-action="Sync" method="post">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="deviceId" value="@item.DeviceId" />
                  <button type="submit" class="table-action-btn">Sync</button>
                </form>
                @if (Model.CanManageSolutions && item.KvhSubscriptionId.HasValue)
                {
                  @if (item.CanPause)
                  {
                    <form asp-controller="KvhSolutions" asp-action="Pause" method="post">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="DeviceId" value="@item.DeviceId" />
                      <input type="hidden" name="KvhSubscriptionId" value="@item.KvhSubscriptionId" />
                      <button type="submit" class="table-action-btn">Pause</button>
                    </form>
                  }
                  @if (item.CanResume)
                  {
                    <form asp-controller="KvhSolutions" asp-action="Resume" method="post">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="DeviceId" value="@item.DeviceId" />
                      <input type="hidden" name="KvhSubscriptionId" value="@item.KvhSubscriptionId" />
                      <button type="submit" class="table-action-btn">Resume</button>
                    </form>
                  }
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
</div>

@section Scripts {
  <script>
    (() => {
      const selectedForm = document.getElementById('kvhSyncSelectedForm');
      const selectedInputs = document.getElementById('kvhSelectedInputs');
      const selectedButton = document.getElementById('kvhSyncSelectedButton');
      const selectAll = document.getElementById('kvhSelectAll');
      const boxes = Array.from(document.querySelectorAll('.kvh-device-checkbox'));

      function refreshSelected() {
        if (!selectedInputs || !selectedButton) return;
        selectedInputs.innerHTML = '';
        const checked = boxes.filter(box => box.checked);
        checked.forEach((box, index) => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = `DeviceIds[${index}]`;
          input.value = box.value;
          selectedInputs.appendChild(input);
        });
        selectedButton.disabled = checked.length === 0;
      }

      selectAll?.addEventListener('change', () => {
        boxes.forEach(box => box.checked = selectAll.checked);
        refreshSelected();
      });
      boxes.forEach(box => box.addEventListener('change', refreshSelected));
      selectedForm?.addEventListener('submit', refreshSelected);

      const runningRows = Array.from(document.querySelectorAll('.kvh-batch-row[data-running="true"]'));
      if (runningRows.length === 0) return;
      const finalStatuses = new Set(['COMPLETED', 'COMPLETED_WITH_ERRORS', 'FAILED', 'CANCELLED']);
      const timers = runningRows.map(row => {
        const id = row.dataset.batchId;
        const timer = window.setInterval(async () => {
          if (document.hidden) return;
          const response = await fetch(`/KvhSolutions/BatchStatus?id=${encodeURIComponent(id)}`, { headers: { 'Accept': 'application/json' } });
          if (!response.ok) return;
          const batch = await response.json();
          row.querySelector('.kvh-batch-status').textContent = batch.status;
          row.querySelector('.kvh-batch-pending').textContent = batch.pendingItems;
          row.querySelector('.kvh-batch-success').textContent = batch.successItems;
          row.querySelector('.kvh-batch-empty').textContent = batch.emptyItems;
          row.querySelector('.kvh-batch-failed').textContent = batch.failedItems;
          row.querySelector('.kvh-batch-progress').style.width = `${batch.progressPercent}%`;
          row.querySelector('.kvh-batch-progress-text').textContent = `${batch.processedItems} / ${batch.totalItems}`;
          if (finalStatuses.has(batch.status)) window.clearInterval(timer);
        }, 7000);
        return timer;
      });
      window.addEventListener('beforeunload', () => timers.forEach(timer => window.clearInterval(timer)));
    })();
  </script>
}
