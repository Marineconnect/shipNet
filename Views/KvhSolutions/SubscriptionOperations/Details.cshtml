                  <span class="status-pill @StatusClass(item.Status)">@ItemStatusLabel(item.Status)</span>
                  <small>@OperationStateText(item)</small>
                </div>
              </div>
            </td>
            <td>@(string.IsNullOrWhiteSpace(item.JobId) ? "-" : item.JobId)</td>
            <td>@(item.KvhCommandId?.ToString() ?? "-")</td>
            <td>
              @if (ResultLabel(item) == "-")
              {
                <span>-</span>
              }
              else
              {
                <span class="status-pill @ResultClass(item)">@ResultLabel(item)</span>
              }
            </td>
            <td>@item.UpdatedDisplay</td>
            <td>
              <button type="button"
                      class="kvh-log-button"
                      title="Xem log lá»—i"
                      data-kvh-log-open
                      data-kit="@item.KitNumber"
                      data-status="@ItemStatusLabel(item.Status)"
                      data-process="@OperationStateText(item)"
                      data-error-code="@item.ErrorCode"
                      data-error-message="@(string.IsNullOrWhiteSpace(item.ReconciliationMessage) ? item.ErrorMessage : item.ReconciliationMessage)"
                      data-http-status="@item.HttpStatusCode"
                      data-command-id="@(item.KvhCommandId?.ToString() ?? string.Empty)"
                      data-job-id="@item.JobId"
                      data-request-json="@item.RequestJson"
                      data-submit-response="@(!string.IsNullOrWhiteSpace(item.CommandSubmitResponseJson) ? item.CommandSubmitResponseJson : item.SubmitResponseJson)"
                      data-job-response="@item.JobResponseJson"
                      data-verification-response="@item.VerificationResponseJson"
                      data-operation-log="@item.OperationLogJson"
                      aria-label="Xem log lá»—i @item.KitNumber">
                <span aria-hidden="true">!</span>
              </button>
            </td>
            <td>
              @if (Model.CanEdit)
              {
                <form asp-controller="KvhSubscriptionOperations" asp-action="RemoveItem" asp-route-id="@Model.Id" method="post">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="ItemId" value="@item.Id" />
                  <button type="submit" class="btn-danger compact">XÃ³a</button>
                </form>
              }
            </td>
          </tr>
        }
        @if (Model.Items.Count == 0)
        {
          <tr><td colspan="13" class="empty-cell">ChÆ°a cÃ³ thiáº¿t bá»‹ trong batch.</td></tr>
        }
        </tbody>
      </table>
    </div>
  </section>

  <div class="kvh-log-modal" id="kvhOperationLogModal" hidden>
    <div class="kvh-log-backdrop" data-kvh-log-close></div>
    <div class="kvh-log-panel" role="dialog" aria-modal="true" aria-labelledby="kvhOperationLogTitle">
      <header class="device-modal-head">
        <div>
          <h2 id="kvhOperationLogTitle">Log thá»±c hiá»‡n</h2>
          <p id="kvhOperationLogSubtitle">-</p>
        </div>
        <button type="button" class="device-modal-close" data-kvh-log-close aria-label="ÄÃ³ng">Ã—</button>
      </header>
      <div class="kvh-log-summary">
        <div><span>Tráº¡ng thÃ¡i</span><strong data-log-status>-</strong></div>
        <div><span>Tiáº¿n trÃ¬nh</span><strong data-log-process>-</strong></div>
        <div><span>HTTP</span><strong data-log-http>-</strong></div>
        <div><span>Command</span><strong data-log-command>-</strong></div>
        <div><span>Job ID</span><strong data-log-job>-</strong></div>
        <div><span>Error code</span><strong data-log-error-code>-</strong></div>
      </div>
      <div class="kvh-log-message" data-log-error-message></div>
      <div class="kvh-log-tabs">
        <button type="button" class="is-active" data-log-tab="operation">Operation log</button>
        <button type="button" data-log-tab="request">Request</button>
        <button type="button" data-log-tab="submit">Submit response</button>
        <button type="button" data-log-tab="job">Job response</button>
        <button type="button" data-log-tab="verify">Verify response</button>
      </div>
      <pre class="kvh-log-json" data-log-content>KhÃ´ng cÃ³ log.</pre>
      <footer class="device-modal-actions">
        <button type="button" class="btn-secondary" data-log-copy>Sao chÃ©p log</button>
        <button type="button" class="btn-primary" data-kvh-log-close>ÄÃ³ng</button>
      </footer>
    </div>
  </div>
</div>
</div>
</div>

@section Scripts {
  <script>
    (() => {
      const root = document.querySelector('[data-kvh-operation-id]');
      const logModal = document.querySelector('#kvhOperationLogModal');
      const logState = { payloads: {} };
      const pretty = (value) => {
        if (!value) return 'KhÃ´ng cÃ³ dá»¯ liá»‡u.';
        try { return JSON.stringify(JSON.parse(value), null, 2); } catch { return value; }
      };
      const setText = (selector, value) => {
        const node = logModal?.querySelector(selector);
        if (node) node.textContent = value || '-';
      };
      const setLogTab = (name) => {
        if (!logModal) return;
        logModal.querySelectorAll('[data-log-tab]').forEach((button) => button.classList.toggle('is-active', button.dataset.logTab === name));
        const content = logModal.querySelector('[data-log-content]');
        if (content) content.textContent = pretty(logState.payloads[name]);
      };
      document.querySelectorAll('[data-kvh-log-open]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!logModal) return;
          logState.payloads = {
            operation: button.dataset.operationLog,
            request: button.dataset.requestJson,
            submit: button.dataset.submitResponse,
            job: button.dataset.jobResponse,
            verify: button.dataset.verificationResponse
          };
          setText('#kvhOperationLogSubtitle', button.dataset.kit);
          setText('[data-log-status]', button.dataset.status);
          setText('[data-log-process]', button.dataset.process);
          setText('[data-log-http]', button.dataset.httpStatus);
          setText('[data-log-command]', button.dataset.commandId);
          setText('[data-log-job]', button.dataset.jobId);
          setText('[data-log-error-code]', button.dataset.errorCode);
          setText('[data-log-error-message]', button.dataset.errorMessage || 'KhÃ´ng cÃ³ thÃ´ng bÃ¡o lá»—i.');
          setLogTab('operation');
          logModal.hidden = false;
        });
      });
      logModal?.querySelectorAll('[data-kvh-log-close]').forEach((button) => button.addEventListener('click', () => { logModal.hidden = true; }));
      logModal?.querySelectorAll('[data-log-tab]').forEach((button) => button.addEventListener('click', () => setLogTab(button.dataset.logTab)));
      logModal?.querySelector('[data-log-copy]')?.addEventListener('click', async () => {
        const content = logModal?.querySelector('[data-log-content]')?.textContent || '';
        try { await navigator.clipboard.writeText(content); } catch {}
      });

      if (!root || root.dataset.kvhOperationLive !== 'true') return;
      const id = root.dataset.kvhOperationId;
      const terminalStatuses = new Set(['COMPLETED', 'COMPLETED_WITH_ERRORS', 'FAILED', 'CANCELLED']);
      const timer = window.setInterval(async () => {
        try {
          const response = await fetch(`/KvhSolutions/SubscriptionOperations/${id}/Status`, { headers: { 'Accept': 'application/json' } });
          if (!response.ok) return;
          const data = await response.json();
          const processing = (data.queuedItems || 0) + (data.pendingItems || 0) + (data.jobSuccessItems || 0);
          const failed = (data.jobFailedItems || 0) + (data.verificationMismatchItems || 0);
          const waiting = Math.max(0, (data.totalItems || 0) - (data.completedItems || 0) - processing);

          const progress = root.querySelector('[data-kvh-operation-progress]');
          const percent = root.querySelector('[data-kvh-operation-percent]');
          const ring = root.querySelector('.kvh-progress-ring');
          const total = root.querySelector('[data-kvh-total]');
          const processingNode = root.querySelector('[data-kvh-processing]');
          const verified = root.querySelector('[data-kvh-verified]');
          const failedNode = root.querySelector('[data-kvh-failed]');
          const waitingNode = root.querySelector('[data-kvh-waiting]');

          if (progress) progress.textContent = `${data.completedItems} / ${data.totalItems} thiáº¿t bá»‹ Ä‘Ã£ káº¿t thÃºc`;
          if (percent) percent.textContent = `${data.progressPercent}%`;
          if (ring) ring.style.setProperty('--progress', `${data.progressPercent * 3.6}deg`);
          if (total) total.textContent = data.totalItems;
          if (processingNode) processingNode.textContent = processing;
          if (verified) verified.textContent = data.verifiedItems;
          if (failedNode) failedNode.textContent = failed;
          if (waitingNode) waitingNode.textContent = waiting;

          if (terminalStatuses.has(data.status)) {
            window.clearInterval(timer);
            window.location.reload();
          }
        } catch {
        }
      }, 15000);
    })();
  </script>
}
