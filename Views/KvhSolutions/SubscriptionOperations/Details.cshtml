    var failedItems = Model.JobFailedItems + Model.VerificationMismatchItems;
    var processingItems = Model.QueuedItems + Model.PendingItems + Model.JobSuccessItems + Model.VerifyingItems;
    var waitingItems = Math.Max(0, Model.TotalItems - Model.CompletedItems - processingItems);
    var isLive = Model.Status is KvhSubscriptionOperationBatchStatuses.Queued
        or KvhSubscriptionOperationBatchStatuses.Running
        or KvhSubscriptionOperationBatchStatuses.Verifying
        or KvhSubscriptionOperationBatchStatuses.CancelRequested
        or KvhSubscriptionOperationBatchStatuses.Validating;

    string OperationLabel(string value) => value == KvhSubscriptionOperationTypes.Resume ? "KhÃ´i phá»¥c subscription" : "Táº¡m dá»«ng subscription";
    string ShortOperationLabel(string value) => value == KvhSubscriptionOperationTypes.Resume ? "Resume" : "Pause";

    string BatchStatusLabel(string value) => value switch
    {
        KvhSubscriptionOperationBatchStatuses.Draft => "NhÃ¡p",
        KvhSubscriptionOperationBatchStatuses.Validating => "Äang kiá»ƒm tra",
        KvhSubscriptionOperationBatchStatuses.Ready => "Sáºµn sÃ ng cháº¡y",
        KvhSubscriptionOperationBatchStatuses.Queued => "Äang chá» xá»­ lÃ½",
        KvhSubscriptionOperationBatchStatuses.Running => "Äang xá»­ lÃ½",
        KvhSubscriptionOperationBatchStatuses.Verifying => "Äang xÃ¡c minh",
        KvhSubscriptionOperationBatchStatuses.Completed => "HoÃ n táº¥t",
        KvhSubscriptionOperationBatchStatuses.CompletedWithErrors => "HoÃ n táº¥t cÃ³ lá»—i",
        KvhSubscriptionOperationBatchStatuses.Failed => "Tháº¥t báº¡i",
        KvhSubscriptionOperationBatchStatuses.CancelRequested => "Äang há»§y",
        KvhSubscriptionOperationBatchStatuses.Cancelled => "ÄÃ£ há»§y",
        _ => string.IsNullOrWhiteSpace(value) ? "ChÆ°a xÃ¡c Ä‘á»‹nh" : value
    };

    string ItemStatusLabel(string value) => value switch
    {
        KvhSubscriptionOperationItemStatuses.Draft => "NhÃ¡p",
        KvhSubscriptionOperationItemStatuses.ValidationFailed => "KhÃ´ng há»£p lá»‡",
        KvhSubscriptionOperationItemStatuses.Ready => "Sáºµn sÃ ng",
        KvhSubscriptionOperationItemStatuses.Queued => "Äang xáº¿p hÃ ng",
        KvhSubscriptionOperationItemStatuses.WaitingCooldown => "Chá» cooldown",
        KvhSubscriptionOperationItemStatuses.Submitting => "Äang gá»­i lá»‡nh",
        KvhSubscriptionOperationItemStatuses.Submitted => "ÄÃ£ gá»­i lá»‡nh",
        KvhSubscriptionOperationItemStatuses.JobPending => "KVH Ä‘ang xá»­ lÃ½",
        KvhSubscriptionOperationItemStatuses.JobSuccess => "Job thÃ nh cÃ´ng",
        KvhSubscriptionOperationItemStatuses.JobFailed => "Job tháº¥t báº¡i",
        KvhSubscriptionOperationItemStatuses.Verifying => "Äang xÃ¡c minh",
        KvhSubscriptionOperationItemStatuses.Verified => "ÄÃ£ xÃ¡c minh",
        KvhSubscriptionOperationItemStatuses.VerificationMismatch => "Sai lá»‡ch xÃ¡c minh",
        KvhSubscriptionOperationItemStatuses.RetryWait => "Chá» cháº¡y láº¡i",
        KvhSubscriptionOperationItemStatuses.Skipped => "Bá» qua",
        KvhSubscriptionOperationItemStatuses.Cancelled => "ÄÃ£ há»§y",
        KvhSubscriptionOperationItemStatuses.Timeout => "QuÃ¡ thá»i gian",
        _ => string.IsNullOrWhiteSpace(value) ? "ChÆ°a xÃ¡c Ä‘á»‹nh" : value
    };

    string StatusClass(string value) => value switch
    {
        KvhSubscriptionOperationBatchStatuses.Completed or KvhSubscriptionOperationItemStatuses.Verified => "paid",
        KvhSubscriptionOperationBatchStatuses.CompletedWithErrors => "debit",
        KvhSubscriptionOperationBatchStatuses.Ready or KvhSubscriptionOperationItemStatuses.Ready => "active",
        KvhSubscriptionOperationBatchStatuses.Failed or KvhSubscriptionOperationBatchStatuses.Cancelled or
            KvhSubscriptionOperationItemStatuses.JobFailed or KvhSubscriptionOperationItemStatuses.ValidationFailed or
            KvhSubscriptionOperationItemStatuses.VerificationMismatch or KvhSubscriptionOperationItemStatuses.Timeout => "void",
        _ => "pending"
    };

    bool IsItemProcessing(string value) => value is KvhSubscriptionOperationItemStatuses.Queued
        or KvhSubscriptionOperationItemStatuses.WaitingCooldown
        or KvhSubscriptionOperationItemStatuses.Submitting
        or KvhSubscriptionOperationItemStatuses.Submitted
        or KvhSubscriptionOperationItemStatuses.JobPending
        or KvhSubscriptionOperationItemStatuses.JobSuccess
        or KvhSubscriptionOperationItemStatuses.Verifying
        or KvhSubscriptionOperationItemStatuses.RetryWait;

    string ResultLabel(KvhSubscriptionOperationItemViewModel item)
    {
        if (item.Status is KvhSubscriptionOperationItemStatuses.Verified) return "success";
        if (item.Status is KvhSubscriptionOperationItemStatuses.JobFailed
            or KvhSubscriptionOperationItemStatuses.ValidationFailed
            or KvhSubscriptionOperationItemStatuses.VerificationMismatch
            or KvhSubscriptionOperationItemStatuses.Timeout) return "error";
        if (item.Status is KvhSubscriptionOperationItemStatuses.Cancelled
            or KvhSubscriptionOperationItemStatuses.Skipped) return "warning";
        return "-";
    }

    string ResultClass(KvhSubscriptionOperationItemViewModel item) => ResultLabel(item) switch
    {
        "success" => "paid",
        "error" => "void",
        "warning" => "debit",
        _ => "pending"
    };

    string OperationStateText(KvhSubscriptionOperationItemViewModel item) => item.Status switch
    {
        _ when !string.IsNullOrWhiteSpace(item.OperationStatus) => item.OperationStatus,
        KvhSubscriptionOperationItemStatuses.WaitingEffective => item.OperationType == KvhSubscriptionOperationTypes.Resume ? "Dang cho Resume co hieu luc" : "Dang cho Pause co hieu luc",
        KvhSubscriptionOperationItemStatuses.WaitingProcessing => "Dang cho KVH xu ly",
        KvhSubscriptionOperationItemStatuses.Conflict => "Xung dot trang thai",
        _ => ProcessText(item)
    };

    string DisplaySubscriptionStatus(KvhSubscriptionOperationItemViewModel item) =>
        string.IsNullOrWhiteSpace(item.CurrentSubscriptionStatus) ? item.SubscriptionStatus : item.CurrentSubscriptionStatus;

    string DisplayScheduledAction(KvhSubscriptionOperationItemViewModel item) =>
        string.IsNullOrWhiteSpace(item.CurrentScheduledAction) ? item.ScheduledAction : item.CurrentScheduledAction;

    string ProcessText(KvhSubscriptionOperationItemViewModel item) => item.Status switch
    {
        KvhSubscriptionOperationItemStatuses.Draft => "ChÆ°a kiá»ƒm tra",
        KvhSubscriptionOperationItemStatuses.ValidationFailed => "Cáº§n sá»­a dá»¯ liá»‡u",
        KvhSubscriptionOperationItemStatuses.Ready => "ÄÃ£ sáºµn sÃ ng gá»­i KVH",
        KvhSubscriptionOperationItemStatuses.Queued => "Äang chá» worker nháº­n",
        KvhSubscriptionOperationItemStatuses.WaitingCooldown => "Chá» Ä‘á»§ 5 phÃºt giá»¯a hai lá»‡nh",
        KvhSubscriptionOperationItemStatuses.Submitting => "Äang gá»­i yÃªu cáº§u sang KVH",
        KvhSubscriptionOperationItemStatuses.Submitted => "ÄÃ£ gá»­i, chá» Job ID",
        KvhSubscriptionOperationItemStatuses.JobPending => "Äang poll tráº¡ng thÃ¡i Job",
        KvhSubscriptionOperationItemStatuses.JobSuccess => "Job xong, Ä‘ang chá» xÃ¡c minh subscription",
        KvhSubscriptionOperationItemStatuses.Verifying => "Äang gá»i láº¡i Subscription API",
        KvhSubscriptionOperationItemStatuses.Verified => "Subscription Ä‘Ã£ Ä‘Ãºng tráº¡ng thÃ¡i",
        KvhSubscriptionOperationItemStatuses.VerificationMismatch => "KVH tráº£ tráº¡ng thÃ¡i chÆ°a khá»›p",
        KvhSubscriptionOperationItemStatuses.RetryWait => "Äang chá» retry",
        KvhSubscriptionOperationItemStatuses.JobFailed => "KVH tráº£ lá»—i hoáº·c khÃ´ng cÃ³ Job ID",
        KvhSubscriptionOperationItemStatuses.Cancelled => "ÄÃ£ dá»«ng trÆ°á»›c khi gá»­i",
        _ => ItemStatusLabel(item.Status)
    };

    string TimelineClass(params string[] statuses) => statuses.Contains(Model.Status) ? "is-current" :
        statuses.Any(status => status == KvhSubscriptionOperationBatchStatuses.Draft) && Model.Status != KvhSubscriptionOperationBatchStatuses.Draft ? "is-done" :
        statuses.Any(status => status == KvhSubscriptionOperationBatchStatuses.Ready) && Model.Status is KvhSubscriptionOperationBatchStatuses.Queued or KvhSubscriptionOperationBatchStatuses.Running or KvhSubscriptionOperationBatchStatuses.Verifying or KvhSubscriptionOperationBatchStatuses.Completed or KvhSubscriptionOperationBatchStatuses.CompletedWithErrors ? "is-done" :
        statuses.Any(status => status == KvhSubscriptionOperationBatchStatuses.Running) && Model.Status is KvhSubscriptionOperationBatchStatuses.Verifying or KvhSubscriptionOperationBatchStatuses.Completed or KvhSubscriptionOperationBatchStatuses.CompletedWithErrors ? "is-done" :
        statuses.Any(status => status == KvhSubscriptionOperationBatchStatuses.Verifying) && Model.Status is KvhSubscriptionOperationBatchStatuses.Completed or KvhSubscriptionOperationBatchStatuses.CompletedWithErrors ? "is-done" :
        string.Empty;
}

