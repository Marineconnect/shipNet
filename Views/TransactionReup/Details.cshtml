@model TransactionReupDetailsViewModel
@{
    ViewData["ActiveNav"] = "transactions";
    ViewData["Title"] = $"Import {Model.Batch.BatchCode}";
}
<div class="device-page"><div class="device-shell"><partial name="_PortalNav" /><div class="device-dashboard transaction-page">
  <nav class="portal-breadcrumb" aria-label="Breadcrumb"><a asp-action="Index">Reup Transaction</a><span>@Model.Batch.BatchCode</span></nav>
  <section class="device-hero"><div><div class="device-brand">IMPORT BATCH</div><h1>@Model.Batch.BatchCode</h1><p>@Model.Batch.OriginalFileName · @Model.Batch.ImportedAtDisplay · @Model.Batch.Status</p></div></section>
  <section class="device-card transaction-card"><header class="device-card-head"><div><h2>Chi tiết item</h2><p>@Model.Items.Count dòng</p></div><div class="device-modal-actions"><a class="btn-secondary" asp-action="Download" asp-route-id="@Model.Batch.Id">Tải file gốc</a><form asp-action="RetryFailed" asp-route-id="@Model.Batch.Id" method="post">@Html.AntiForgeryToken()<button class="btn-primary" type="submit">Retry lỗi</button></form></div></header>
    <div class="device-table-wrap transaction-table-wrap"><table class="device-table transaction-table"><thead><tr><th>Row</th><th>Transaction</th><th>Request / Invoice</th><th>Invoice code</th><th>Total</th><th>Validation</th><th>RabbitMQ</th><th>Message</th><th>Tác vụ</th></tr></thead><tbody>
    @foreach (var item in Model.Items) {
      <tr><td>@item.RowNumber</td><td><strong>@item.TransactionCode</strong></td><td>@item.RequestInvoiceCode</td><td>@item.InvoiceCode</td><td>@item.TotalAmountVnd.ToString("#,##0.##")</td><td>@item.ValidationStatus</td><td>@item.RabbitMqStatus<br /><span class="muted">@item.AttemptCount lần</span></td><td>@item.PublishMessage<br /><span class="muted">@item.MessageId</span></td><td><a class="table-action-btn" asp-action="Payload" asp-route-itemId="@item.Id" target="_blank">Payload</a>@if (item.CanRetry) { <form asp-action="RetryItem" asp-route-itemId="@item.Id" asp-route-batchId="@Model.Batch.Id" method="post" style="display:inline">@Html.AntiForgeryToken()<button class="table-action-btn" type="submit">Retry</button></form> }</td></tr>
    }
    </tbody></table></div>
  </section>
</div></div></div>
