@model TransactionReupIndexViewModel
@{
    ViewData["ActiveNav"] = "transactions";
    ViewData["Title"] = "Reup Transaction";
}
<div class="device-page"><div class="device-shell"><partial name="_PortalNav" /><div class="device-dashboard transaction-page">
  <nav class="portal-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Dashboard" asp-action="Index">Dashboard</a><span>Commerce</span><span>Transaction Reup</span>
  </nav>
  <section class="device-hero"><div><div class="device-brand">PAYMENT OPERATIONS</div><h1>Reup Transaction</h1><p>Import CSV/XLSX, assign invoice IDs and monitor RabbitMQ publishing.</p></div></section>
  <nav class="transaction-tabs" aria-label="Transaction views">
    <a asp-controller="Transactions" asp-action="Index" asp-route-tab="history">Transaction history</a><a class="is-active" asp-controller="TransactionReup" asp-action="Index">Reup Transaction</a>
  </nav>
  @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="tenant-alert @(Model.IsSuccess ? "success" : "danger")">@Model.Message</div> }
  <section class="device-card transaction-card">
    <header class="device-card-head"><div><h2>New import</h2><p>Only the exact username admin can use this feature.</p></div></header>
    <form asp-action="Import" method="post" enctype="multipart/form-data" class="transaction-filter-grid">
      @Html.AntiForgeryToken()
      <label><span>CSV or XLSX file</span><input asp-for="Import.File" accept=".csv,.xlsx" /><span asp-validation-for="Import.File" class="field-validation-error"></span></label>
      <label><span>Starting invoice ID</span><input asp-for="Import.StartInvoiceNumber" type="number" min="1" /><span asp-validation-for="Import.StartInvoiceNumber" class="field-validation-error"></span></label>
      <div class="transaction-filter-actions"><button type="submit" class="btn-primary">Import and publish</button></div>
      <div asp-validation-summary="All" class="tenant-alert danger"></div>
    </form>
  </section>
  <section class="device-card transaction-card">
    <header class="device-card-head"><div><h2>Import history</h2><p>@Model.Batches.Count batch(es)</p></div></header>
    <div class="device-table-wrap transaction-table-wrap"><table class="device-table transaction-table"><thead><tr>
      <th>Batch</th><th>File</th><th>Imported by</th><th>Imported at</th><th>Invoice IDs</th><th>Statistics</th><th>Status</th><th>Actions</th>
    </tr></thead><tbody>
    @if (Model.Batches.Count == 0) { <tr><td colspan="8" class="tenant-empty">No import batch yet.</td></tr> }
    @foreach (var batch in Model.Batches) {
      <tr><td><strong>@batch.BatchCode</strong></td><td>@batch.OriginalFileName</td><td>@batch.ImportedByUsername</td><td>@batch.ImportedAtDisplay</td>
      <td>@batch.InvoiceStartNumber - @batch.InvoiceEndNumber<br /><span class="muted">next @batch.NextInvoiceNumber</span></td>
      <td>@batch.TotalRows rows · @batch.ValidRows valid · @batch.PublishedRows published<br /><span class="muted">@batch.FailedRows failed · @batch.DuplicateRows duplicate</span></td>
      <td><span class="subscription-status @(batch.Status == "Completed" ? "paid" : batch.Status == "CompletedWithErrors" ? "void" : "pending")">@batch.Status</span></td>
      <td><a class="table-action-btn" asp-action="Details" asp-route-id="@batch.Id">Details</a><a class="table-action-btn" asp-action="Download" asp-route-id="@batch.Id">Download</a></td></tr>
    }
    </tbody></table></div>
  </section>
</div></div></div>
