      deviceNameInput.focus();
    } catch (error) {
      window.alert(`${text("network_error_prefix")}: ${error.message || text("generic_error")}`);
    } finally {
      sourceButton.disabled = false;
      sourceButton.classList.remove("is-processing");
    }
  }

  function closeCreateModal() { modal.hidden = true; document.body.style.overflow = detail.hidden ? "" : "hidden"; setProcessing(false); }
  function closeDetailModal() { detail.hidden = true; document.body.style.overflow = modal.hidden ? "" : "hidden"; setDetailProcessing(false); currentDetailDeviceId = 0; currentDetailDeviceCode = ""; }

  async function openDetail(sourceButton) {
    applyLanguage(lang);
    setActiveDetailTab("information");
    resetDetailView();
    detail.hidden = false;
    document.body.style.overflow = "hidden";
    const requestId = ++currentDetailRequestId;
    setDetailProcessing(true, sourceButton);
	    try {
	      const response = await fetch(`${deviceDetailDataAction}?id=${encodeURIComponent(sourceButton.dataset.deviceId)}`, { headers: { "X-Requested-With": "XMLHttpRequest" } });
	      const { rawText, data, isJson } = await readApiResponse(response);
	      if (!isJson || !response.ok) {
	        window.alert(resolveServerErrorMessage(response, data, rawText));
	        closeDetailModal();
	        return;
	      }
	      if (requestId !== currentDetailRequestId) {
	        return;
	      }
      q("#detailDeviceName").textContent = data.deviceName ?? data.DeviceName ?? "-";
      q("#detailDeviceCode").textContent = data.deviceCode ?? data.DeviceCode ?? "-";
      q("#detailVesselName").textContent = data.vesselName ?? data.VesselName ?? "-";
      q("#detailTenantName").textContent = data.tenantName ?? data.TenantName ?? "-";
      q("#detailTenantId").textContent = `${data.tenantId ?? data.TenantId ?? "-"}`;
      q("#detailKitId").textContent = data.kitId ?? data.KitId ?? "-";
      q("#detailSystemType").textContent = data.systemType ?? data.SystemType ?? "-";
      q("#detailKitNumber").textContent = data.kitNumber ?? data.KitNumber ?? "-";
      q("#detailServiceLine").textContent = data.serviceLine ?? data.ServiceLine ?? "-";
      q("#detailAvailability").innerHTML = renderStatusHtml(data.availability ?? data.Availability ?? "");
      q("#detailLastUpdate").textContent = data.lastUpdateTimeVietnam ?? data.LastUpdateTimeVietnam ?? "-";
      q("#detailLastSync").textContent = data.lastSysnTimeVietnam ?? data.LastSysnTimeVietnam ?? "-";
      q("#detailTotalUsage").textContent = data.subscriptionUsageDisplay ?? data.SubscriptionUsageDisplay ?? "-";
      q("#detailTotalUsageLimit").textContent = data.subscriptionLimitDisplay ?? data.SubscriptionLimitDisplay ?? "-";
      q("#detailUsageLimitTop").textContent = data.subscriptionLimitDisplay ?? data.SubscriptionLimitDisplay ?? "-";
      q("#detailPriorityOverage").textContent = data.priorityOverageDisplay ?? data.PriorityOverageDisplay ?? "-";
      q("#detailPriorityOverageLimit").textContent = data.priorityOverageLimitDisplay ?? data.PriorityOverageLimitDisplay ?? "-";
      q("#detailPlanName").textContent = data.planName ?? data.PlanName ?? "-";
      q("#detailUsageProgress").style.width = `${data.usageProgressPercent ?? data.UsageProgressPercent ?? "0"}%`;
      currentDetailDeviceId = Number(sourceButton.dataset.deviceId || 0);
      currentDetailDeviceCode = data.deviceCode ?? data.DeviceCode ?? "";
      setActiveTelemetryRange(900);
      if (requestId !== currentDetailRequestId) {
        return;
      }
      setDetailProcessing(false, sourceButton);
      window.setTimeout(async () => {
        if (requestId !== currentDetailRequestId) {
          return;
        }
        await Promise.all([
          loadTelemetryTimeline(requestId),
          loadNetworkingData(requestId)
        ]);
      }, 0);
      return;
    } catch (error) {
      window.alert(`${text("network_error_prefix")}: ${error.message || text("generic_error")}`);
      closeDetailModal();
    } finally {
      if (requestId === currentDetailRequestId && !detailLoading.hidden) {
        setDetailProcessing(false, sourceButton);
      }
    }
  }
  async function submitCreate(event) {
    event.preventDefault();
    hideFeedback();
    showApiResult("");
    if (!validateRequiredDeviceFields()) {
      showFeedback(text("validation_required"), "error");
      return;
    }
    setProcessing(true);
	    try {
	      const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { "X-Requested-With": "XMLHttpRequest" } });
	      const { rawText, data, isJson } = await readApiResponse(response);
	      if (!isJson) {
	        showFeedback(resolveServerErrorMessage(response, {}, rawText), "error");
	        showApiResult(rawText || "Empty response");
	        return;
	      }
	      const success = data.success ?? data.Success ?? false;
	      const apiRaw = data.apiResult ?? data.ApiResult ?? "";
	      if (!response.ok) {
	        showApiResult(apiRaw || rawText);
	        showFeedback(resolveServerErrorMessage(response, data, rawText), "error");
	        return;
	      }
	      if (success) {
	        showApiResult("");
	        showFeedback(resolveSuccessMessage(data, deviceModalMode === "edit" ? "update_success" : "create_success"), "success");
	        window.setTimeout(() => window.location.reload(), 900);
	        return;
	      }
	      showApiResult(apiRaw || rawText);
	      showFeedback(resolveServerErrorMessage(response, data, rawText), "error");
	    } catch (error) {
	      showFeedback(`${text("network_error_prefix")}: ${error.message || text("generic_error")}`, "error");
	    } finally {
      setProcessing(false);
    }
  }

  async function submitDelete(button) {
    const deviceId = button.dataset.deviceId || "";
    const kitCode = button.dataset.deviceCode || "";
    if (!window.confirm(format(text("delete_confirm"), { kitCode }))) return;
    button.disabled = true;
    const formData = new FormData();
    const csrfToken = antiForgeryToken(deleteForm);
    if (csrfToken) formData.append("__RequestVerificationToken", csrfToken);
    formData.append("id", deviceId);
	    try {
	      const response = await fetch(deleteForm.action, { method: "POST", body: formData, headers: { "X-Requested-With": "XMLHttpRequest" } });
	      const { rawText, data, isJson } = await readApiResponse(response);
	      if (!isJson) {
	        window.alert(resolveServerErrorMessage(response, {}, rawText));
	        return;
	      }
	      const success = data.success ?? data.Success ?? false;
	      if (!response.ok || !success) {
	        window.alert(resolveServerErrorMessage(response, data, rawText));
	        return;
	      }
	      window.alert(resolveSuccessMessage(data, "delete_success"));
	      window.location.reload();
	    } catch (error) {
	      window.alert(`${text("network_error_prefix")}: ${error.message || text("generic_error")}`);
    } finally {
      button.disabled = false;
    }
  }

  function bindRowActions(scope = document) {
    scope.querySelectorAll(".js-delete-device").forEach((button) => {
      if (button.dataset.boundDelete === "1") return;
      button.dataset.boundDelete = "1";
      button.addEventListener("click", () => submitDelete(button));
    });

    scope.querySelectorAll(".js-edit-device").forEach((button) => {
      if (button.dataset.boundEdit === "1") return;
      button.dataset.boundEdit = "1";
      button.addEventListener("click", () => openEditModal(button));
    });

    scope.querySelectorAll(".js-open-detail").forEach((button) => {
      if (button.dataset.boundDetail === "1") return;
      button.dataset.boundDetail = "1";
      button.addEventListener("click", () => openDetail(button));
    });
  }

  function renderDeviceRows(devices) {
    tableBody.innerHTML = devices.map((device) => {
      const availability = device.availability ?? device.Availability ?? "";
      const usage = device.usageDataDisplay ?? device.UsageDataDisplay ?? "-";
      const limit = device.priorityDataDisplay ?? device.PriorityDataDisplay ?? "-";
      const planName = device.planName ?? device.PlanName ?? "-";
      const deviceId = device.id ?? device.Id ?? 0;
      const deviceCode = device.deviceCode ?? device.DeviceCode ?? "";
      const vesselName = device.vesselName ?? device.VesselName ?? "-";
      const tenantName = device.tenantName ?? device.TenantName ?? "-";
      const tokenExpiredUtc = device.tokenExpiredTimeUtcIso ?? device.TokenExpiredTimeUtcIso ?? "";
      const lastSync = device.lastSysnTimeVietnam ?? device.LastSysnTimeVietnam ?? "-";
      const deviceName = device.deviceName ?? device.DeviceName ?? "-";
      const clientSynced = device.clientSynced === true || device.ClientSynced === true ? "true" : "false";

	      return `
	        <tr data-device-id="${deviceId}" data-token-expired-utc="${tokenExpiredUtc}" data-client-synced="${clientSynced}">
	          <td>${deviceName}</td>
	          <td>${vesselName || "-"}</td>
	          <td>${tenantName || "-"}</td>
	          <td><button type="button" class="table-code-btn js-open-detail" data-device-id="${deviceId}">${deviceCode}</button></td>
	          <td data-role="availability">${renderStatusHtml(availability)}</td>
	          <td data-role="usage">${renderUsageHtml(usage, limit)}</td>
	          <td data-role="plan-name">${planName || "-"}</td>
          <td data-role="last-sync">${lastSync}</td>
          <td>${renderActionHtml(deviceId, deviceCode)}</td>
        </tr>`;
    }).join("");

    bindRowActions(tableBody);
    applyLanguage(lang);
  }

  function renderPagination() {
    const totalPages = getTotalPages();
    currentPageText.textContent = `${currentPage}`;
    totalPagesText.textContent = `${totalPages}`;
    totalDevicesText.textContent = `${totalDevices}`;
    pageSizeSelect.value = `${currentPageSize}`;

    const buttons = [];
    const addButton = (label, page, disabled, i18nKey, active = false) => {
      if (disabled) {
        buttons.push(`<span class="pagination-btn is-disabled"${i18nKey ? ` data-i18n="${i18nKey}"` : ""}>${label}</span>`);
        return;
      }
      buttons.push(`<button type="button" class="pagination-btn${active ? " is-active" : ""}" data-page-target="${page}"${i18nKey ? ` data-i18n="${i18nKey}"` : ""}>${label}</button>`);
    };

    addButton(text("pagination_first"), 1, currentPage === 1, "pagination_first");
    addButton(text("pagination_prev"), currentPage - 1, currentPage === 1, "pagination_prev");

    const visiblePages = [];
    visiblePages.push(1);
    for (let page = Math.max(2, currentPage - 1); page <= Math.min(totalPages - 1, currentPage + 1); page++) {
      visiblePages.push(page);
    }
    if (totalPages > 1) {
      visiblePages.push(totalPages);
    }

    const uniquePages = [...new Set(visiblePages)].sort((a, b) => a - b);
    let previous = 0;
    uniquePages.forEach((page) => {
      if (previous && page - previous > 1) {
        buttons.push('<span class="pagination-ellipsis">...</span>');
      }
      addButton(`${page}`, page, false, "", page === currentPage);
      previous = page;
    });

    addButton(text("pagination_next"), currentPage + 1, currentPage === totalPages, "pagination_next");
    addButton(text("pagination_last"), totalPages, currentPage === totalPages, "pagination_last");

    paginationActions.innerHTML = buttons.join("");
    paginationActions.querySelectorAll("[data-page-target]").forEach((button) => {
      button.addEventListener("click", () => loadPage(Number(button.dataset.pageTarget), currentPageSize));
    });
    applyLanguage(lang);
  }

  async function fetchPageData(page, pageSize, searchTerm = currentSearchTerm) {
    const normalizedSearchTerm = normalizeSearchTerm(searchTerm);
    const keyName = cacheKey(page, pageSize, normalizedSearchTerm);
    if (pageCache.has(keyName)) {
      return pageCache.get(keyName);
    }

    const response = await fetch(`${devicePageDataAction}?page=${encodeURIComponent(page)}&pageSize=${encodeURIComponent(pageSize)}&search=${encodeURIComponent(normalizedSearchTerm)}`, {
      headers: { "X-Requested-With": "XMLHttpRequest" }
    });
    const rawText = await response.text();
    const data = rawText ? JSON.parse(rawText) : {};
    if (!response.ok) {
      throw new Error(data.message || `${response.status} ${response.statusText}`);
    }
    pageCache.set(keyName, data);
    persistPageCache();
    return data;
  }

  async function loadPage(page, pageSize, pushHistory = true, searchTerm = currentSearchTerm) {
    const nextPage = page < 1 ? 1 : page;
    const nextPageSize = pageSize <= 0 ? 10 : pageSize;
    const nextSearchTerm = normalizeSearchTerm(searchTerm);
    const pageData = await fetchPageData(nextPage, nextPageSize, nextSearchTerm);
    currentPage = pageData.currentPage ?? nextPage;
    currentPageSize = pageData.pageSize ?? nextPageSize;
    totalDevices = pageData.totalDevices ?? 0;
    currentSearchTerm = normalizeSearchTerm(pageData.searchTerm ?? nextSearchTerm);
    renderDeviceRows(pageData.devices ?? []);
    renderPagination();
    syncSearchUi();
    if (pushHistory) {
      const url = new URL(window.location.href);
      url.searchParams.set("page", `${currentPage}`);
      url.searchParams.set("pageSize", `${currentPageSize}`);
      if (currentSearchTerm) {
        url.searchParams.set("search", currentSearchTerm);
      } else {
        url.searchParams.delete("search");
      }

      window.history.pushState({ page: currentPage, pageSize: currentPageSize, search: currentSearchTerm }, "", url);
    }
    await syncDeviceRowsOnLoad();
  }

  function prepareSyncDeviceRow(row) {
    const availabilityCell = row.querySelector("[data-role='availability']");
    const usageCell = row.querySelector("[data-role='usage']");
    const planNameCell = row.querySelector("[data-role='plan-name']");
    const lastSyncCell = row.querySelector("[data-role='last-sync']");
    const state = {
      availabilityCell,
      usageCell,
      planNameCell,
      lastSyncCell,
      originalAvailability: availabilityCell ? availabilityCell.innerHTML : "",
      originalUsage: usageCell ? usageCell.innerHTML : "",
      originalPlanName: planNameCell ? planNameCell.textContent : ""
    };

    row.classList.add("is-syncing");
    if (availabilityCell) availabilityCell.innerHTML = renderCellLoading("status");
    if (usageCell) usageCell.innerHTML = renderCellLoading("usage");

    return state;
  }

  async function syncDeviceRow(row, csrfToken, rowState = prepareSyncDeviceRow(row)) {
    if (!csrfToken) {
      row.classList.remove("is-syncing");
      return;
    }

    const {
      availabilityCell,
      usageCell,
      planNameCell,
      lastSyncCell,
      originalAvailability,
      originalUsage,
      originalPlanName
    } = rowState;

    try {
      const formData = new FormData();
      formData.append("__RequestVerificationToken", csrfToken);
      formData.append("id", row.dataset.deviceId || "");
      const response = await fetch(refreshForm.action, { method: "POST", body: formData, headers: { "X-Requested-With": "XMLHttpRequest" } });
      const rawText = await response.text();
      let data = {};
      try { data = rawText ? JSON.parse(rawText) : {}; } catch { return; }
      const success = data.success ?? data.Success ?? false;
      if (!response.ok || !success) { console.warn("Device refresh failed", data); return; }
      row.dataset.tokenExpiredUtc = data.tokenExpiredTimeUtc ?? data.TokenExpiredTimeUtc ?? "";
      const availability = data.availability ?? data.Availability ?? "";
      const usage = data.usageDataDisplay ?? data.UsageDataDisplay ?? "-";
      const limit = data.priorityDataDisplay ?? data.PriorityDataDisplay ?? "-";
      const planName = data.planName ?? data.PlanName ?? "-";
      const lastSync = data.lastSysnTimeVietnam ?? data.LastSysnTimeVietnam ?? "-";
      if (availabilityCell) availabilityCell.innerHTML = renderStatusHtml(availability);
      if (usageCell) usageCell.innerHTML = renderUsageHtml(usage, limit);
      if (planNameCell) planNameCell.textContent = planName || "-";
      if (lastSyncCell) lastSyncCell.textContent = lastSync;
      row.dataset.clientSynced = "true";
      const keyName = cacheKey(currentPage, currentPageSize, currentSearchTerm);
      if (pageCache.has(keyName)) {
        const pageData = pageCache.get(keyName);
        const devices = pageData.devices ?? [];
        const targetId = Number(row.dataset.deviceId || "0");
        const target = devices.find((device) => Number(device.id ?? device.Id ?? 0) === targetId);
        if (target) {
          target.Availability = availability;
          target.UsageDataDisplay = usage;
          target.PriorityDataDisplay = limit;
          target.PlanName = planName;
          target.LastSysnTimeVietnam = lastSync;
          target.TokenExpiredTimeUtcIso = row.dataset.tokenExpiredUtc;
          target.clientSynced = true;
          persistPageCache();
        }
      }
    } catch (error) {
      console.warn("Device refresh request failed", error);
      if (availabilityCell) availabilityCell.innerHTML = originalAvailability;
      if (usageCell) usageCell.innerHTML = originalUsage;
      if (planNameCell) planNameCell.textContent = originalPlanName;
    } finally {
      row.classList.remove("is-syncing");
    }
  }

  async function syncDeviceRowsOnLoad() {
    const csrfToken = antiForgeryToken(refreshForm);
    const rowsToSync = [...document.querySelectorAll("tr[data-device-id][data-token-expired-utc]")]
      .filter((row) => row.dataset.clientSynced !== "true");

    if (!csrfToken || !rowsToSync.length) {
      return;
    }

    const preparedRows = rowsToSync.map((row) => ({ row, state: prepareSyncDeviceRow(row) }));
    const concurrency = Math.min(3, preparedRows.length);
    let cursor = 0;

    async function worker() {
      while (cursor < preparedRows.length) {
        const currentIndex = cursor++;
        const current = preparedRows[currentIndex];
        if (!current) {
          return;
        }
        await syncDeviceRow(current.row, csrfToken, current.state);
      }
    }

    await Promise.all(Array.from({ length: concurrency }, () => worker()));
  }

  hydratePageCache();
  setActiveTelemetryRange(900);
  metricCards.forEach((metricCard) => { metricCard.state.dataset.stateKey = "detail_chart_loading"; });
  applyLanguage(lang);
  window.history.replaceState({ page: currentPage, pageSize: currentPageSize, search: currentSearchTerm }, "", window.location.href);
  qa(".language-btn:not(.detail-language-btn)").forEach((button) => button.addEventListener("click", () => applyLanguage(button.dataset.lang)));
  qa(".detail-language-btn").forEach((button) => button.addEventListener("click", () => applyLanguage(button.dataset.lang)));
  portalNavToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    togglePortalNavMenu();
  });
  detailTabButtons.forEach((button) => button.addEventListener("click", () => setActiveDetailTab(button.dataset.detailTab || "information")));
  portalAccountButton?.addEventListener("click", (event) => {
    event.stopPropagation();
    togglePortalAccountMenu();
  });
  detailFilterButtons.forEach((button) => button.addEventListener("click", async () => {
    const rangeSeconds = Number(button.dataset.rangeSeconds || "900");
    setActiveTelemetryRange(rangeSeconds);
    await loadTelemetryTimeline();
  }));
  detailTelemetryReload.addEventListener("click", async () => {
    await loadTelemetryTimeline();
  });
  q("#openDeviceModal").addEventListener("click", openCreateModal);
  q("#closeDeviceModal").addEventListener("click", closeCreateModal);
  q("#cancelDeviceModal").addEventListener("click", closeCreateModal);
  q("#closeDeviceDetailModal").addEventListener("click", closeDetailModal);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closePortalAccountMenu();
    if (event.key === "Escape") closePortalNavMenu();
  });
  document.addEventListener("click", (event) => {
    if (portalNavPanel?.classList.contains("is-open")) {
      if (event.target instanceof Node && !portalNavPanel.contains(event.target) && !portalNavToggle?.contains(event.target)) {
        closePortalNavMenu();
      }
    }
    if (!portalAccountDropdown || portalAccountDropdown.hidden) {
      return;
    }
    if (event.target instanceof Node && !portalAccountDropdown.contains(event.target) && !portalAccountButton?.contains(event.target)) {
      closePortalAccountMenu();
    }
  });
  window.addEventListener("popstate", async (event) => {
    const state = event.state;
    if (state?.page && state?.pageSize) {
      await loadPage(Number(state.page), Number(state.pageSize), false, state.search || "");
      return;
    }

    const url = new URL(window.location.href);
    const page = Number(url.searchParams.get("page") || "1");
    const pageSize = Number(url.searchParams.get("pageSize") || `${currentPageSize}`);
    const searchTerm = url.searchParams.get("search") || "";
    await loadPage(page, pageSize, false, searchTerm);
  });
  form.addEventListener("submit", submitCreate);
  deviceSearchForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    currentPage = 1;
    await loadPage(1, currentPageSize, true, deviceSearchInput?.value || "");
  });
  clearDeviceSearchButton?.addEventListener("click", async () => {
    if (deviceSearchInput) {
      deviceSearchInput.value = "";
    }

    if (!currentSearchTerm) {
      syncSearchUi();
      return;
    }

    currentPage = 1;
    await loadPage(1, currentPageSize, true, "");
  });
  pageSizeSelect.addEventListener("change", async () => {
    currentPage = 1;
    currentPageSize = Number(pageSizeSelect.value) || 10;
    await loadPage(currentPage, currentPageSize, true, currentSearchTerm);
  });
  requiredDeviceFields.forEach((field) => {
    const eventName = field?.tagName === "SELECT" ? "change" : "input";
    field?.addEventListener(eventName, () => {
      if (field.value.trim()) {
        setFieldInvalid(field, false);
      }
    });
  });
  bindRowActions(document);
  renderPagination();
  syncDeviceRowsOnLoad();
})();
</script>
}
