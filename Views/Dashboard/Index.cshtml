  function clearRequiredFieldValidation() {
    [...requiredDeviceFields, deviceCodeInput, kitNumberInput].forEach((field) => setFieldInvalid(field, false));
  }
  function validateRequiredDeviceFields() {
    const validations = [
      [deviceNameInput, deviceNameInput.value.trim()],
      [vesselNameInput, vesselNameInput.value.trim()],
      [tenantIdInput, tenantIdInput.value.trim()]
    ];
    let isValid = true;
    validations.forEach(([field, value]) => {
      const missing = !value;
      setFieldInvalid(field, missing);
      if (missing) {
        isValid = false;
      }
    });
    const hasTerminalOrKit = Boolean(deviceCodeInput.value.trim() || kitNumberInput.value.trim());
    setFieldInvalid(deviceCodeInput, !hasTerminalOrKit);
    setFieldInvalid(kitNumberInput, !hasTerminalOrKit);
    if (!hasTerminalOrKit) {
      isValid = false;
    }
    return isValid;
  }
