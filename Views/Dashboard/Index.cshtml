    detailPlanFinalPrice.value = normalizeDecimalInput(option?.finalPrice ?? option?.FinalPrice);
    detailPlanFinalOverChargePrice.value = normalizeDecimalInput(option?.finalOverChargePrice ?? option?.FinalOverChargePrice);
