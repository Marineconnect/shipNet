    const billingUrl = new URL("@Url.Action("Index", "BillingInvoice")", window.location.origin);
    if (isFullYear) {
      billingUrl.searchParams.set("billingYear", `${year}`);
    } else {
      billingUrl.searchParams.set("billingCycle", buildDashboardCycle(month, year));
    }
    billingUrl.searchParams.set("invoiceValidity", "valid");
    billingUrl.searchParams.set("source", "dashboard-revenue");
    billingUrl.searchParams.set("sortBy", "invoiceAmount");
    billingUrl.searchParams.set("sortDirection", "desc");
    const subscriptionUrl = new URL("@Url.Action("Index", "MonthlySubscription")", window.location.origin);
    subscriptionUrl.searchParams.set("monthFrom", isFullYear ? `${year}-01-01` : buildDashboardMonthStart(month, year));
    subscriptionUrl.searchParams.set("monthTo", isFullYear ? `${year}-12-31` : buildDashboardMonthEnd(month, year));
    const commissionUrl = new URL("@Url.Action("Index", "BillingInvoice")", window.location.origin);
