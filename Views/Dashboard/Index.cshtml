	  function statusFallbackMessage(status, rawText, fallbackKey = "generic_error") {
	    if (isProbablyHtmlResponse(rawText)) {
	      return Number(status || 0) === 200
	        ? text("error_session_expired")
	        : text("error_invalid_response");
	    }

	    switch (Number(status || 0)) {
	      case 400:
	        return text(isProbablyHtmlResponse(rawText) ? "error_session_expired" : "error_bad_request");
	      case 401:
	        return text("error_unauthorized");
	      case 403:
	        return text("error_forbidden");
	      case 404:
	        return text("error_not_found");
	      default:
	        return status ? format(text("error_http_status"), { status: `${status}` }) : text(fallbackKey);
