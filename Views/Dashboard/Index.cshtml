      <div class="form-group">
        <label for="tenantId" data-i18n="field_tenant">Tenant</label>
        <select id="tenantId" name="TenantId" class="input">
          <option value="" data-i18n="field_tenant_placeholder">Chọn tenant</option>
          @foreach (var tenant in Model.Tenants)
          {
            <option value="@tenant.Id">@tenant.TenantName</option>
          }
        </select>
      </div>
      <div id="modalFeedback" class="modal-feedback" hidden></div>
      <div id="apiResult" class="api-result" hidden>
        <div class="api-result-title" data-i18n="api_result">Kết quả API</div>
