    const minValue = values.length ? Math.min(...values) : 0;
    const avgValue = values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;
    const maxValue = values.length ? Math.max(...values) : 0;
    metricCard.stats.textContent = format(text("detail_chart_stats"), {
      min: formatThroughputMbps(minValue),
      avg: formatThroughputMbps(avgValue),
      max: formatThroughputMbps(maxValue),
      unit: unitLabel
