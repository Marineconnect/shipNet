    const year = Number(data.year ?? data.Year ?? dashboardKpiYear?.value ?? new Date().getFullYear());
    if (dashboardKpiPeriod) dashboardKpiPeriod.textContent = data.periodDisplay ?? data.PeriodDisplay ?? "-";
    if (dashboardTotalRevenue) dashboardTotalRevenue.textContent = formatDashboardMoney(data.totalRevenue ?? data.TotalRevenue);
    if (dashboardActiveKits) dashboardActiveKits.textContent = `${formatDashboardNumber(data.activeKitCount ?? data.ActiveKitCount)} KIT`;
    if (dashboardBilledKits) dashboardBilledKits.textContent = formatDashboardNumber(data.billedKitCount ?? data.BilledKitCount);
    if (dashboardTotalCommission) dashboardTotalCommission.textContent = formatDashboardMoney(data.totalCommission ?? data.TotalCommission);
    updateDashboardKpiLinks(month, year);
  }

  async function loadDashboardKpi() {
    if (!dashboardKpiEndpoint || !dashboardKpiMonth || !dashboardKpiYear) {
      return;
    }

    dashboardKpiRequest?.abort();
    dashboardKpiRequest = new AbortController();
    const request = dashboardKpiRequest;
    const parsedMonth = Number(dashboardKpiMonth.value);
    const month = Number.isFinite(parsedMonth) ? parsedMonth : new Date().getMonth() + 1;
    const year = Number(dashboardKpiYear.value || new Date().getFullYear());
    const url = new URL(dashboardKpiEndpoint, window.location.origin);
    url.searchParams.set("month", `${month}`);
    url.searchParams.set("year", `${year}`);

    setDashboardKpiLoading(true);
    if (dashboardKpiError) dashboardKpiError.hidden = true;
    try {
      const response = await fetch(url.toString(), {
        signal: request.signal,
        headers: { "Accept": "application/json", "X-Requested-With": "XMLHttpRequest" }
      });
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }
      renderDashboardKpi(await response.json());
    } catch (error) {
      if (error.name !== "AbortError" && dashboardKpiError) {
        dashboardKpiError.hidden = false;
      }
    } finally {
      if (dashboardKpiRequest === request && !request.signal.aborted) {
        setDashboardKpiLoading(false);
      }
    }
  }

