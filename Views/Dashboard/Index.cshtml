  function getTelemetryRangeLabel(seconds) {
    switch (seconds) {
      case 900: return text("detail_range_15m");
      case 3600: return text("detail_range_1h");
      case 10800: return text("detail_range_3h");
      case 86400: return text("detail_range_24h");
      case 604800: return text("detail_range_7d");
      default: return `${seconds}s`;
    }
  }

  function formatThroughputMbps(value) {
    const numericValue = Number(value || 0);
    if (!Number.isFinite(numericValue) || numericValue <= 0) {
      return "0.00";
    }
    if (numericValue >= 1) {
      return numericValue.toFixed(2);
    }
    if (numericValue >= 0.1) {
      return numericValue.toFixed(3);
    }
    if (numericValue >= 0.01) {
      return numericValue.toFixed(4);
    }
    return numericValue.toFixed(5);
  }

  function setTelemetryState(metricCard, messageKey, fallback = "") {
    metricCard.card.classList.toggle("is-loading", messageKey === "detail_chart_loading");
    metricCard.state.hidden = false;
    metricCard.state.dataset.stateKey = messageKey;
    metricCard.state.textContent = text(messageKey) || fallback;
    metricCard.svg.innerHTML = "";
    metricCard.axisX.innerHTML = "";
    metricCard.axisYTop.textContent = "0.00";
    metricCard.axisYMid.textContent = "0.00";
    metricCard.axisYBottom.textContent = "0";
  }

  function updateTelemetryStats(metricCard, points, unitLabel) {
    const values = points.map((point) => Number(point.mbps || 0));
    const minValue = values.length ? Math.min(...values) : 0;
    const avgValue = values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;
    const maxValue = values.length ? Math.max(...values) : 0;
    metricCard.stats.textContent = format(text("detail_chart_stats"), {
      min: formatThroughputMbps(minValue),
      avg: formatThroughputMbps(avgValue),
      max: formatThroughputMbps(maxValue),
      unit: unitLabel
    });
  }

  function updateMetricTitles() {
    metricCards.forEach((metricCard) => {
      const titleKey = `metric_${metricCard.metric}`;
      metricCard.title.textContent = text(titleKey);
    });
