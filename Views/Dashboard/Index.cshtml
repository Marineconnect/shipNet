  function dataOptInStatusLabel(value) {
    return value === true ? text("detail_data_optin_in") : value === false ? text("detail_data_optin_out") : text("detail_data_optin_unknown");
  }

  function isFinalKvhCommandStatus(status) {
    return ["FAILED", "TIMEOUT", "VERIFIED", "VERIFICATION_MISMATCH", "VERIFICATION_TIMEOUT"].includes(`${status || ""}`.toUpperCase());
  }

  function formatKvhCommandLabel(command) {
    if (!command) return "";
    const commandStatus = command.commandStatus ?? command.CommandStatus ?? "-";
    const jobStatus = command.jobStatus ?? command.JobStatus ?? "";
    const verificationStatus = command.verificationStatus ?? command.VerificationStatus ?? "";
    const jobId = command.jobId ?? command.JobId ?? "";
    const parts = [`Command ${commandStatus}`];
    if (jobStatus) parts.push(`Job ${jobStatus}`);
    if (verificationStatus) parts.push(`Verify ${verificationStatus}`);
    if (jobId) parts.push(`Job ID ${jobId}`);
    return parts.join(" | ");
  }

  function stopKvhCommandPolling() {
    if (kvhCommandPollTimer) {
      window.clearTimeout(kvhCommandPollTimer);
      kvhCommandPollTimer = null;
    }
  }

  async function pollKvhCommand(commandId, messageElement, requestId = currentDetailRequestId, remainingAttempts = 60) {
    if (!commandId || requestId !== currentDetailRequestId || remainingAttempts <= 0) return;
    stopKvhCommandPolling();
    kvhCommandPollTimer = window.setTimeout(async () => {
      try {
        const response = await fetch(`${kvhCommandStatusAction}?id=${encodeURIComponent(commandId)}`, { headers: { "X-Requested-With": "XMLHttpRequest" } });
        const { rawText, data, isJson } = await readApiResponse(response);
        if (!isJson || !response.ok || !(data.success ?? data.Success)) throw new Error(resolveServerErrorMessage(response, data, rawText));
        const command = data.command ?? data.Command;
        if (messageElement) messageElement.textContent = formatKvhCommandLabel(command);
        const status = command?.commandStatus ?? command?.CommandStatus;
        if (!isFinalKvhCommandStatus(status)) {
          pollKvhCommand(commandId, messageElement, requestId, remainingAttempts - 1);
        } else if (canManageDataOptIn) {
          loadDataOptInData(requestId);
        }
      } catch (error) {
        if (messageElement) messageElement.textContent = error.message || text("generic_error");
      }
    }, 5000);
  }

  function renderDataOptInHistory(items) {
    if (!items?.length) {
      dataOptInHistory.innerHTML = `<div class="data-optin-empty">${text("detail_data_optin_empty")}</div>`;
      return;
    }
    dataOptInHistory.innerHTML = items.map((item) => {
      const oldStatus = item.oldStatus ?? item.OldStatus;
      const newStatus = item.newStatus ?? item.NewStatus;
      const success = item.apiSuccess ?? item.ApiSuccess;
      const response = item.apiResponse ?? item.ApiResponse ?? "";
      const jobId = item.jobId ?? item.JobId ?? "";
      const httpStatus = item.httpStatusCode ?? item.HttpStatusCode ?? "-";
      const commandStatus = item.commandStatus ?? item.CommandStatus ?? (success ? "SUBMITTED" : "FAILED");
      const jobStatus = item.jobStatus ?? item.JobStatus ?? "";
      const verificationStatus = item.verificationStatus ?? item.VerificationStatus ?? "";
      const statusText = [commandStatus, jobStatus, verificationStatus].filter(Boolean).join(" / ");
      return `<article class="data-optin-history-item">
        <div class="data-optin-history-meta"><strong>${escapeHtml(item.performedBy ?? item.PerformedBy ?? "-")}</strong><span>${escapeHtml(item.performedAtDisplay ?? item.PerformedAtDisplay ?? "-")}</span></div>
        <div class="data-optin-transition"><span>${dataOptInStatusLabel(oldStatus)}</span><b>?</b><span>${dataOptInStatusLabel(newStatus)}</span><em class="${isFinalKvhCommandStatus(commandStatus) && commandStatus !== "VERIFIED" ? "is-error" : "is-success"}">${escapeHtml(statusText || "-")} | HTTP ${httpStatus}</em></div>
        <details><summary>API response${jobId ? ` � Job ${escapeHtml(jobId)}` : ""}</summary><pre>${escapeHtml(response || "-")}</pre></details>
      </article>`;
    }).join("");
  }

  function applyDataOptInState(currentEnabled, history, warning = "") {
    dataOptInCurrent.textContent = dataOptInStatusLabel(currentEnabled);
    const targetEnabled = currentEnabled !== true;
    dataOptInAction.dataset.enabled = targetEnabled ? "true" : "false";
    dataOptInAction.textContent = targetEnabled ? text("detail_data_optin_in") : text("detail_data_optin_out");
    dataOptInAction.classList.toggle("is-danger", !targetEnabled);
    dataOptInAction.disabled = false;
    dataOptInMessage.textContent = warning || "";
    renderDataOptInHistory(history || []);
  }

  async function loadDataOptInData(requestId = currentDetailRequestId) {
    if (!canManageDataOptIn || !currentDetailDeviceId || requestId !== currentDetailRequestId) return;
    dataOptInMessage.textContent = text("detail_data_optin_loading");
    dataOptInAction.disabled = true;
    try {
      const response = await fetch(`${deviceDataOptInDataAction}?id=${encodeURIComponent(currentDetailDeviceId)}`, { headers: { "X-Requested-With": "XMLHttpRequest" } });
      const { rawText, data, isJson } = await readApiResponse(response);
      if (!isJson || !response.ok || !(data.success ?? data.Success)) throw new Error(resolveServerErrorMessage(response, data, rawText));
      if (requestId !== currentDetailRequestId) return;
      applyDataOptInState(data.currentEnabled ?? data.CurrentEnabled, data.history ?? data.History, data.apiWarning ?? data.ApiWarning ?? "");
    } catch (error) {
      if (requestId === currentDetailRequestId) dataOptInMessage.textContent = error.message || text("generic_error");
    }
  }

  async function submitDataOptInChange() {
    if (!canManageDataOptIn || !currentDetailDeviceId || dataOptInAction.disabled) return;
    const enabled = dataOptInAction.dataset.enabled === "true";
    if (!window.confirm(text(enabled ? "detail_data_optin_confirm_in" : "detail_data_optin_confirm_out"))) return;
    dataOptInAction.disabled = true;
    dataOptInMessage.textContent = text("processing");
    const formData = new FormData();
    formData.append("Id", `${currentDetailDeviceId}`);
    formData.append("Enabled", enabled ? "true" : "false");
    const csrfToken = antiForgeryToken(refreshForm);
    if (csrfToken) formData.append("__RequestVerificationToken", csrfToken);
    try {
      const response = await fetch(updateDeviceDataOptInAction, { method: "POST", body: formData, headers: { "X-Requested-With": "XMLHttpRequest" } });
      const { rawText, data, isJson } = await readApiResponse(response);
      if (!isJson || !response.ok || !(data.success ?? data.Success)) throw new Error(resolveServerErrorMessage(response, data, rawText));
      dataOptInMessage.textContent = text("detail_data_optin_submitted");
      const commandId = data.commandId ?? data.CommandId;
      if (commandId) pollKvhCommand(commandId, dataOptInMessage);
      await loadDataOptInData();
    } catch (error) {
      dataOptInMessage.textContent = error.message || text("generic_error");
      dataOptInAction.disabled = false;
    }
  }

  async function loadNetworkingData(requestId = currentDetailRequestId) {
    if (!currentDetailDeviceId || requestId !== currentDetailRequestId) {
      return;
    }

    q("#detailWifiSsid").textContent = "-";
    q("#detailWifiPassword").textContent = "-";
    q("#detailWifiEnabled").textContent = "-";
    detailWifiSsidInput.value = "";
    detailWifiPasswordInput.value = "";
    detailWifiEnabledInput.checked = false;
    detailNetworkStatus.textContent = text("detail_network_loading");

    try {
      const response = await fetch(`${deviceWifiDataAction}?id=${encodeURIComponent(currentDetailDeviceId)}`, {
        headers: { "X-Requested-With": "XMLHttpRequest" }
      });
      const { rawText, data, isJson } = await readApiResponse(response);
      if (!isJson || !response.ok || !(data.success ?? data.Success)) {
        throw new Error(resolveServerErrorMessage(response, data, rawText, "detail_network_error"));
      }
      if (requestId !== currentDetailRequestId) {
        return;
      }

      const ssid = data.ssid ?? data.Ssid ?? "";
      const password = data.password ?? data.Password ?? "";
      const enabled = data.enabled ?? data.Enabled;
      q("#detailWifiSsid").textContent = ssid || "-";
      q("#detailWifiPassword").textContent = password || "-";
      q("#detailWifiEnabled").textContent = typeof enabled === "boolean" ? (enabled ? "True" : "False") : "-";
      detailWifiSsidInput.value = ssid;
      detailWifiPasswordInput.value = password;
      detailWifiEnabledInput.checked = enabled !== false;
      detailNetworkStatus.textContent = text("detail_network_ready");
    } catch (error) {
      if (requestId !== currentDetailRequestId) {
        return;
      }
      detailNetworkStatus.textContent = `${text("detail_network_error")}: ${error.message || text("generic_error")}`;
    }
  }

  async function loadActivityData(page = 1, requestId = currentDetailRequestId) {
    if (!currentDetailDeviceId || requestId !== currentDetailRequestId) return;
    currentActivityPage = Math.max(1, page);
    detailActivityStatus.textContent = "Loading activity...";
    const params = new URLSearchParams({
      id: `${currentDetailDeviceId}`,
      page: `${currentActivityPage}`,
      pageSize: "50",
      category: detailActivityCategory.value,
      status: detailActivityStatusFilter.value,
      dateFrom: detailActivityFrom.value,
      dateTo: detailActivityTo.value
    });
    try {
      const response = await fetch(`${deviceActivityDataAction}?${params.toString()}`, { headers: { "Accept": "application/json" } });
      const data = await response.json();
      if (!response.ok || data.success === false) throw new Error(data.message || "Cannot load activity log.");
      if (requestId !== currentDetailRequestId) return;
      currentActivityTotalItems = Number(data.totalItems || data.TotalItems || 0);
      renderActivityRows(data.items || data.Items || []);
      const maxPage = Math.max(1, Math.ceil(currentActivityTotalItems / 50));
      detailActivityPage.textContent = `${currentActivityPage} / ${maxPage}`;
      detailActivityPrev.disabled = currentActivityPage <= 1;
      detailActivityNext.disabled = currentActivityPage >= maxPage;
      detailActivityStatus.textContent = currentActivityTotalItems > 0 ? `${currentActivityTotalItems} activities` : "No activity";
    } catch (error) {
      detailActivityBody.innerHTML = `<tr><td colspan="6">${escapeHtml(error.message || "Cannot load activity log.")}</td></tr>`;
      detailActivityStatus.textContent = "Activity load failed";
    }
  }

  function renderActivityRows(items) {
    if (!items.length) {
      detailActivityBody.innerHTML = `<tr><td colspan="6">No activity.</td></tr>`;
      return;
    }

    detailActivityBody.innerHTML = items.map((item, index) => {
      const time = item.timeDisplay ?? item.TimeDisplay ?? item.timeUtc ?? item.TimeUtc ?? "-";
      const category = item.category ?? item.Category ?? "-";
      const action = item.action ?? item.Action ?? "-";
      const status = item.status ?? item.Status ?? "-";
      const change = item.change ?? item.Change ?? "-";
      const performedBy = item.performedBy ?? item.PerformedBy ?? "-";
      const summary = item.summary ?? item.Summary ?? "";
      const detailJson = item.detailJson ?? item.DetailJson ?? "";
      const legacy = (item.isLegacy ?? item.IsLegacy) ? " legacy" : "";
      return `
        <tr class="detail-activity-row${legacy}" data-activity-index="${index}">
          <td>${escapeHtml(time)}</td>
          <td>${escapeHtml(category)}</td>
          <td>${escapeHtml(action)}<div class="detail-muted">${escapeHtml(summary)}</div></td>
          <td>${escapeHtml(change)}</td>
          <td>${escapeHtml(performedBy || "-")}</td>
          <td>${escapeHtml(status)}</td>
        </tr>
        <tr class="detail-activity-detail" data-activity-detail="${index}" hidden>
          <td colspan="6"><pre>${escapeHtml(detailJson || summary || "-")}</pre></td>
        </tr>`;
    }).join("");

    detailActivityBody.querySelectorAll(".detail-activity-row").forEach((row) => {
      row.addEventListener("click", () => {
        const detailRow = detailActivityBody.querySelector(`[data-activity-detail="${row.dataset.activityIndex}"]`);
        if (detailRow) detailRow.hidden = !detailRow.hidden;
      });
    });
  }

  function formatPrice(value) {
    const number = Number(value);
    if (!Number.isFinite(number)) return "-";
    const currency = "@defaultCurrency";
    return currency === "VND"
      ? `${number.toLocaleString("vi-VN", { maximumFractionDigits: 0 })} VND`
      : `${currency} ${number.toLocaleString("en-US", { maximumFractionDigits: 2 })}`;
  }

  function normalizeMoneyText(value, decimals = 0) {
    let textValue = `${value || ""}`.trim().replace(/[^\d,.-]/g, "");
    if (!textValue) return "";
    if (decimals <= 0) return textValue.replace(/[^\d-]/g, "");

    const lastComma = textValue.lastIndexOf(",");
    const lastDot = textValue.lastIndexOf(".");
    const decimalIndex = Math.max(lastComma, lastDot);
    if (decimalIndex < 0) return textValue.replace(/[^\d-]/g, "");

    const integerPart = textValue.slice(0, decimalIndex).replace(/[^\d-]/g, "");
    const decimalPart = textValue.slice(decimalIndex + 1).replace(/\D/g, "").slice(0, decimals);
    return decimalPart ? `${integerPart}.${decimalPart}` : integerPart;
  }

  function formatMoneyText(value, decimals = 0) {
    const normalized = normalizeMoneyText(value, decimals);
    if (!normalized || normalized === "-") return "";
    const number = Number(normalized);
    if (!Number.isFinite(number)) return "";
    return number.toLocaleString(decimals <= 0 ? "vi-VN" : "en-US", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimals
    });
  }

  function formatMoneyInput(input) {
    const decimals = Number(input.dataset.moneyDecimals || "0");
    input.value = formatMoneyText(input.value, decimals);
  }

  function normalizeMoneyInputValue(input) {
    const decimals = Number(input.dataset.moneyDecimals || "0");
    return normalizeMoneyText(input.value, decimals);
  }

  function normalizeDecimalInput(value) {
    const number = Number(value);
    if (!Number.isFinite(number) || number < 0) return "";
    return "@defaultCurrency" === "VND" ? number.toFixed(0) : number.toFixed(2);
  }

  function escapeHtml(value) {
    return `${value ?? ""}`
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function renderCopySvg() {
    return `<svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-1v1a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3h1V7Zm3-1a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-6Zm-3 4H7a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-1h-3a3 3 0 0 1-3-3v-3Z"/></svg><svg class="check-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9.2 16.6-4.1-4.1L3.7 14l5.5 5.5L20.8 7.9l-1.4-1.4L9.2 16.6Z"/></svg>`;
  }

  function renderCopyCell(value, label, detailButton = false, deviceId = 0) {
    const rawValue = `${value ?? ""}`.trim();
    const displayValue = rawValue || "-";
    const valueMarkup = detailButton
      ? `<button type="button" class="table-code-btn js-open-detail" data-device-id="${deviceId}">${escapeHtml(displayValue)}</button>`
      : `<span>${escapeHtml(displayValue)}</span>`;
    const copyButton = rawValue
      ? `<button type="button" class="table-copy-btn js-copy-table-value" data-copy-value="${escapeHtml(rawValue)}" data-copy-tooltip="Copy" aria-label="Copy ${escapeHtml(label)}">${renderCopySvg()}</button>`
      : "";
    return `<span class="table-copy-value">${valueMarkup}${copyButton}</span>`;
  }

  function markTableValueCopied(button) {
    window.clearTimeout(Number(button.dataset.copyResetTimer || 0));
    button.classList.add("is-copied");
    button.dataset.copyTooltip = "Copied";
    button.setAttribute("aria-label", "Copied");
    const timer = window.setTimeout(() => {
      button.classList.remove("is-copied");
      button.dataset.copyTooltip = "Copy";
      button.setAttribute("aria-label", button.dataset.copyLabel || "Copy");
      delete button.dataset.copyResetTimer;
    }, 2000);
    button.dataset.copyResetTimer = `${timer}`;
  }

  async function copyTableValue(button) {
    const value = button.dataset.copyValue || "";
    if (!value) return;
    button.dataset.copyLabel ||= button.getAttribute("aria-label") || "Copy";
    try {
      await navigator.clipboard.writeText(value);
      markTableValueCopied(button);
    } catch {
      const textArea = document.createElement("textarea");
      textArea.value = value;
      textArea.setAttribute("readonly", "");
      textArea.style.position = "fixed";
      textArea.style.opacity = "0";
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand("copy");
      textArea.remove();
      markTableValueCopied(button);
    }
  }

