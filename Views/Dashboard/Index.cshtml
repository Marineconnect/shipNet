  function populateDevicePlanSelect(selectedPricingPlanId = 0) {
    detailPlanSelect.innerHTML = `<option value="">${text("detail_plan_select_placeholder")}</option>`;
    const savedPlanIds = new Set(currentDevicePlanPrices.map((price) => Number(price.pricingPlanId ?? price.PricingPlanId ?? 0)));
    currentDevicePlanOptions.forEach((option) => {
      const pricingPlanId = Number(option.pricingPlanId ?? option.PricingPlanId ?? 0);
      if (devicePlanEditorMode === "create" && savedPlanIds.has(pricingPlanId)) {
        return;
      }

      const selectOption = document.createElement("option");
      selectOption.value = `${pricingPlanId}`;
      selectOption.textContent = option.displayName ?? option.DisplayName ?? `${option.planName ?? option.PlanName ?? "-"} (${option.planCode ?? option.PlanCode ?? "-"})`;
      detailPlanSelect.appendChild(selectOption);
    });
    detailPlanSelect.value = selectedPricingPlanId ? `${selectedPricingPlanId}` : "";
  }

  function openDevicePlanEditor(mode = "create", pricingPlanId = 0) {
    if (!canManageDevices || currentDevicePlanOptions.length === 0) {
      return;
    }

    devicePlanEditorMode = mode;
    const savedPrice = currentDevicePlanPrices.find((price) => Number(price.pricingPlanId ?? price.PricingPlanId ?? 0) === pricingPlanId);
    devicePlanEditorTitle.textContent = text(mode === "edit" ? "detail_plan_editor_title_edit" : "detail_plan_editor_title");
    populateDevicePlanSelect(mode === "edit" ? pricingPlanId : 0);
    detailPlanSelect.disabled = mode === "edit";
    fillDevicePlanPrices(mode === "edit" ? savedPrice : null);
    devicePlanEditorModal.hidden = false;
    applyLanguage(lang);
  }

  function closeDevicePlanEditor() {
    if (!devicePlanEditorModal) {
      return;
    }
    devicePlanEditorModal.hidden = true;
    detailPlanSelect.disabled = false;
    detailPlanSelect.value = "";
    fillDevicePlanPrices(null);
    devicePlanEditorMode = "create";
  }

  function canAddDevicePlan() {
    const savedPlanIds = new Set(currentDevicePlanPrices.map((price) => Number(price.pricingPlanId ?? price.PricingPlanId ?? 0)));
    return currentDevicePlanOptions.some((option) => !savedPlanIds.has(Number(option.pricingPlanId ?? option.PricingPlanId ?? 0)));
  }

  async function loadDevicePlanData(requestId = currentDetailRequestId) {
    if (!currentDetailDeviceId || requestId !== currentDetailRequestId) {
      return;
    }

    currentDevicePlanOptions = [];
    currentDevicePlanPrices = [];
    populateDevicePlanSelect();
    fillDevicePlanPrices(null);
    renderDevicePlanList([]);
    detailPlanStatus.textContent = text("detail_plan_loading");
    detailPlanAddButton.disabled = true;

    try {
      const response = await fetch(`${devicePlanDataAction}?id=${encodeURIComponent(currentDetailDeviceId)}`, {
        headers: { "X-Requested-With": "XMLHttpRequest" }
      });
      const { rawText, data, isJson } = await readApiResponse(response);
      if (!isJson || !response.ok || !(data.success ?? data.Success)) {
        throw new Error(resolveServerErrorMessage(response, data, rawText, "detail_plan_error"));
      }
      if (requestId !== currentDetailRequestId) {
        return;
      }

      currentDevicePlanOptions = data.planOptions ?? data.PlanOptions ?? [];
      currentDevicePlanPrices = data.devicePrices ?? data.DevicePrices ?? [];
      populateDevicePlanSelect();
      renderDevicePlanList(currentDevicePlanPrices);
      detailPlanStatus.textContent = currentDevicePlanOptions.length > 0 ? text("detail_plan_ready") : text("detail_plan_no_options");
      detailPlanAddButton.disabled = !canManageDevices || !canAddDevicePlan();
    } catch (error) {
      if (requestId !== currentDetailRequestId) {
        return;
      }
      detailPlanStatus.textContent = `${text("detail_plan_error")}: ${error.message || text("generic_error")}`;
      detailPlanAddButton.disabled = true;
    }
  }

  function syncSelectedDevicePlanPrices() {
    const pricingPlanId = Number(detailPlanSelect.value || 0);
    const option = currentDevicePlanOptions.find((item) => Number(item.pricingPlanId ?? item.PricingPlanId) === pricingPlanId);
    fillDevicePlanPrices(option);
  }

  async function submitDevicePlan(event) {
    event.preventDefault();
    if (!currentDetailDeviceId || !canManageDevices) {
      return;
    }

    const pricingPlanId = Number(detailPlanSelect.value || 0);
    const finalPriceValue = normalizeMoneyInputValue(detailPlanFinalPrice);
    const finalOverChargePriceValue = normalizeMoneyInputValue(detailPlanFinalOverChargePrice);
    const priceValues = [
      finalPriceValue,
      finalOverChargePriceValue
    ].map(Number);

    if (!pricingPlanId || priceValues.some((value) => !Number.isFinite(value) || value < 0)) {
      detailPlanStatus.textContent = text("detail_plan_validation");
      return;
    }

    detailPlanSaveButton.disabled = true;
    detailPlanStatus.textContent = text("processing");
    const formData = new FormData();
    const csrfToken = antiForgeryToken(refreshForm);
    if (csrfToken) formData.append("__RequestVerificationToken", csrfToken);
    formData.append("DeviceId", `${currentDetailDeviceId}`);
    formData.append("PricingPlanId", `${pricingPlanId}`);
    formData.append("FinalPrice", finalPriceValue);
    formData.append("FinalOverChargePrice", finalOverChargePriceValue);

    try {
      const response = await fetch(saveDevicePlanAction, { method: "POST", body: formData, headers: { "X-Requested-With": "XMLHttpRequest" } });
      const { rawText, data, isJson } = await readApiResponse(response);
      if (!isJson || !response.ok || !(data.success ?? data.Success)) {
        throw new Error(resolveServerErrorMessage(response, data, rawText, "detail_plan_error"));
      }

      await loadDevicePlanData();
      closeDevicePlanEditor();
      detailPlanStatus.textContent = data.message ?? data.Message ?? text("detail_plan_saved");
    } catch (error) {
      detailPlanStatus.textContent = `${text("detail_plan_error")}: ${error.message || text("generic_error")}`;
    } finally {
      detailPlanSaveButton.disabled = false;
    }
  }

  async function deleteDevicePlan(pricingPlanId, planName) {
    if (!currentDetailDeviceId || !pricingPlanId || !canManageDevices) {
      return;
    }
    if (!window.confirm(format(text("detail_plan_delete_confirm"), { planName }))) {
      return;
    }

    detailPlanStatus.textContent = text("processing");
    const formData = new FormData();
    const csrfToken = antiForgeryToken(refreshForm);
    if (csrfToken) formData.append("__RequestVerificationToken", csrfToken);
    formData.append("DeviceId", `${currentDetailDeviceId}`);
    formData.append("PricingPlanId", `${pricingPlanId}`);

    try {
      const response = await fetch(deleteDevicePlanAction, { method: "POST", body: formData, headers: { "X-Requested-With": "XMLHttpRequest" } });
      const { rawText, data, isJson } = await readApiResponse(response);
      if (!isJson || !response.ok || !(data.success ?? data.Success)) {
        throw new Error(resolveServerErrorMessage(response, data, rawText, "detail_plan_error"));
      }

      await loadDevicePlanData();
      detailPlanStatus.textContent = data.message ?? data.Message ?? text("detail_plan_deleted");
    } catch (error) {
      detailPlanStatus.textContent = `${text("detail_plan_error")}: ${error.message || text("generic_error")}`;
    }
  }

  function formatCommandStatus(messageKey, data) {
    const jobId = `${data?.jobId ?? data?.JobId ?? ""}`.trim();
