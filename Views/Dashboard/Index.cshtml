  function normalizeMetricValue(rawValue, unit, metric) {
    const numericValue = Number(rawValue || 0);
    if (!Number.isFinite(numericValue)) {
      return 0;
    }
    if (unit === "bps") {
      return numericValue / 1000000;
    }
    if (metric === "ping_drop_rate") {
      return numericValue <= 1 ? numericValue * 100 : numericValue;
    }
    return numericValue;
  }

  function buildMetricChart(metricCard, points, unitLabel) {
    updateTelemetryStats(metricCard, points, unitLabel);
    metricCard.unit.textContent = unitLabel;
    const metricColor = metricColors[metricCard.metric] || "#2f7fff";

    const peakValue = Math.max(...points.map((point) => point.mbps), 0);
    if (peakValue <= 0) {
      setTelemetryState(metricCard, "detail_chart_zero");
      return;
    }

    metricCard.card.classList.remove("is-loading");
    metricCard.state.hidden = true;

    const width = 900;
    const height = 260;
    const padding = { top: 16, right: 18, bottom: 42, left: 74 };
    const chartWidth = width - padding.left - padding.right;
    const chartHeight = height - padding.top - padding.bottom;
    const maxValue = Math.max(peakValue, 0.01);
    const xStep = points.length > 1 ? chartWidth / (points.length - 1) : chartWidth / 2;
    const yScale = (value) => padding.top + chartHeight - (value / maxValue) * chartHeight;
    const xScale = (index) => padding.left + (points.length > 1 ? index * xStep : chartWidth / 2);

    const linePoints = points.map((point, index) => `${xScale(index)},${yScale(point.mbps)}`).join(" ");
    const areaPoints = [
      `${padding.left},${padding.top + chartHeight}`,
      ...points.map((point, index) => `${xScale(index)},${yScale(point.mbps)}`),
      `${xScale(points.length - 1)},${padding.top + chartHeight}`
    ].join(" ");

    metricCard.svg.innerHTML = `
      <defs>
        <linearGradient id="detailAreaGradient-${metricCard.metric}" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="${metricColor}" stop-opacity="0.30" />
          <stop offset="100%" stop-color="${metricColor}" stop-opacity="0.03" />
        </linearGradient>
      </defs>
      <line x1="${padding.left}" y1="${padding.top}" x2="${padding.left + chartWidth}" y2="${padding.top}" class="detail-chart-grid-line"></line>
      <line x1="${padding.left}" y1="${padding.top + chartHeight / 2}" x2="${padding.left + chartWidth}" y2="${padding.top + chartHeight / 2}" class="detail-chart-grid-line"></line>
      <line x1="${padding.left}" y1="${padding.top + chartHeight}" x2="${padding.left + chartWidth}" y2="${padding.top + chartHeight}" class="detail-chart-grid-line"></line>
      <polygon points="${areaPoints}" fill="url(#detailAreaGradient-${metricCard.metric})"></polygon>
      <polyline points="${linePoints}" class="detail-chart-line" style="stroke:${metricColor}"></polyline>
    `;

    metricCard.axisYTop.textContent = formatThroughputMbps(maxValue);
    metricCard.axisYMid.textContent = formatThroughputMbps(maxValue / 2);
    metricCard.axisYBottom.textContent = "0";

    const tickIndexes = points.length <= 3
      ? points.map((_, index) => index)
      : [0, Math.floor((points.length - 1) / 2), points.length - 1];

    metricCard.axisX.innerHTML = [...new Set(tickIndexes)]
      .map((index) => `<span>${formatXAxisTime(points[index].timestamp)}</span>`)
      .join("");
  }

	  async function loadTelemetryTimeline(requestId = currentDetailRequestId) {
    if (!currentDetailDeviceId || !currentDetailDeviceCode || requestId !== currentDetailRequestId) {
      return;
    }

    const nowSeconds = Math.floor(Date.now() / 1000);
    const startSeconds = nowSeconds - selectedTelemetryRangeSeconds;
    detailTelemetryReload?.classList.add("is-loading");
    metricCards.forEach((metricCard) => setTelemetryState(metricCard, "detail_chart_loading"));

	    try {
	      const responses = await Promise.all(metricCards.map(async (metricCard) => {
	        const response = await fetch(`${telemetryTimelineAction}?id=${encodeURIComponent(currentDetailDeviceId)}&start=${encodeURIComponent(startSeconds)}&end=${encodeURIComponent(nowSeconds)}&metric=${encodeURIComponent(metricCard.metric)}`, {
	          headers: { "X-Requested-With": "XMLHttpRequest" }
	        });
	        const { rawText, data, isJson } = await readApiResponse(response);
	        if (!isJson) {
	          throw new Error(resolveServerErrorMessage(response, {}, rawText, "detail_chart_error"));
	        }
	        if (!response.ok || !(data.success ?? data.Success)) {
	          throw new Error(resolveServerErrorMessage(response, data, rawText, "detail_chart_error"));
	        }
	        return { metricCard, data };
	      }));

      currentTelemetryByMetric = new Map();

      responses.forEach(({ metricCard, data }) => {
        if (requestId !== currentDetailRequestId) {
          return;
        }
        const unitRaw = (data.unit ?? data.Unit ?? metricUnits[metricCard.metric] ?? "").toString();
        const unitLabel = unitRaw === "bps" ? "Mbps" : unitRaw;
        const points = (data.points ?? data.Points ?? [])
          .map((point) => {
            const timestamp = Number(point.timestamp ?? point.Timestamp ?? 0);
            const rawValue = Number(point.value ?? point.Value ?? 0);
            return {
              timestamp,
              mbps: normalizeMetricValue(rawValue, unitRaw, metricCard.metric)
            };
          })
          .filter((point) => Number.isFinite(point.timestamp) && Number.isFinite(point.mbps))
          .sort((a, b) => a.timestamp - b.timestamp);

        currentTelemetryByMetric.set(metricCard.metric, { points, unitLabel });

        if (!points.length) {
          setTelemetryState(metricCard, "detail_chart_empty");
          updateTelemetryStats(metricCard, [], unitLabel);
          metricCard.unit.textContent = unitLabel;
          return;
        }

        buildMetricChart(metricCard, points, unitLabel);
      });
    } catch (error) {
      if (requestId !== currentDetailRequestId) {
        return;
      }
      currentTelemetryByMetric = new Map();
      metricCards.forEach((metricCard) => {
        metricCard.state.dataset.stateKey = "detail_chart_error";
        metricCard.state.hidden = false;
        metricCard.state.textContent = `${text("detail_chart_error")}: ${error.message || text("generic_error")}`;
        metricCard.svg.innerHTML = "";
        metricCard.axisX.innerHTML = "";
        updateTelemetryStats(metricCard, [], metricUnits[metricCard.metric] || "");
      });
    } finally {
      if (requestId === currentDetailRequestId) {
        detailTelemetryReload?.classList.remove("is-loading");
      }
    }
  }

