  function bindDevicePlanActions() {
    detailPlanList.querySelectorAll(".js-edit-device-plan").forEach((button) => {
      button.addEventListener("click", () => openDevicePlanEditor("edit", Number(button.dataset.pricingPlanId || 0)));
