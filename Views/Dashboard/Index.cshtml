      </div>
      <div class="form-group">
        <label for="deviceCode" data-i18n="field_kit_code">Mã thiết bị đầu cuối</label>
        <input id="deviceCode" name="DeviceCode" class="input" maxlength="100" autocomplete="off" />
      </div>
      <div class="form-group">
        <label for="vesselName" data-i18n="field_vessel_name">Tên tàu</label>
        <input id="vesselName" name="VesselName" class="input" maxlength="250" autocomplete="off" />
