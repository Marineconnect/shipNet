  function renderPagination() {
    const totalPages = getTotalPages();
    currentPageText.textContent = `${currentPage}`;
    totalPagesText.textContent = `${totalPages}`;
    totalDevicesText.textContent = `${totalDevices}`;
    pageSizeSelect.value = `${currentPageSize}`;

    const buttons = [];
    const addButton = (label, page, disabled, i18nKey, active = false) => {
      if (disabled) {
        buttons.push(`<span class="pagination-btn is-disabled"${i18nKey ? ` data-i18n="${i18nKey}"` : ""}>${label}</span>`);
        return;
      }
      buttons.push(`<button type="button" class="pagination-btn${active ? " is-active" : ""}" data-page-target="${page}"${i18nKey ? ` data-i18n="${i18nKey}"` : ""}>${label}</button>`);
    };

    addButton(text("pagination_first"), 1, currentPage === 1, "pagination_first");
    addButton(text("pagination_prev"), currentPage - 1, currentPage === 1, "pagination_prev");

    const visiblePages = [];
    visiblePages.push(1);
    for (let page = Math.max(2, currentPage - 1); page <= Math.min(totalPages - 1, currentPage + 1); page++) {
      visiblePages.push(page);
    }
    if (totalPages > 1) {
      visiblePages.push(totalPages);
    }

    const uniquePages = [...new Set(visiblePages)].sort((a, b) => a - b);
    let previous = 0;
    uniquePages.forEach((page) => {
      if (previous && page - previous > 1) {
        buttons.push('<span class="pagination-ellipsis">...</span>');
      }
      addButton(`${page}`, page, false, "", page === currentPage);
      previous = page;
    });

    addButton(text("pagination_next"), currentPage + 1, currentPage === totalPages, "pagination_next");
    addButton(text("pagination_last"), totalPages, currentPage === totalPages, "pagination_last");

    paginationActions.innerHTML = buttons.join("");
    paginationActions.querySelectorAll("[data-page-target]").forEach((button) => {
      button.addEventListener("click", () => loadPage(Number(button.dataset.pageTarget), currentPageSize));
    });
    applyLanguage(lang);
  }

  async function fetchPageData(page, pageSize, searchTerm = currentSearchTerm) {
    const normalizedSearchTerm = normalizeSearchTerm(searchTerm);
    const keyName = cacheKey(page, pageSize, normalizedSearchTerm);
    if (pageCache.has(keyName)) {
      return pageCache.get(keyName);
    }

    const response = await fetch(`${devicePageDataAction}?page=${encodeURIComponent(page)}&pageSize=${encodeURIComponent(pageSize)}&search=${encodeURIComponent(normalizedSearchTerm)}&tab=${encodeURIComponent(currentDeviceTab)}`, {
      headers: { "X-Requested-With": "XMLHttpRequest" }
    });
    const rawText = await response.text();
    const data = rawText ? JSON.parse(rawText) : {};
    if (!response.ok) {
      throw new Error(data.message || `${response.status} ${response.statusText}`);
    }
    pageCache.set(keyName, data);
    persistPageCache();
    return data;
  }

  async function loadPage(page, pageSize, pushHistory = true, searchTerm = currentSearchTerm) {
    const nextPage = page < 1 ? 1 : page;
    const nextPageSize = pageSize <= 0 ? 10 : pageSize;
    const nextSearchTerm = normalizeSearchTerm(searchTerm);
    const pageData = await fetchPageData(nextPage, nextPageSize, nextSearchTerm);
    currentPage = pageData.currentPage ?? nextPage;
    currentPageSize = pageData.pageSize ?? nextPageSize;
    totalDevices = pageData.totalDevices ?? 0;
    currentSearchTerm = normalizeSearchTerm(pageData.searchTerm ?? nextSearchTerm);
    currentDeviceTab = pageData.tab === "stock" ? "stock" : currentDeviceTab;
    renderDeviceRows(pageData.devices ?? []);
    renderPagination();
    syncSearchUi();
    syncDeviceTabs();
    if (pushHistory) {
      window.history.pushState({ page: currentPage, pageSize: currentPageSize, search: currentSearchTerm, tab: currentDeviceTab }, "", buildListUrl());
    }
    await syncDeviceRowsOnLoad();
  }

  function prepareSyncDeviceRow(row, showLoading = true) {
    const availabilityCell = row.querySelector("[data-role='availability']");
    const usageCell = row.querySelector("[data-role='usage']");
    const planNameCell = row.querySelector("[data-role='plan-name']");
    const lastSyncCell = row.querySelector("[data-role='last-sync']");
    const state = {
      availabilityCell,
      usageCell,
      planNameCell,
      lastSyncCell,
      originalAvailability: availabilityCell ? availabilityCell.innerHTML : "",
      originalUsage: usageCell ? usageCell.innerHTML : "",
      originalPlanName: planNameCell ? planNameCell.textContent : ""
    };

    row.classList.add("is-syncing");
    if (showLoading) {
      if (availabilityCell) availabilityCell.innerHTML = renderCellLoading("status");
      if (usageCell) usageCell.innerHTML = renderCellLoading("usage");
    }

    return state;
  }

  async function syncDeviceRow(row, csrfToken, rowState = prepareSyncDeviceRow(row)) {
    if (!csrfToken) {
      row.classList.remove("is-syncing");
      return;
    }

    const {
      availabilityCell,
      usageCell,
      planNameCell,
      lastSyncCell,
      originalAvailability,
      originalUsage,
      originalPlanName
    } = rowState;

    try {
      const formData = new FormData();
      formData.append("__RequestVerificationToken", csrfToken);
      formData.append("id", row.dataset.deviceId || "");
      const response = await fetch(refreshForm.action, { method: "POST", body: formData, headers: { "X-Requested-With": "XMLHttpRequest" } });
      const rawText = await response.text();
      let data = {};
      try { data = rawText ? JSON.parse(rawText) : {}; } catch (parseError) { throw parseError; }
      const success = data.success ?? data.Success ?? false;
      if (!response.ok || !success) {
        const message = data.message || data.Message || data.messageEn || data.MessageEn || `${response.status} ${response.statusText}`;
        throw new Error(message);
      }
      row.dataset.tokenExpiredUtc = data.tokenExpiredTimeUtc ?? data.TokenExpiredTimeUtc ?? "";
      const availability = data.availability ?? data.Availability ?? "";
      const usage = data.usageDataDisplay ?? data.UsageDataDisplay ?? "-";
      const limit = data.priorityDataDisplay ?? data.PriorityDataDisplay ?? "-";
      const planName = data.planName ?? data.PlanName ?? "-";
      const lastSync = data.lastSysnTimeVietnam ?? data.LastSysnTimeVietnam ?? "-";
      if (availabilityCell) availabilityCell.innerHTML = renderStatusHtml(availability);
      if (usageCell) usageCell.innerHTML = renderUsageHtml(usage, limit);
      if (planNameCell) planNameCell.textContent = planName || "-";
      if (lastSyncCell) lastSyncCell.textContent = lastSync;
      row.dataset.clientSynced = "true";
      const keyName = cacheKey(currentPage, currentPageSize, currentSearchTerm);
      if (pageCache.has(keyName)) {
        const pageData = pageCache.get(keyName);
        const devices = pageData.devices ?? [];
        const targetId = Number(row.dataset.deviceId || "0");
        const target = devices.find((device) => Number(device.id ?? device.Id ?? 0) === targetId);
        if (target) {
          target.Availability = availability;
          target.UsageDataDisplay = usage;
          target.PriorityDataDisplay = limit;
          target.PlanName = planName;
          target.LastSysnTimeVietnam = lastSync;
          target.TokenExpiredTimeUtcIso = row.dataset.tokenExpiredUtc;
          target.clientSynced = true;
          persistPageCache();
        }
      }
    } catch (error) {
      console.warn("Device refresh request failed", error);
      if (availabilityCell) availabilityCell.innerHTML = originalAvailability;
      if (usageCell) usageCell.innerHTML = originalUsage;
      if (planNameCell) planNameCell.textContent = originalPlanName;
      row.dataset.clientSynced = "false";
    } finally {
      row.classList.remove("is-syncing");
    }
  }

  async function syncDeviceRowsOnLoad() {
    const csrfToken = antiForgeryToken(refreshForm);
    const rowsToSync = [...document.querySelectorAll("tr[data-device-id][data-token-expired-utc]")]
      .filter((row) => row.dataset.clientSynced !== "true" && row.dataset.hasTerminal === "true");

    if (!csrfToken || !rowsToSync.length) {
      return;
    }

    const preparedRows = rowsToSync.map((row) => ({ row, state: prepareSyncDeviceRow(row, false) }));
    const concurrency = Math.min(3, preparedRows.length);
    let cursor = 0;

    async function worker() {
      while (cursor < preparedRows.length) {
        const currentIndex = cursor++;
        const current = preparedRows[currentIndex];
        if (!current) {
          return;
        }
        await syncDeviceRow(current.row, csrfToken, current.state);
      }
    }

    await Promise.all(Array.from({ length: concurrency }, () => worker()));
  }

  async function syncStockDevices() {
    if (!syncStockDevicesForm || !syncStockDevicesButton) return;
    const csrfToken = antiForgeryToken(syncStockDevicesForm);
    if (!csrfToken) return;
    syncStockDevicesButton.disabled = true;
    const originalText = syncStockDevicesButton.textContent;
    syncStockDevicesButton.textContent = "Syncing...";
    try {
      const formData = new FormData();
      formData.append("__RequestVerificationToken", csrfToken);
      const response = await fetch(syncStockDevicesForm.action, { method: "POST", body: formData, headers: { "X-Requested-With": "XMLHttpRequest" } });
      const rawText = await response.text();
      const data = rawText ? JSON.parse(rawText) : {};
      if (!response.ok || !(data.success ?? data.Success ?? false)) {
        throw new Error(data.message || data.Message || data.messageEn || data.MessageEn || rawText || `${response.status} ${response.statusText}`);
      }
      window.alert(data.message || data.Message || data.messageEn || data.MessageEn || "Sync stock completed.");
      pageCache.clear();
      persistPageCache();
      await loadPage(1, currentPageSize, true, currentSearchTerm);
    } catch (error) {
      window.alert(`${text("network_error_prefix")}: ${error.message || text("generic_error")}`);
    } finally {
      syncStockDevicesButton.disabled = false;
      syncStockDevicesButton.textContent = originalText || "Sync stock";
    }
  }

  hydratePageCache();
  setActiveTelemetryRange(900);
  metricCards.forEach((metricCard) => { metricCard.state.dataset.stateKey = "detail_chart_loading"; });
  applyLanguage(lang);
  if (dashboardKpiMonth && dashboardKpiYear) {
    updateDashboardKpiLinks(Number(dashboardKpiMonth.value), Number(dashboardKpiYear.value));
    dashboardKpiMonth.addEventListener("change", loadDashboardKpi);
    dashboardKpiYear.addEventListener("change", loadDashboardKpi);
  }
  window.history.replaceState(
    { page: currentPage, pageSize: currentPageSize, search: currentSearchTerm, tab: currentDeviceTab, detailId: initialSelectedDeviceId || undefined },
    "",
    window.location.href);
  qa(".language-btn:not(.detail-language-btn)").forEach((button) => button.addEventListener("click", () => applyLanguage(button.dataset.lang)));
  qa(".detail-language-btn").forEach((button) => button.addEventListener("click", () => applyLanguage(button.dataset.lang)));
  portalNavToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    togglePortalNavMenu();
  });
  detailTabButtons.forEach((button) => button.addEventListener("click", () => setActiveDetailTab(button.dataset.detailTab || "information")));
  portalAccountButton?.addEventListener("click", (event) => {
    event.stopPropagation();
    togglePortalAccountMenu();
  });
  detailFilterButtons.forEach((button) => button.addEventListener("click", async () => {
    const rangeSeconds = Number(button.dataset.rangeSeconds || "900");
    setActiveTelemetryRange(rangeSeconds);
    await loadTelemetryTimeline();
  }));
  detailTelemetryReload.addEventListener("click", async () => {
    await loadTelemetryTimeline();
  });
  detailMapFullscreenButton?.addEventListener("click", toggleMapFullscreen);
  detailWifiForm.addEventListener("submit", submitWifiUpdate);
  detailRouterRebootButton.addEventListener("click", submitRouterReboot);
  detailPlanAddButton.addEventListener("click", () => openDevicePlanEditor("create"));
  closeDevicePlanEditorModal.addEventListener("click", closeDevicePlanEditor);
  cancelDevicePlanEditorModal.addEventListener("click", closeDevicePlanEditor);
  detailPlanSelect.addEventListener("change", syncSelectedDevicePlanPrices);
  [detailPlanFinalPrice, detailPlanFinalOverChargePrice].forEach((input) => {
    input.addEventListener("input", () => formatMoneyInput(input));
    input.addEventListener("blur", () => formatMoneyInput(input));
  });
  detailPlanForm.addEventListener("submit", submitDevicePlan);
  detailActivityReload.addEventListener("click", () => loadActivityData(1));
  [detailActivityCategory, detailActivityStatusFilter, detailActivityFrom, detailActivityTo].forEach((input) => {
    input.addEventListener("change", () => loadActivityData(1));
  });
  detailActivityPrev.addEventListener("click", () => loadActivityData(currentActivityPage - 1));
  detailActivityNext.addEventListener("click", () => loadActivityData(currentActivityPage + 1));
  dataOptInAction?.addEventListener("click", submitDataOptInChange);
  q("#openDeviceModal")?.addEventListener("click", openCreateModal);
  q("#closeDeviceModal").addEventListener("click", closeCreateModal);
  q("#cancelDeviceModal").addEventListener("click", closeCreateModal);
  q("#closeDeviceDetailModal").addEventListener("click", () => closeDetailModal(true));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && detailMapFullscreen) setMapFullscreen(false);
    if (event.key === "Escape") closeDevicePlanEditor();
    if (event.key === "Escape") closePortalAccountMenu();
    if (event.key === "Escape") closePortalNavMenu();
    if (event.key === "Escape") closeActionMenu();
  });
  document.addEventListener("click", (event) => {
    if (openActionMenu && event.target instanceof Node && !openActionMenu.menu.contains(event.target) && !openActionMenu.button.contains(event.target)) {
      closeActionMenu();
    }
    if (portalNavPanel?.classList.contains("is-open")) {
      if (event.target instanceof Node && !portalNavPanel.contains(event.target) && !portalNavToggle?.contains(event.target)) {
        closePortalNavMenu();
      }
    }
    if (!portalAccountDropdown || portalAccountDropdown.hidden) {
      return;
    }
    if (event.target instanceof Node && !portalAccountDropdown.contains(event.target) && !portalAccountButton?.contains(event.target)) {
      closePortalAccountMenu();
    }
  });
  window.addEventListener("scroll", closeActionMenu, true);
  window.addEventListener("resize", closeActionMenu);
  window.addEventListener("popstate", async (event) => {
    const state = event.state;
    if (state?.detailId) {
      currentDeviceTab = state.tab === "stock" ? "stock" : "synced";
      await loadPage(Number(state.page || 1), Number(state.pageSize || currentPageSize), false, state.search || "");
      await openDetail(Number(state.detailId), { pushHistory: false });
      return;
    }

    if (state?.page && state?.pageSize) {
      closeDetailModal(false);
      currentDeviceTab = state.tab === "stock" ? "stock" : "synced";
      await loadPage(Number(state.page), Number(state.pageSize), false, state.search || "");
      return;
    }

    closeDetailModal(false);
    const url = new URL(window.location.href);
    const page = Number(url.searchParams.get("page") || "1");
    const pageSize = Number(url.searchParams.get("pageSize") || `${currentPageSize}`);
    const searchTerm = url.searchParams.get("search") || "";
    currentDeviceTab = url.searchParams.get("tab") === "stock" ? "stock" : "synced";
    await loadPage(page, pageSize, false, searchTerm);
  });
  form.addEventListener("submit", submitCreate);
  deviceSearchForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    currentPage = 1;
    await loadPage(1, currentPageSize, true, deviceSearchInput?.value || "");
  });
  deviceSearchIconButton?.addEventListener("click", async () => {
    if (!currentSearchTerm) {
      return;
    }
    if (deviceSearchInput) {
      deviceSearchInput.value = "";
    }

    currentPage = 1;
    await loadPage(1, currentPageSize, true, "");
  });
  pageSizeSelect.addEventListener("change", async () => {
    currentPage = 1;
    currentPageSize = Number(pageSizeSelect.value) || 10;
    await loadPage(currentPage, currentPageSize, true, currentSearchTerm);
  });
  deviceTabButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const nextTab = button.dataset.deviceTab === "stock" ? "stock" : "synced";
      if (nextTab === currentDeviceTab) return;
      currentDeviceTab = nextTab;
      currentPage = 1;
      pageCache.clear();
      persistPageCache();
      await loadPage(1, currentPageSize, true, currentSearchTerm);
    });
  });
  syncStockDevicesButton?.addEventListener("click", syncStockDevices);
  requiredDeviceFields.forEach((field) => {
    const eventName = field?.tagName === "SELECT" ? "change" : "input";
    field?.addEventListener(eventName, () => {
      if (field.value.trim()) {
        setFieldInvalid(field, false);
      }
    });
  });
  bindRowActions(document);
  renderPagination();
  syncDeviceTabs();
  if (initialSelectedDeviceId) {
    openDetail(initialSelectedDeviceId, { pushHistory: false });
  }
  syncDeviceRowsOnLoad();
})();
</script>
}
