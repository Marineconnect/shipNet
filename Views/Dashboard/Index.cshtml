@model DeviceDashboardViewModel
@using System.Globalization
@using System.Security.Claims
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Danh sách thiết bị";
    ViewData["ActiveNav"] = "dashboard";
    ViewData["ShowLanguageSwitch"] = "true";

    string? ResolveLogoUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        if (Uri.IsWellFormedUriString(path, UriKind.Absolute))
        {
            return path;
        }

        return path.StartsWith("/")
            ? Url.Content($"~{path}")
            : Url.Content($"~/{path.TrimStart('~', '/')}");
    }

    var accountDisplayName = User.FindFirst("DisplayName")?.Value;
    if (string.IsNullOrWhiteSpace(accountDisplayName))
    {
        accountDisplayName = User.Identity?.Name;
    }

    var accountUsername = User.Identity?.Name ?? accountDisplayName ?? "User";
    var accountAvatarUrl = ResolveLogoUrl(User.FindFirst("Avatar")?.Value);
    var accountAvatarLabel = !string.IsNullOrWhiteSpace(accountDisplayName)
        ? accountDisplayName.Trim()[0].ToString().ToUpperInvariant()
        : "U";
    var accountAvatarStyle = !string.IsNullOrWhiteSpace(accountAvatarUrl)
        ? $"background-image:url('{accountAvatarUrl}')"
        : null;
    var defaultCurrency = (Configuration["System:DefaultCurrency"] ?? "VND").Trim().ToUpperInvariant();
    var moneyDecimals = string.Equals(defaultCurrency, "VND", StringComparison.OrdinalIgnoreCase) ? "0" : "2";
    string FormatDashboardMoney(decimal value) => string.Equals(defaultCurrency, "VND", StringComparison.OrdinalIgnoreCase)
        ? string.Create(CultureInfo.GetCultureInfo("vi-VN"), $"{value:N0} ₫")
        : string.Create(CultureInfo.InvariantCulture, $"{value:N2} {defaultCurrency}");
    var dashboardKpi = Model.Kpi ?? new DashboardKpiViewModel();
    var isFullYearKpi = dashboardKpi.Month == 0;
    var selectedCycle = isFullYearKpi ? null : $"{dashboardKpi.Year:D4}-{dashboardKpi.Month:D2}";
    var selectedMonthStart = isFullYearKpi ? $"{dashboardKpi.Year:D4}-01-01" : $"{dashboardKpi.Year:D4}-{dashboardKpi.Month:D2}-01";
    var selectedMonthEnd = isFullYearKpi ? $"{dashboardKpi.Year:D4}-12-31" : new DateTime(dashboardKpi.Year, dashboardKpi.Month, 1).AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd");
    var billingKpiUrl = isFullYearKpi
        ? Url.Action("Index", "BillingInvoice", new { billingYear = dashboardKpi.Year, invoiceValidity = "valid", source = "dashboard-revenue", sortBy = "invoiceAmount", sortDirection = "desc" }) ?? "/BillingInvoice"
        : Url.Action("Index", "BillingInvoice", new { billingCycle = selectedCycle, invoiceValidity = "valid", source = "dashboard-revenue", sortBy = "invoiceAmount", sortDirection = "desc" }) ?? "/BillingInvoice";
    var subscriptionKpiUrl = Url.Action("Index", "MonthlySubscription", new { monthFrom = selectedMonthStart, monthTo = selectedMonthEnd }) ?? "/MonthlySubscription";
    var commissionKpiUrl = isFullYearKpi
        ? Url.Action("Index", "BillingInvoice", new { billingYear = dashboardKpi.Year, metricFilter = "margin", invoiceValidity = "valid", source = "dashboard-commission", sortBy = "margin", sortDirection = "desc" }) ?? "/BillingInvoice"
        : Url.Action("Index", "BillingInvoice", new { billingCycle = selectedCycle, metricFilter = "margin", invoiceValidity = "valid", source = "dashboard-commission", sortBy = "margin", sortDirection = "desc" }) ?? "/BillingInvoice";
    var kpiYears = dashboardKpi.Years.Count > 0 ? dashboardKpi.Years : new List<int> { dashboardKpi.Year };
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIINfQkQfQ52JfCc0QfVIJ7VPF2uu5mBgwI=" crossorigin="" />

<div class="device-page">
  <div class="device-shell">
    <partial name="_PortalNav" />
    <div class="device-topbar">
      <div>
        <div class="device-brand">Shipnet portal</div>
        <h1 data-i18n="page_title">Danh sách thiết bị</h1>
        <p>
          @if (Model.IsTenantScoped)
          {
            @:Thi?t b? thu?c tenant <strong>@(Model.CurrentTenantName ?? "-")</strong>
          }
          else
          {
            <span data-i18n="customer_name">@Model.CustomerName</span> <text>.</text> <span data-i18n="customer_type">@Model.CustomerType</span>
          }
        </p>
      </div>
      <div class="device-actions">
        @if (Model.CanManageDevices)
        {
          <button type="button" class="btn-primary add-device-btn" id="openDeviceModal">
            <span class="add-device-icon">+</span>
            <span data-i18n="add_device">Thêm mới</span>
          </button>
        }
      </div>
    </div>

    <section class="dashboard-kpi-panel" id="dashboardKpiPanel" data-kpi-endpoint="@Url.Action("Kpi", "Dashboard")">
      <div class="dashboard-kpi-head">
        <div>
          <div class="dashboard-kpi-eyebrow" data-i18n="dashboard_kpi_eyebrow">Doanh thu tháng</div>
          <h2 data-i18n="dashboard_kpi_title">Tổng quan doanh thu</h2>
          <p><span data-i18n="dashboard_kpi_period">Chu kỳ:</span> <strong id="dashboardKpiPeriod">@dashboardKpi.PeriodDisplay</strong></p>
        </div>
        <div class="dashboard-kpi-filters" aria-label="Dashboard revenue filters">
          <label>
            <span data-i18n="dashboard_kpi_month">Tháng</span>
            <select id="dashboardKpiMonth">
              <option value="0" selected="@(dashboardKpi.Month == 0)" data-i18n="dashboard_kpi_all_months">Tất cả</option>
              @for (var month = 1; month <= 12; month++)
              {
                <option value="@month" selected="@(month == dashboardKpi.Month)">Tháng @month</option>
              }
            </select>
          </label>
          <label>
            <span data-i18n="dashboard_kpi_year">Năm</span>
            <select id="dashboardKpiYear">
              @foreach (var year in kpiYears)
              {
                <option value="@year" selected="@(year == dashboardKpi.Year)">@year</option>
              }
            </select>
          </label>
        </div>
      </div>
      <div class="dashboard-kpi-error" id="dashboardKpiError" hidden data-i18n="dashboard_kpi_error">Không tải được chỉ số doanh thu.</div>
      <div class="dashboard-kpi-grid" id="dashboardKpiGrid" aria-live="polite">
        <a class="dashboard-kpi-card is-revenue" id="dashboardRevenueCard" href="@billingKpiUrl">
          <span data-i18n="dashboard_total_revenue">Tổng doanh thu</span>
          <strong id="dashboardTotalRevenue">@FormatDashboardMoney(dashboardKpi.TotalRevenue)</strong>
        </a>
        <a class="dashboard-kpi-card is-kit" id="dashboardKitCard" href="@subscriptionKpiUrl">
          <span data-i18n="dashboard_active_kits">KIT kích hoạt</span>
          <strong id="dashboardActiveKits">@dashboardKpi.ActiveKitCount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) KIT</strong>
          <em><span id="dashboardBilledKits">@dashboardKpi.BilledKitCount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</span> <span data-i18n="dashboard_billed_kits">đã có invoice</span></em>
        </a>
        <a class="dashboard-kpi-card is-commission" id="dashboardCommissionCard" href="@commissionKpiUrl">
          <span data-i18n="dashboard_total_commission">Tổng hoa hồng</span>
          <strong id="dashboardTotalCommission">@FormatDashboardMoney(dashboardKpi.TotalCommission)</strong>
        </a>
      </div>
      <div class="dashboard-kpi-loading" id="dashboardKpiLoading" hidden data-i18n="dashboard_kpi_loading">Đang tải chỉ số...</div>
    </section>

    <section class="device-card">
      <div class="device-card-head">
        <div>
          <h2 data-i18n="inventory_title">Device Inventory</h2>
          <p><span data-i18n="total_label">T?ng s? thi?t b?:</span> <span id="totalDevicesText">@Model.TotalDevices</span></p>
        </div>
        <form id="deviceSearchForm" class="device-search" role="search" autocomplete="off">
