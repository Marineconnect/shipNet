  function syncTelemetryChartCopy() {
    updateMetricTitles();
    metricCards.forEach((metricCard) => {
      const metricData = currentTelemetryByMetric.get(metricCard.metric);
      const unitLabel = metricData?.unitLabel || metricUnits[metricCard.metric] || "";
      updateTelemetryStats(metricCard, metricData?.points || [], unitLabel);
      metricCard.unit.textContent = unitLabel;
      if (!metricData?.points?.length && !metricCard.state.hidden) {
        metricCard.state.textContent = metricCard.state.dataset.stateKey ? text(metricCard.state.dataset.stateKey) : metricCard.state.textContent;
      }
