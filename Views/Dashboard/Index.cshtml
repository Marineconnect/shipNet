  function cacheKey(page, pageSize, searchTerm = currentSearchTerm, tab = currentDeviceTab) {
    return `${tab}:${page}:${pageSize}:${encodeURIComponent(normalizeSearchTerm(searchTerm).toLowerCase())}`;
  }

  function hydratePageCache() {
    pageCache.set(cacheKey(initialPageData.currentPage, initialPageData.pageSize, initialPageData.searchTerm), initialPageData);
    try {
      const raw = sessionStorage.getItem(pageCacheKey);
      if (!raw) {
        return;
      }
      const parsed = JSON.parse(raw);
      Object.entries(parsed).forEach(([keyName, value]) => pageCache.set(keyName, value));
    } catch {
    }
  }

  function persistPageCache() {
    try {
      sessionStorage.setItem(pageCacheKey, JSON.stringify(Object.fromEntries(pageCache)));
    } catch {
    }
  }

