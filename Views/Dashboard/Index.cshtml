              <th data-i18n="col_vessel_name">T�n t�u</th>
              <th data-i18n="col_tenant_name">Tenant</th>
              <th data-i18n="col_kit_code">M� thi?t b? d?u cu?i</th>
              <th data-i18n="col_kit_number">KIT Number</th>
              <th data-i18n="col_service_line">Service Line</th>
              <th data-i18n="col_availability">Tr?ng th�i online</th>
              <th data-i18n="col_data_usage">Data Usage</th>
              <th data-i18n="col_plan_name">G�i cu?c</th>
              <th data-i18n="col_last_sync">D?ng b? l�c</th>
              <th data-i18n="col_actions">T�c v?</th>
            </tr>
          </thead>
