@model DeviceDashboardViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Danh sách thiết bị";

    string? ResolveLogoUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        if (Uri.IsWellFormedUriString(path, UriKind.Absolute))
        {
            return path;
        }

        return path.StartsWith("/")
            ? Url.Content($"~{path}")
            : Url.Content($"~/{path.TrimStart('~', '/')}");
    }

    var accountDisplayName = User.FindFirst("DisplayName")?.Value;
    if (string.IsNullOrWhiteSpace(accountDisplayName))
    {
        accountDisplayName = User.Identity?.Name;
    }

    var accountUsername = User.Identity?.Name ?? accountDisplayName ?? "User";
    var accountAvatarUrl = ResolveLogoUrl(User.FindFirst("Avatar")?.Value);
    var accountAvatarLabel = !string.IsNullOrWhiteSpace(accountDisplayName)
        ? accountDisplayName.Trim()[0].ToString().ToUpperInvariant()
        : "U";
    var accountAvatarStyle = !string.IsNullOrWhiteSpace(accountAvatarUrl)
        ? $"background-image:url('{accountAvatarUrl}')"
        : null;
}

<div class="device-page">
  <div class="device-shell">
    <header class="portal-nav">
      <div class="portal-nav-brand">
        <div class="portal-nav-mark">S</div>
        <div>
          <div class="portal-nav-title">Shipnet Portal</div>
          <div class="portal-nav-subtitle" data-i18n="nav_subtitle">Fleet Operations Console</div>
        </div>
      </div>
      <button type="button" class="portal-nav-toggle" id="portalNavToggle" aria-expanded="false" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="portal-nav-panel" id="portalNavPanel">
      <nav class="portal-nav-links" aria-label="Primary">
        <a asp-controller="Tenant" asp-action="Index" class="portal-nav-link" data-i18n="nav_tenant">Quản lý tenant</a>
        <a asp-controller="User" asp-action="Index" class="portal-nav-link" data-i18n="nav_users">Quản lý người dùng</a>
      </nav>
      <div class="portal-nav-tools">
        <div class="language-switch portal-language-switch" aria-label="Language switch">
          <button type="button" class="language-btn is-active" data-lang="vi">VI</button>
          <button type="button" class="language-btn" data-lang="en">EN</button>
        </div>
        <div class="portal-account-menu">
          <button type="button" class="portal-account" id="portalAccountButton" aria-haspopup="menu" aria-expanded="false">
            <div class="portal-account-avatar @(string.IsNullOrWhiteSpace(accountAvatarUrl) ? string.Empty : "has-image")" style="@accountAvatarStyle">@accountAvatarLabel</div>
            <div class="portal-account-copy">
              <strong>@accountDisplayName</strong>
              <span>@accountUsername</span>
            </div>
            <span class="portal-account-caret" aria-hidden="true"></span>
          </button>
          <div class="portal-account-dropdown" id="portalAccountDropdown" hidden>
            <a asp-controller="Account" asp-action="UserDetail" class="portal-account-item" data-i18n="nav_profile">Thông tin tài khoản</a>
            <a asp-controller="Account" asp-action="UserDetail" asp-fragment="password-section" class="portal-account-item" data-i18n="nav_password">Đổi mật khẩu</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="portal-account-form">
              @Html.AntiForgeryToken()
              <button type="submit" class="portal-account-item is-danger" data-i18n="logout">Đăng xuất</button>
            </form>
          </div>
        </div>
      </div>
      </div>
    </header>
    <div class="device-topbar">
      <div>
        <div class="device-brand">Shipnet portal</div>
        <h1 data-i18n="page_title">Danh sách thiết bị</h1>
        <p>
          @if (Model.IsTenantScoped)
          {
            @:Thiết bị thuộc tenant <strong>@(Model.CurrentTenantName ?? "-")</strong>
          }
          else
          {
            <span data-i18n="customer_name">@Model.CustomerName</span> <text>•</text> <span data-i18n="customer_type">@Model.CustomerType</span>
          }
        </p>
      </div>
      <div class="device-actions">
        <button type="button" class="btn-primary add-device-btn" id="openDeviceModal">
          <span class="add-device-icon">+</span>
          <span data-i18n="add_device">Thêm mới</span>
        </button>
      </div>
    </div>

    <section class="device-card">
      <div class="device-card-head">
        <div>
          <h2 data-i18n="inventory_title">Device Inventory</h2>
          <p><span data-i18n="total_label">Tổng số thiết bị:</span> <span id="totalDevicesText">@Model.TotalDevices</span></p>
        </div>
        <form id="deviceSearchForm" class="device-search" role="search" autocomplete="off">
          <input
            type="search"
            id="deviceSearchInput"
            class="device-search-input"
            value="@Model.SearchTerm"
            placeholder="Tìm theo tên thiết bị, tàu, tenant, mã thiết bị, trạng thái, gói cước"
            aria-label="Tìm thiết bị" />
          <button type="submit" class="btn-secondary device-search-btn" data-i18n="search_submit">Tìm</button>
          <button type="button" class="btn-secondary device-search-btn is-ghost" id="clearDeviceSearch" data-i18n="search_clear">Xóa</button>
        </form>
      </div>
      <div class="table-wrap">
        <table class="device-table">
          <thead>
            <tr>
              <th data-i18n="col_device_name">Tên thiết bị</th>
              <th data-i18n="col_vessel_name">Tên tàu</th>
              <th data-i18n="col_tenant_name">Tenant</th>
              <th data-i18n="col_kit_code">Mã thiết bị đầu cuối</th>
              <th data-i18n="col_availability">Trạng thái online</th>
              <th data-i18n="col_data_usage">Data Usage</th>
              <th data-i18n="col_plan_name">Gói cước</th>
              <th data-i18n="col_last_sync">Đồng bộ lúc</th>
              <th data-i18n="col_actions">Tác vụ</th>
            </tr>
          </thead>
          <tbody id="deviceTableBody">
	            @foreach (var device in Model.Devices)
		            {
		              <tr data-device-id="@device.Id" data-token-expired-utc="@device.TokenExpiredTimeUtcIso">
		                <td>@device.DeviceName</td>
		                <td>@device.VesselNameDisplay</td>
		                <td>@device.TenantNameDisplay</td>
		                <td>
		                  <button type="button" class="table-code-btn js-open-detail" data-device-id="@device.Id">
		                    @device.DeviceCode
	                  </button>
	                </td>
	                <td data-role="availability">
	                  <span class="status-pill">
	                    <span class="status-dot @(string.Equals(device.Availability, "online", StringComparison.OrdinalIgnoreCase) ? "is-online" : "is-offline")"></span>
                    <span>@device.Availability</span>
                  </span>
                </td>
                <td data-role="usage">
                  <span class="list-usage">
                    <span class="list-usage-chip">@device.UsageDataDisplay</span>
                    <span class="list-usage-separator">/</span>
                    <span class="list-usage-chip is-limit">@device.PriorityDataDisplay</span>
                  </span>
                </td>
                <td data-role="plan-name">@device.PlanNameDisplay</td>
                <td data-role="last-sync">@device.LastSysnTimeVietnam</td>
                <td>
	                  <div class="table-actions">
	                    <button type="button" class="table-action-btn js-open-detail" data-device-id="@device.Id">
	                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c5.23 0 9.27 4.11 10.57 6-.85 1.23-2.98 3.64-6.06 5.08C15.1 16.75 13.57 17 12 17c-5.23 0-9.27-4.11-10.57-6C2.73 9.11 6.77 5 12 5Zm0 2c-3.73 0-6.93 2.46-8.43 4 1.5 1.54 4.7 4 8.43 4s6.93-2.46 8.43-4C18.93 9.46 15.73 7 12 7Zm0 1.5A2.5 2.5 0 1 1 9.5 11 2.5 2.5 0 0 1 12 8.5Zm0 2A.5.5 0 1 0 12.5 11 .5.5 0 0 0 12 10.5Z"/></svg>
	                      <span data-i18n="view_action">Chi tiết</span>
	                    </button>
	                    <button type="button" class="table-action-btn js-edit-device" data-device-id="@device.Id">
	                      <span data-i18n="edit_action">Sửa</span>
	                    </button>
	                    <button type="button" class="table-action-btn is-danger js-delete-device" data-device-id="@device.Id" data-device-code="@device.DeviceCode">
	                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-2 6h2v8H7V9Zm4 0h2v8h-2V9Zm4 0h2v8h-2V9ZM6 21a2 2 0 0 1-2-2V8h16v11a2 2 0 0 1-2 2H6Z"/></svg>
	                      <span data-i18n="delete_action">Xóa</span>
	                    </button>
                  </div>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      <div class="device-pagination" id="devicePagination">
        <div class="device-pagination-meta">
          <label class="page-size-wrap" for="pageSizeSelect">
            <span data-i18n="pagination_pagesize">Số dòng</span>
            <select id="pageSizeSelect" class="page-size-select">
              <option value="10" selected="@(Model.PageSize == 10)">10</option>
              <option value="20" selected="@(Model.PageSize == 20)">20</option>
              <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
          </label>
          <span data-i18n="pagination_label">Trang</span>
          <strong id="currentPageText">@Model.CurrentPage</strong>
          <span>/</span>
          <strong id="totalPagesText">@Model.TotalPages</strong>
        </div>
        <div class="device-pagination-actions" id="paginationActions"></div>
      </div>
    </section>
  </div>
</div>

<div class="modal-backdrop" id="deviceDetailModal" hidden>
  <div class="device-detail-modal" role="dialog" aria-modal="true" aria-labelledby="deviceDetailTitle">
    <div class="device-detail-shell">
      <div class="device-detail-toolbar">
        <div>
          <div class="device-brand">Shipnet portal</div>
          <h2 id="deviceDetailTitle" class="device-detail-title" data-i18n="detail_title">Chi tiết thiết bị</h2>
        </div>
        <div class="device-detail-toolbar-right">
          <div class="language-switch detail-language-switch" aria-label="Detail language switch">
            <button type="button" class="language-btn detail-language-btn" data-lang="vi">VI</button>
            <button type="button" class="language-btn detail-language-btn" data-lang="en">EN</button>
          </div>
          <button type="button" class="modal-close" id="closeDeviceDetailModal" aria-label="Close">×</button>
        </div>
      </div>
      <div class="detail-tabbar" role="tablist" aria-label="Detail sections">
        <button type="button" class="detail-tab-btn is-active" data-detail-tab="information" data-i18n="detail_tab_information">Information</button>
        <button type="button" class="detail-tab-btn" data-detail-tab="telemetry" data-i18n="detail_tab_telemetry">Telemetry</button>
        <button type="button" class="detail-tab-btn" data-detail-tab="networking" data-i18n="detail_tab_networking">Networking</button>
      </div>
      <div class="device-detail-content">
        <div class="detail-loading" id="detailLoading" hidden>
          <span class="detail-loading-spinner" aria-hidden="true"></span>
          <span class="detail-loading-text" data-i18n="processing">Đang xử lý...</span>
        </div>
        <section class="detail-tab-panel is-active" data-detail-panel="information">
          <div class="detail-info-layout">
            <section class="detail-usage-panel">
              <div class="detail-panel-head"><span data-i18n="detail_subscription_title">Gói hiện tại</span></div>
              <div class="usage-progress">
                <div class="usage-progress-bar">
                  <div class="usage-progress-fill" id="detailUsageProgress"></div>
                </div>
                <div class="usage-progress-scale"><span>0</span><span id="detailUsageLimitTop">-</span></div>
              </div>
              <div class="usage-grid">
                <div class="usage-row"><span data-i18n="detail_total_usage">Tổng dung lượng</span><div class="usage-values"><strong id="detailTotalUsage">-</strong><span>/</span><strong id="detailTotalUsageLimit">-</strong></div></div>
                <div class="usage-row"><span data-i18n="detail_priority_overage">Priority Overage</span><div class="usage-values"><strong id="detailPriorityOverage">-</strong><span>/</span><strong id="detailPriorityOverageLimit">-</strong></div></div>
                <div class="usage-row"><span data-i18n="detail_plan_name">Tên gói</span><div class="usage-values usage-values-single"><strong id="detailPlanName">-</strong></div></div>
              </div>
            </section>
            <section class="detail-panel">
              <div class="detail-panel-title" data-i18n="detail_system_info">Thông tin hệ thống</div>
	              <div class="detail-kv"><span data-i18n="detail_device_name">Tên thiết bị</span><strong id="detailDeviceName">-</strong></div>
	              <div class="detail-kv"><span data-i18n="detail_device_code">Mã thiết bị đầu cuối</span><strong id="detailDeviceCode">-</strong></div>
	              <div class="detail-kv"><span data-i18n="detail_vessel_name">Tên tàu</span><strong id="detailVesselName">-</strong></div>
	              <div class="detail-kv"><span data-i18n="detail_tenant">Tenant</span><strong id="detailTenantName">-</strong></div>
	              <div class="detail-kv"><span data-i18n="detail_tenant_id">Tenant ID</span><strong id="detailTenantId">-</strong></div>
	              <div class="detail-kv"><span data-i18n="detail_kit_id">KITID</span><strong id="detailKitId">-</strong></div>
              <div class="detail-kv"><span data-i18n="detail_system_type">System Type</span><strong id="detailSystemType">-</strong></div>
              <div class="detail-kv"><span data-i18n="detail_kit_number">KIT Number</span><strong id="detailKitNumber">-</strong></div>
              <div class="detail-kv"><span data-i18n="detail_service_line">Service Line</span><strong id="detailServiceLine">-</strong></div>
              <div class="detail-kv"><span data-i18n="detail_status">Trạng thái</span><strong id="detailAvailability">-</strong></div>
              <div class="detail-kv"><span data-i18n="detail_last_update">Cập nhật cuối</span><strong id="detailLastUpdate">-</strong></div>
              <div class="detail-kv"><span data-i18n="detail_last_sync">Đồng bộ lúc</span><strong id="detailLastSync">-</strong></div>
            </section>
          </div>
        </section>
        <section class="detail-tab-panel" data-detail-panel="networking" hidden>
          <div class="detail-network-layout">
            <section class="detail-panel">
              <div class="detail-panel-head">
                <span data-i18n="detail_wifi">Quản lý WiFi</span>
                <span class="detail-network-status" id="detailNetworkStatus" data-i18n="detail_network_loading">Đang tải networking...</span>
              </div>
              <div class="detail-kv"><span data-i18n="detail_ssid">SSID</span><strong id="detailWifiSsid">-</strong></div>
              <div class="detail-kv"><span data-i18n="detail_password">Mật khẩu</span><strong id="detailWifiPassword">-</strong></div>
              <button type="button" class="detail-ghost-btn" data-i18n="detail_restart_router">Khởi động lại router</button>
            </section>
          </div>
        </section>
        <section class="detail-tab-panel" data-detail-panel="telemetry" hidden>
          <section class="detail-chart-section">
            <div class="detail-chart-filter" role="toolbar" aria-label="Chart range">
              <button type="button" class="detail-filter-btn is-active" data-range-seconds="900" data-i18n="detail_range_15m">15 mins</button>
              <button type="button" class="detail-filter-btn" data-range-seconds="3600" data-i18n="detail_range_1h">1 hour</button>
              <button type="button" class="detail-filter-btn" data-range-seconds="10800" data-i18n="detail_range_3h">3 hours</button>
              <button type="button" class="detail-filter-btn" data-range-seconds="86400" data-i18n="detail_range_24h">24 hours</button>
              <button type="button" class="detail-filter-btn" data-range-seconds="604800" data-i18n="detail_range_7d">7 days</button>
              <button type="button" class="detail-filter-btn detail-filter-reload" id="detailTelemetryReload" data-i18n="detail_range_reload">Reload</button>
            </div>
            <div class="detail-chart-grid">
              <section class="detail-chart-panel detail-metric-card metric-theme-downlink" data-metric="downlink_throughput">
                <div class="detail-panel-head detail-panel-head-chart">
                  <span class="detail-metric-title" data-i18n="metric_downlink_throughput">Downlink throughput</span>
                  <span class="detail-chart-stats">Min 0.00 Mbps | Avg 0.00 Mbps | Max 0.00 Mbps</span>
                </div>
                <div class="detail-chart">
                  <div class="detail-chart-state" data-state-key="detail_chart_loading" data-i18n="detail_chart_loading">Đang tải dữ liệu biểu đồ...</div>
                  <svg class="detail-chart-svg" viewBox="0 0 900 260" preserveAspectRatio="none" aria-hidden="true"></svg>
                  <div class="detail-chart-axis detail-chart-axis-y">
                    <span>0.00</span>
                    <span>0.00</span>
                    <span>0</span>
                  </div>
                  <div class="detail-chart-axis detail-chart-axis-x"></div>
                  <div class="detail-chart-unit">Mbps</div>
                </div>
              </section>
              <section class="detail-chart-panel detail-metric-card metric-theme-uplink" data-metric="uplink_throughput">
                <div class="detail-panel-head detail-panel-head-chart">
                  <span class="detail-metric-title" data-i18n="metric_uplink_throughput">Uplink throughput</span>
                  <span class="detail-chart-stats">Min 0.00 Mbps | Avg 0.00 Mbps | Max 0.00 Mbps</span>
                </div>
                <div class="detail-chart">
                  <div class="detail-chart-state" data-state-key="detail_chart_loading" data-i18n="detail_chart_loading">Đang tải dữ liệu biểu đồ...</div>
                  <svg class="detail-chart-svg" viewBox="0 0 900 260" preserveAspectRatio="none" aria-hidden="true"></svg>
                  <div class="detail-chart-axis detail-chart-axis-y">
                    <span>0.00</span>
                    <span>0.00</span>
                    <span>0</span>
                  </div>
                  <div class="detail-chart-axis detail-chart-axis-x"></div>
                  <div class="detail-chart-unit">Mbps</div>
                </div>
              </section>
              <section class="detail-chart-panel detail-metric-card metric-theme-latency" data-metric="latency">
                <div class="detail-panel-head detail-panel-head-chart">
                  <span class="detail-metric-title" data-i18n="metric_latency">Latency</span>
                  <span class="detail-chart-stats">Min 0.00 ms | Avg 0.00 ms | Max 0.00 ms</span>
                </div>
                <div class="detail-chart">
                  <div class="detail-chart-state" data-state-key="detail_chart_loading" data-i18n="detail_chart_loading">Đang tải dữ liệu biểu đồ...</div>
                  <svg class="detail-chart-svg" viewBox="0 0 900 260" preserveAspectRatio="none" aria-hidden="true"></svg>
                  <div class="detail-chart-axis detail-chart-axis-y">
                    <span>0.00</span>
                    <span>0.00</span>
                    <span>0</span>
                  </div>
                  <div class="detail-chart-axis detail-chart-axis-x"></div>
                  <div class="detail-chart-unit">ms</div>
                </div>
              </section>
              <section class="detail-chart-panel detail-metric-card metric-theme-signal" data-metric="signal_quality">
                <div class="detail-panel-head detail-panel-head-chart">
                  <span class="detail-metric-title" data-i18n="metric_signal_quality">Signal quality</span>
                  <span class="detail-chart-stats">Min 0.00 | Avg 0.00 | Max 0.00</span>
                </div>
                <div class="detail-chart">
                  <div class="detail-chart-state" data-state-key="detail_chart_loading" data-i18n="detail_chart_loading">Đang tải dữ liệu biểu đồ...</div>
                  <svg class="detail-chart-svg" viewBox="0 0 900 260" preserveAspectRatio="none" aria-hidden="true"></svg>
                  <div class="detail-chart-axis detail-chart-axis-y">
                    <span>0.00</span>
                    <span>0.00</span>
                    <span>0</span>
                  </div>
                  <div class="detail-chart-axis detail-chart-axis-x"></div>
                  <div class="detail-chart-unit">score</div>
                </div>
              </section>
              <section class="detail-chart-panel detail-metric-card metric-theme-pingdrop" data-metric="ping_drop_rate">
                <div class="detail-panel-head detail-panel-head-chart">
                  <span class="detail-metric-title" data-i18n="metric_ping_drop_rate">Ping drop rate</span>
                  <span class="detail-chart-stats">Min 0.00 % | Avg 0.00 % | Max 0.00 %</span>
                </div>
                <div class="detail-chart">
                  <div class="detail-chart-state" data-state-key="detail_chart_loading" data-i18n="detail_chart_loading">Đang tải dữ liệu biểu đồ...</div>
                  <svg class="detail-chart-svg" viewBox="0 0 900 260" preserveAspectRatio="none" aria-hidden="true"></svg>
                  <div class="detail-chart-axis detail-chart-axis-y">
                    <span>0.00</span>
                    <span>0.00</span>
                    <span>0</span>
                  </div>
                  <div class="detail-chart-axis detail-chart-axis-x"></div>
                  <div class="detail-chart-unit">%</div>
                </div>
              </section>
              <section class="detail-chart-panel detail-metric-card metric-theme-obstruction" data-metric="obstruction">
                <div class="detail-panel-head detail-panel-head-chart">
                  <span class="detail-metric-title" data-i18n="metric_obstruction">Obstruction</span>
                  <span class="detail-chart-stats">Min 0.00 | Avg 0.00 | Max 0.00</span>
                </div>
                <div class="detail-chart">
                  <div class="detail-chart-state" data-state-key="detail_chart_loading" data-i18n="detail_chart_loading">Đang tải dữ liệu biểu đồ...</div>
                  <svg class="detail-chart-svg" viewBox="0 0 900 260" preserveAspectRatio="none" aria-hidden="true"></svg>
                  <div class="detail-chart-axis detail-chart-axis-y">
                    <span>0.00</span>
                    <span>0.00</span>
                    <span>0</span>
                  </div>
                  <div class="detail-chart-axis detail-chart-axis-x"></div>
                  <div class="detail-chart-unit">ratio</div>
                </div>
              </section>
            </div>
          </section>
        </section>
      </div>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="deviceModal" hidden>
  <div class="device-modal" role="dialog" aria-modal="true" aria-labelledby="deviceModalTitle">
	    <div class="device-modal-head">
	      <div>
	        <h2 id="deviceModalTitle" data-i18n="modal_title">Thêm mới thiết bị</h2>
	        <p id="deviceModalSubtitle" data-i18n="modal_subtitle">Nhập thông tin thiết bị và xác thực mã thiết bị đầu cuối qua API.</p>
	      </div>
      <button type="button" class="modal-close" id="closeDeviceModal" aria-label="Close">×</button>
    </div>
    <form id="createDeviceForm" class="device-modal-form" asp-controller="Dashboard" asp-action="CreateDevice" method="post">
      @Html.AntiForgeryToken()
      <input id="deviceId" name="Id" type="hidden" value="0" />
      <div class="form-group">
        <label for="deviceName" data-i18n="field_device_name">Tên thiết bị</label>
