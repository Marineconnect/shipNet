              aria-label="T�m thi?t b?" />
            <button type="submit" class="device-search-icon-btn" id="deviceSearchIconButton" aria-label="T�m thi?t b?">
              <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 0 1 5.16 10.46l4.44 4.44-1.41 1.41-4.44-4.44A6.5 6.5 0 1 1 10.5 4Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z"/></svg>
