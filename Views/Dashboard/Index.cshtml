  function isPointInPolygon(point, polygon) {
    const [lat, lng] = point;
    let inside = false;
    for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
      const [latI, lngI] = polygon[i];
      const [latJ, lngJ] = polygon[j];
      const intersects = ((lngI > lng) !== (lngJ > lng)) &&
        (lat < ((latJ - latI) * (lng - lngI)) / ((lngJ - lngI) || Number.EPSILON) + latI);
      if (intersects) {
        inside = !inside;
      }
    }
    return inside;
  }

  function isInsideVietnamBaselineAreas(latLng) {
    return isPointInPolygon(latLng, vietnamBaselineAssessmentArea);
  }

  function addVietnamBaselineLayers() {
    if (detailBaselineLayers) {
      return;
    }

    detailBaselineLayers = L.layerGroup().addTo(detailLeafletMap);
    vietnamBaselineLines.forEach((line) => {
      L.polyline(line.points, {
        color: "#ffffff",
        weight: 9,
        opacity: 0.88,
        lineCap: "round",
        lineJoin: "round",
        pane: "overlayPane"
      }).addTo(detailBaselineLayers);
      const baselineLine = L.polyline(line.points, {
        color: "#ff102f",
        weight: 4,
        opacity: 1,
        lineCap: "round",
        lineJoin: "round",
        pane: "overlayPane"
      }).addTo(detailBaselineLayers);
      baselineLine.bindTooltip(line.name, {
        sticky: true,
        direction: "top",
        className: "detail-maritime-route-tooltip"
      });
      line.points.forEach((point) => {
        L.circleMarker(point, {
          radius: 4,
          color: "#ffffff",
          weight: 2,
          fillColor: "#ff102f",
          fillOpacity: 1,
          pane: "markerPane"
        }).addTo(detailBaselineLayers);
      });
    });
  }

  function ensureDetailMap() {
    if (detailLeafletMap || typeof L === "undefined") {
      return Boolean(detailLeafletMap);
    }

    detailLeafletMap = L.map(detailMapCanvas, {
      zoomControl: true,
      attributionControl: true
    });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: "&copy; OpenStreetMap contributors"
    }).addTo(detailLeafletMap);
    addVietnamBaselineLayers();
    detailLeafletMarker = L.marker([0, 0], { icon: buildShipMarkerIcon(false), title: "Vessel" }).addTo(detailLeafletMap);
    return true;
  }

  function refreshDetailMapSize(zoom = null) {
    if (!detailLeafletMap) {
      return;
    }

    window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
      detailLeafletMap.invalidateSize();
      if (detailMapLatLng) {
        detailLeafletMap.setView(detailMapLatLng, zoom ?? detailLeafletMap.getZoom() ?? 7, { animate: false });
      }
    }));
  }

  function updateDetailMap(latitudeValue, longitudeValue) {
    if (!canViewMap || !detailMapCanvas || !detailMapEmpty || !detailMapCoordinates) {
      detailMapLatLng = null;
      return;
    }

    const latitude = parseCoordinate(latitudeValue);
    const longitude = parseCoordinate(longitudeValue);
    const hasCoordinates = latitude !== null && longitude !== null;
    detailMapCanvas.hidden = !hasCoordinates;
    detailMapEmpty.hidden = hasCoordinates;
    detailMapCanvas.style.display = hasCoordinates ? "block" : "none";
    detailMapEmpty.style.display = hasCoordinates ? "none" : "grid";

    if (!hasCoordinates) {
      detailMapLatLng = null;
      detailMapCoordinates.textContent = "-";
      return;
    }

    detailMapLatLng = [latitude, longitude];
    detailMapCoordinates.textContent = `${formatCoordinate(latitude)}, ${formatCoordinate(longitude)}`;
    if (currentDetailTab === "map" && ensureDetailMap()) {
      const isInsideBaseline = isInsideVietnamBaselineAreas(detailMapLatLng);
      detailLeafletMarker.setIcon(buildShipMarkerIcon(isInsideBaseline));
      detailLeafletMarker.setLatLng(detailMapLatLng);
      detailLeafletMap.setView(detailMapLatLng, 7, { animate: false });
      refreshDetailMapSize(7);
    }
  }

