        {
          <button type="button" class="detail-tab-btn" data-detail-tab="map" data-i18n="detail_tab_map">Map</button>
        }
        <button type="button" class="detail-tab-btn" data-detail-tab="telemetry" data-i18n="detail_tab_telemetry">Telemetry</button>
        <button type="button" class="detail-tab-btn" data-detail-tab="plan" data-i18n="detail_tab_plan">Plan Management</button>
        <button type="button" class="detail-tab-btn" data-detail-tab="networking" data-i18n="detail_tab_networking">Networking</button>
        <button type="button" class="detail-tab-btn" data-detail-tab="activity" data-i18n="detail_tab_activity">Activity Log</button>
      </div>
      <div class="device-detail-content">
        <div class="detail-loading" id="detailLoading" hidden>
          <span class="detail-loading-spinner" aria-hidden="true"></span>
          <span class="detail-loading-text" data-i18n="processing">Dang x? l�...</span>
        </div>
        <section class="detail-tab-panel is-active" data-detail-panel="information">
          <div class="detail-info-layout">
            <section class="detail-usage-panel">
              <div class="detail-panel-head"><span data-i18n="detail_subscription_title">G�i hi?n t?i</span></div>
              <div class="usage-progress">
                <div class="usage-progress-bar">
                  <div class="usage-progress-fill" id="detailUsageProgress"></div>
                </div>
                <div class="usage-progress-scale"><span>0</span><span id="detailUsageLimitTop">-</span></div>
              </div>
              <div class="usage-grid">
                <div class="usage-row"><span data-i18n="detail_total_usage">T?ng dung lu?ng</span><div class="usage-values"><strong id="detailTotalUsage">-</strong><span>/</span><strong id="detailTotalUsageLimit">-</strong></div></div>
                <div class="usage-row"><span data-i18n="detail_priority_overage">Priority Overage</span><div class="usage-values"><strong id="detailPriorityOverage">-</strong><span>/</span><strong id="detailPriorityOverageLimit">-</strong></div></div>
                <div class="usage-row"><span data-i18n="detail_plan_name">T�n g�i</span><div class="usage-values usage-values-single"><strong id="detailPlanName">-</strong></div></div>
              </div>
              @if (Model.CanManageDataOptIn)
              {
                <section class="data-optin-panel" id="dataOptInPanel">
                  <div class="data-optin-head">
                    <div><div class="data-optin-title" data-i18n="detail_data_optin_title">Data opt-in / opt-out</div><div class="data-optin-current"><span data-i18n="detail_data_optin_current">Tr?ng th�i hi?n t?i</span>: <strong id="dataOptInCurrent">-</strong></div></div>
                    <button type="button" class="data-optin-action" id="dataOptInAction" disabled>-</button>
