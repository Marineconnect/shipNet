    const formatted = new Intl.NumberFormat(locale, {
      minimumFractionDigits: dashboardMoneyDecimals,
      maximumFractionDigits: dashboardMoneyDecimals
    }).format(numericValue);
    return dashboardCurrency === "VND" ? `${formatted} ₫` : `${formatted} ${dashboardCurrency}`;
  }

