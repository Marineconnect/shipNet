	  };
	  const text = (name) => (dictionary[lang] || dictionary.vi)[name] || name;
	  const format = (value, tokens) => value.replace(/\{(\w+)\}/g, (_, token) => tokens[token] ?? "");

	  function isProbablyHtmlResponse(rawText) {
	    return /^\s*</.test(rawText || "") && /<(?:!doctype|html|body|head|title|form)\b/i.test(rawText || "");
	  }

	  function isGarbledText(value) {
	    return /Ã|Â|â€|â€™|â€œ|â€\u009d/.test(value || "");
	  }

	  function extractHttpStatus(value) {
	    const match = (value || "").match(/\b(?:HTTP\s*)?(\d{3})\b/);
	    return match ? match[1] : "";
	  }

	  function statusFallbackMessage(status, rawText, fallbackKey = "generic_error") {
	    if (isProbablyHtmlResponse(rawText)) {
	      return Number(status || 0) === 200
	        ? text("error_session_expired")
	        : text("error_invalid_response");
	    }

	    switch (Number(status || 0)) {
	      case 400:
	        return text(isProbablyHtmlResponse(rawText) ? "error_session_expired" : "error_bad_request");
	      case 401:
	        return text("error_unauthorized");
	      case 403:
	        return text("error_forbidden");
	      case 404:
	        return text("error_not_found");
	      default:
	        return status ? format(text("error_http_status"), { status: `${status}` }) : text(fallbackKey);
	    }
	  }

	  function mapErrorCodeMessage(errorCode, response, data) {
	    const status = response?.status || extractHttpStatus(data?.messageEn || data?.message || "");
	    switch ((errorCode || "").trim()) {
	      case "validation_required":
	        return text("error_validation_required");
	      case "duplicate_kit_code":
	        return text("error_duplicate_kit_code");
	      case "missing_api_credentials":
	        return text("error_missing_api_credentials");
	      case "kit_unavailable":
	        return text("error_kit_unavailable");
	      case "missing_access_token":
	        return text("error_missing_access_token");
	      case "terminal_devices_error":
	      case "api_error":
	        return format(text("error_terminal_devices_error"), { status: `${status || "-"}` });
	      case "terminal_devices_empty":
	        return text("error_terminal_devices_empty");
	      case "terminal_device_missing_id":
	        return text("error_terminal_device_missing_id");
	      case "terminal_devices_invalid_json":
	        return text("error_terminal_devices_invalid_json");
	      case "missing_wifi_identifiers":
	        return text("error_missing_wifi_identifiers");
	      case "wifi_api_error":
	        return format(text("error_wifi_api_error"), { status: `${status || "-"}` });
	      case "wifi_invalid_json":
	        return text("error_wifi_invalid_json");
	      case "device_not_found":
	        return text("error_device_not_found");
	      case "server_exception":
	        return text("error_server_exception");
	      default:
	        return "";
	    }
	  }

	  function resolveServerErrorMessage(response, data, rawText, fallbackKey = "generic_error") {
	    const messageVi = `${data?.message ?? data?.Message ?? ""}`.trim();
	    const messageEn = `${data?.messageEn ?? data?.MessageEn ?? ""}`.trim();
	    const errorCode = `${data?.errorCode ?? data?.ErrorCode ?? ""}`.trim();
	    const mappedMessage = mapErrorCodeMessage(errorCode, response, data);

	    if (lang === "en") {
	      return messageEn || mappedMessage || statusFallbackMessage(response?.status, rawText, fallbackKey);
	    }

	    if (messageVi && !isGarbledText(messageVi)) {
	      return messageVi;
	    }

	    return mappedMessage
	      || messageEn
	      || statusFallbackMessage(response?.status, rawText, fallbackKey)
	      || messageVi
	      || text(fallbackKey);
	  }

	  function resolveSuccessMessage(data, fallbackKey) {
	    const messageVi = `${data?.message ?? data?.Message ?? ""}`.trim();
	    const messageEn = `${data?.messageEn ?? data?.MessageEn ?? ""}`.trim();

	    if (lang === "en") {
	      return messageEn || text(fallbackKey);
	    }

	    if (messageVi && !isGarbledText(messageVi)) {
	      return messageVi;
	    }

	    return messageEn || text(fallbackKey);
	  }

	  async function readApiResponse(response) {
	    const rawText = await response.text();
	    let data = {};
	    let isJson = false;

	    try {
	      data = rawText ? JSON.parse(rawText) : {};
	      isJson = true;
	    } catch {
	    }

	    return { rawText, data, isJson };
	  }

