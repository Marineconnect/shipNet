        {
          <button type="button" class="btn-secondary stock-sync-btn" id="syncStockDevicesButton" @(Model.ActiveDeviceTab == "stock" ? "" : "hidden")>Sync stock</button>
        }
      </div>
      <div class="table-wrap">
        <table class="device-table">
